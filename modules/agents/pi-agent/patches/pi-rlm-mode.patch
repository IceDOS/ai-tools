+// pi-clm appends its guidance before this handler runs; RLM mode would otherwise drop it.
+const CLM_HEADINGS = ["## Editable context", "## Live context management"];
+function clmSection(prompt: string): string {
+	const at = Math.min(...CLM_HEADINGS.map((h) => prompt.indexOf(h)).filter((i) => i >= 0));
+	if (!Number.isFinite(at)) return "";
+	return `\n\n${prompt.slice(at)}\n\nIn RLM mode, edit the context mirror with Python file I/O in ipython.`;
+}
+
+// icedos pi-rlm-mode.patch v4. RLM mode swaps only these for ipython; other tools stay.
+const BUILTIN_TOOLS = new Set(["read", "bash", "edit", "write", "grep", "find", "ls"]);
+
+// The RLM prompt replaces pi's, which carried the kept tools' guidelines.
+function otherToolsSection(tools: string[], guidelines: Record<string, string[] | string> | undefined): string {
+	const others = tools.filter((t) => t !== "ipython");
+	if (others.length === 0) return "";
+	const rules = others.flatMap((t) => guidelines?.[t] ?? []).map((g) => `- ${g}`);
+	return `\n\n# Other tools\nBesides ipython you can call: ${others.join(", ")}.${rules.length ? `\n${rules.join("\n")}` : ""}`;
+}
+
+// pi lists skills only while read or bash is active, so RLM mode lost them.
+function skillsSection(skills: Parameters<typeof formatSkillsForPrompt>[0] | undefined): string {
+	const list = formatSkillsForPrompt(skills ?? [], "indirect").trim();
+	if (!list) return "";
+	return `\n\n${list}\n\nIn RLM mode, load a skill by printing its file with Python open() in ipython.`;
+}
