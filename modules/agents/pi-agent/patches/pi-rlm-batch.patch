+// icedos pi-rlm-batch.patch v1: children one rlm_batch() call runs at once.
+export const maxParallel = () => Math.max(1, Number.parseInt(process.env.PI_RLM_MAX_PARALLEL ?? "", 10) || 4);
+
+// Runs fn over items with at most `limit` in flight; a throw becomes a failed reply in that slot.
+export async function runBatch(
+	items: string[],
+	limit: number,
+	fn: (item: string) => Promise<RlmReply>,
+): Promise<RlmReply[]> {
+	const out: RlmReply[] = new Array(items.length);
+	let next = 0;
+	const worker = async () => {
+		while (next < items.length) {
+			const i = next++;
+			try {
+				out[i] = await fn(items[i]);
+			} catch (err) {
+				out[i] = { ok: false, error: err instanceof Error ? err.message : String(err) };
+			}
+		}
+	};
+	await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
+	return out;
+}
