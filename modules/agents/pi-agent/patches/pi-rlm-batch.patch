+# icedos pi-rlm-batch.patch v1: one request, the host runs the children in parallel.
+def rlm_batch(prompts, context=None):
+    """Run one recursive sub-LLM per prompt in parallel, like rlm() for each.
+
+    Returns the answers in prompt order; a failed child's slot holds a
+    RuntimeError instead of a string.
+    """
+    global _rlm_counter
+    texts = [str(p) for p in prompts]
+    if context is not None:
+        payload = context if isinstance(context, str) else json.dumps(context, ensure_ascii=False, default=str)
+        texts = [f"{t}\n\n{payload}" for t in texts]
+    if not texts:
+        return []
+    with _rlm_lock:
+        _rlm_counter += 1
+        rid = _rlm_counter
+        _send({"type": "rlm_batch_request", "id": rid, "prompts": texts, "depth": RLM_DEPTH + 1})
+        while True:
+            msg = _readline()
+            if msg.get("type") == "rlm_batch_response" and msg.get("id") == rid:
+                return [
+                    r.get("result", "") if r.get("ok") else RuntimeError(f"rlm() failed: {r.get('error', 'unknown error')}")
+                    for r in msg.get("results", [])
+                ]
