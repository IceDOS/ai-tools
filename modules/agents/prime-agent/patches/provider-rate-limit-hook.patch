+
+fn rate_limit_seam(
+    calls: Arc<std::sync::atomic::AtomicUsize>,
+    answer: bool,
+) -> impl FnMut(AssistantMessage) -> crate::session_engine::rate_limit_hook::RateLimitFuture {
+    move |_message| {
+        let calls = Arc::clone(&calls);
+        Box::pin(async move {
+            calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            answer
+        })
+    }
+}
+
+/// A hook that ran retries at once with the hook reason, outside the retry budget.
+#[tokio::test]
+async fn a_successful_rate_limit_hook_retries_without_backoff() {
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let events_for_emit = Arc::clone(&events);
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let mut seam = rate_limit_seam(Arc::clone(&calls), true);
+    let attempts = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let attempts_for_turn = Arc::clone(&attempts);
+    let message = run_turn_with_auto_retry_hooked(
+        &fast_policy(),
+        0,
+        None,
+        move || {
+            let attempts = Arc::clone(&attempts_for_turn);
+            async move {
+                if attempts.fetch_add(1, std::sync::atomic::Ordering::SeqCst) == 0 {
+                    Ok(error_message(Some("rate_limit"), Some(429), None))
+                } else {
+                    Ok(ok_message())
+                }
+            }
+        },
+        move |event| {
+            let events = Arc::clone(&events_for_emit);
+            async move {
+                events.lock().unwrap().push(event);
+                Ok(())
+            }
+        },
+        // A hook retry never waits; a wait here would abort and fail the Stop assert.
+        |_| async { false },
+        None,
+        Some(&mut seam),
+    )
+    .await
+    .unwrap();
+    assert_eq!(message.stop_reason, StopReason::Stop);
+    assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 1);
+    let events = events.lock().unwrap().clone();
+    assert!(matches!(
+        events.as_slice(),
+        [
+            AutoRetryEvent::Start { attempt: 1, delay_ms: 0, reason: RetryStartReason::RateLimitHook, .. },
+            AutoRetryEvent::End { success: true, .. },
+        ]
+    ), "{events:?}");
+}
+
+/// The hook runs at most three times per turn; then the normal policy decides.
+#[tokio::test]
+async fn the_rate_limit_hook_is_capped_per_turn() {
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let mut seam = rate_limit_seam(Arc::clone(&calls), true);
+    let message = run_turn_with_auto_retry_hooked(
+        &fast_policy(),
+        0,
+        None,
+        || async { Ok(error_message(Some("rate_limit"), Some(429), None)) },
+        |_| async { Ok(()) },
+        |_| async { true },
+        None,
+        Some(&mut seam),
+    )
+    .await
+    .unwrap();
+    assert_eq!(message.stop_reason, StopReason::Error);
+    assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 3);
+}
+
