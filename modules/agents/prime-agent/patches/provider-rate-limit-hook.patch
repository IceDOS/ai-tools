+//! `hooks.rateLimit`: run a command when a listed provider rate-limits a root session.
+
+use std::future::Future;
+use std::pin::Pin;
+
+use pa_agent::types::AssistantMessage;
+
+use super::provider_retry::{provider_stream_failure_kind, provider_stream_failure_status};
+use crate::settings::types::RateLimitHookEntry;
+
+pub const MAX_HOOK_RETRIES_PER_TURN: u32 = 3;
+pub const TIMEOUTS_BEFORE_HOOK: u32 = 2;
+pub const DEFAULT_TIMEOUT_MS: u64 = 120_000;
+
+pub type RateLimitFuture = Pin<Box<dyn Future<Output = bool> + Send>>;
+
+/// The retry loops ask this before deciding; `true` means the hook ran and the turn retries now.
+pub type RateLimitHookCallback<'a> = &'a mut dyn FnMut(AssistantMessage) -> RateLimitFuture;
+
+fn has_word(text: &str, word: &str) -> bool {
+    text.split(|c: char| !c.is_ascii_alphanumeric()).any(|part| part == word)
+}
+
+/// Which trigger a failed turn hits, if any; `timeouts` counts timeout failures in this turn.
+#[must_use]
+pub fn classify(message: &AssistantMessage, timeouts: &mut u32) -> Option<&'static str> {
+    let text = message.error_message.as_deref().unwrap_or("").to_ascii_lowercase();
+    let status = provider_stream_failure_status(message);
+    if provider_stream_failure_kind(message).as_deref() == Some("rate_limit")
+        || status == Some(429)
+        || has_word(&text, "429")
+        || text.contains("rate limit")
+        || text.contains("too many requests")
+        || text.contains("quota exceeded")
+    {
+        return Some("rate_limit");
+    }
+    if status == Some(404) || has_word(&text, "404") {
+        return Some("not_found");
+    }
+    if text.contains("timed out") || text.contains("timeout") || text.contains("etimedout") {
+        *timeouts += 1;
+        if *timeouts >= TIMEOUTS_BEFORE_HOOK {
+            *timeouts = 0;
+            return Some("timeout");
+        }
+    }
+    None
+}
+
+#[must_use]
+pub fn entries_for<'a>(entries: &'a [RateLimitHookEntry], provider: &str) -> Vec<&'a RateLimitHookEntry> {
+    entries
+        .iter()
+        .filter(|entry| !entry.command.is_empty() && entry.providers.iter().any(|name| name == provider))
+        .collect()
+}
+
+#[must_use]
+pub fn payload(cwd: &str, session_id: &str, message: &AssistantMessage, kind: &str) -> serde_json::Value {
+    let mut value = super::lifecycle_hooks::hook_payload("RateLimit", cwd, session_id, None);
+    value["provider"] = serde_json::json!(message.provider);
+    value["model"] = serde_json::json!(message.model);
+    value["errorKind"] = serde_json::json!(kind);
+    value["errorMessage"] = serde_json::json!(message.error_message.as_deref().unwrap_or(""));
+    value
+}
+
+/// Run one hook with `payload` on stdin; `true` only for exit 0 within the timeout.
+pub async fn run(entry: &RateLimitHookEntry, payload: &serde_json::Value) -> bool {
+    use tokio::io::AsyncWriteExt;
+    let Some((program, args)) = entry.command.split_first() else { return false };
+    let mut command = tokio::process::Command::new(program);
+    command
+        .args(args)
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true);
+    // Own process group: a terminal Ctrl-C aimed at the TUI never reaches the hook.
+    #[cfg(unix)]
+    command.process_group(0);
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(error) => {
+            tracing::warn!("rateLimit hook {program:?} not started: {error}");
+            return false;
+        }
+    };
+    if let Some(mut stdin) = child.stdin.take() {
+        let _ = stdin.write_all(payload.to_string().as_bytes()).await;
+    }
+    let limit = std::time::Duration::from_millis(entry.timeout_ms.unwrap_or(DEFAULT_TIMEOUT_MS));
+    match tokio::time::timeout(limit, child.wait()).await {
+        Ok(Ok(status)) => status.success(),
+        Ok(Err(error)) => {
+            tracing::warn!("rateLimit hook {program:?} failed: {error}");
+            false
+        }
+        Err(_) => {
+            tracing::warn!("rateLimit hook {program:?} timed out");
+            let _ = child.kill().await;
+            false
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pa_agent::types::{AssistantContent, AssistantMessageDiagnostic, StopReason, TextContent, Usage};
+
+    fn failed(kind: Option<&str>, status: Option<u16>, text: &str) -> AssistantMessage {
+        AssistantMessage {
+            content: vec![AssistantContent::Text(TextContent { text: String::new(), text_signature: None })],
+            api: String::new(),
+            provider: "opencode".to_string(),
+            model: "big-pickle".to_string(),
+            response_model: None,
+            response_id: None,
+            diagnostics: Some(vec![AssistantMessageDiagnostic {
+                kind: "provider_stream_failure".to_string(),
+                timestamp: 0,
+                error: None,
+                details: Some(serde_json::json!({ "kind": kind, "status": status })),
+            }]),
+            usage: Usage::zero(),
+            stop_reason: StopReason::Error,
+            stop_reason_raw: None,
+            error_message: Some(text.to_string()),
+            timestamp: 0,
+        }
+    }
+
+    fn entry(command: &[&str], providers: &[&str], timeout_ms: Option<u64>) -> RateLimitHookEntry {
+        RateLimitHookEntry {
+            command: command.iter().map(ToString::to_string).collect(),
+            providers: providers.iter().map(ToString::to_string).collect(),
+            timeout_ms,
+        }
+    }
+
+    #[test]
+    fn rate_limits_and_404s_fire_at_once() {
+        let mut timeouts = 0;
+        assert_eq!(classify(&failed(Some("rate_limit"), Some(429), "slow down"), &mut timeouts), Some("rate_limit"));
+        assert_eq!(classify(&failed(Some("unknown"), None, "HTTP 429 Too Many Requests"), &mut timeouts), Some("rate_limit"));
+        assert_eq!(classify(&failed(Some("invalid_request"), Some(404), "not found"), &mut timeouts), Some("not_found"));
+        assert_eq!(classify(&failed(Some("server_error"), Some(500), "boom"), &mut timeouts), None);
+    }
+
+    #[test]
+    fn timeouts_fire_on_the_second_and_reset() {
+        let mut timeouts = 0;
+        let timeout = failed(Some("unknown"), None, "Request timed out");
+        assert_eq!(classify(&timeout, &mut timeouts), None);
+        assert_eq!(classify(&timeout, &mut timeouts), Some("timeout"));
+        assert_eq!(timeouts, 0);
+        assert_eq!(classify(&timeout, &mut timeouts), None);
+    }
+
+    #[test]
+    fn entries_match_by_provider() {
+        let entries = vec![entry(&["a"], &["opencode"], None), entry(&["b"], &["openrouter"], None)];
+        let matched = entries_for(&entries, "opencode");
+        assert_eq!(matched.len(), 1);
+        assert_eq!(matched[0].command, vec!["a".to_string()]);
+        assert!(entries_for(&entries, "anthropic").is_empty());
+    }
+
+    #[test]
+    fn payload_names_the_event_and_the_failure() {
+        let value = payload("/w", "s1", &failed(Some("rate_limit"), Some(429), "slow"), "rate_limit");
+        assert_eq!(value["hook_event_name"], "RateLimit");
+        assert_eq!(value["provider"], "opencode");
+        assert_eq!(value["model"], "big-pickle");
+        assert_eq!(value["errorKind"], "rate_limit");
+        assert_eq!(value["errorMessage"], "slow");
+    }
+
+    #[tokio::test]
+    async fn run_reports_the_exit_status_and_feeds_stdin() {
+        let dir = tempfile::tempdir().unwrap();
+        let out = dir.path().join("payload.json");
+        let script = format!("cat > {}; exit 0", out.display());
+        assert!(run(&entry(&["sh", "-c", &script], &["opencode"], None), &serde_json::json!({ "x": 1 })).await);
+        assert_eq!(std::fs::read_to_string(&out).unwrap(), r#"{"x":1}"#);
+        assert!(!run(&entry(&["sh", "-c", "exit 3"], &["opencode"], None), &serde_json::json!({})).await);
+        assert!(!run(&entry(&["/nonexistent/hook"], &["opencode"], None), &serde_json::json!({})).await);
+    }
+
+    #[tokio::test]
+    async fn run_kills_a_hook_past_its_timeout() {
+        let started = std::time::Instant::now();
+        assert!(!run(&entry(&["sleep", "5"], &["opencode"], Some(200)), &serde_json::json!({})).await);
+        assert!(started.elapsed() < std::time::Duration::from_secs(3));
+    }
+}
