Index: prime-agent-src/crates/pa-tui/src/prompt_suggest.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-tui/src/prompt_suggest.rs
@@ -0,0 +1,274 @@
+//! Next-prompt suggestion: after a turn ends with a plain answer, ask a small model for the
+//! user's likely next message and show it as dim ghost text in the empty editor (Tab accepts).
+//! The model call lives behind [`PromptSuggester`], which pa-cli implements.
+
+use crate::chat::{ChatEntry, MessageBlock};
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+
+pub const SYSTEM_PROMPT: &str = "You predict the next message a user will type into a coding agent, given the recent transcript.
+
+Rules:
+- Output only the predicted message, max 12 words, no quotes, no explanation.
+- Write it as the user would: terse, imperative, lowercase is fine.
+- Prefer the obvious next step the assistant's last reply points to (apply, run, test, commit, rebuild, continue, answer its question).
+- If the assistant asked a yes/no question, predict the likely answer (\"yes\", \"go ahead\").
+- If there is no clear next step, output exactly NONE.";
+
+const MAX_MESSAGES: usize = 8;
+const MAX_CHARS: usize = 1200;
+const MAX_SUGGESTION_CHARS: usize = 120;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SuggestRequest {
+    /// The `<transcript>` user message body.
+    pub prompt: String,
+    /// `provider/id` from `promptSuggestions.model`; `None` uses the session model.
+    pub model: Option<String>,
+    /// The session's current `(provider, id)`.
+    pub session_model: Option<(String, String)>,
+}
+
+pub type SuggestFuture = Pin<Box<dyn Future<Output = Option<String>> + Send>>;
+
+/// Runs one suggestion call; returns the raw model text, or `None` on any failure.
+pub trait PromptSuggester: Send + Sync {
+    fn suggest(&self, request: SuggestRequest) -> SuggestFuture;
+}
+
+/// A finished suggestion, tagged with the generation that requested it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SuggestNote {
+    pub generation: u64,
+    pub text: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PromptSuggestConfig {
+    pub enabled: bool,
+    pub model: Option<String>,
+}
+
+/// The transcript prompt, or `None` when the last entry is not a finished plain answer.
+#[must_use]
+pub fn build_prompt(entries: &[ChatEntry]) -> Option<String> {
+    let last = entries.iter().rev().find(|entry| conversational(entry))?;
+    let ChatEntry::Assistant(message) = last else {
+        return None;
+    };
+    if message.streaming || message.aborted || message.error.is_some() || message.has_tool_calls {
+        return None;
+    }
+    let lines: Vec<String> = entries
+        .iter()
+        .filter_map(|entry| match entry {
+            ChatEntry::User { text } => Some(("USER", text.clone())),
+            ChatEntry::Assistant(message) => Some(("ASSISTANT", assistant_text(&message.blocks))),
+            _ => None,
+        })
+        .filter(|(_, text)| !text.trim().is_empty())
+        .map(|(role, text)| format!("{role}: {}", tail(text.trim())))
+        .collect();
+    let start = lines.len().saturating_sub(MAX_MESSAGES);
+    if lines[start..].is_empty() {
+        return None;
+    }
+    Some(format!(
+        "<transcript>\n{}\n</transcript>\n\nPredict my next message.",
+        lines[start..].join("\n\n")
+    ))
+}
+
+fn conversational(entry: &ChatEntry) -> bool {
+    matches!(entry, ChatEntry::User { .. } | ChatEntry::Assistant(_) | ChatEntry::Tool(_))
+}
+
+fn assistant_text(blocks: &[MessageBlock]) -> String {
+    blocks
+        .iter()
+        .filter_map(|block| match block {
+            MessageBlock::Text(text) => Some(text.as_str()),
+            MessageBlock::Thinking(_) => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// Keep the last `MAX_CHARS` characters; the end of a reply carries the question or next step.
+fn tail(text: &str) -> String {
+    let count = text.chars().count();
+    if count <= MAX_CHARS {
+        return text.to_owned();
+    }
+    let kept: String = text.chars().skip(count - MAX_CHARS).collect();
+    format!("…{kept}")
+}
+
+/// First line, quotes stripped; `None` for empty, `NONE`, or overlong output.
+#[must_use]
+pub fn clean(raw: &str) -> Option<String> {
+    let line = raw.lines().map(str::trim).find(|line| !line.is_empty())?;
+    let line = line
+        .trim_matches(|c| matches!(c, '"' | '\'' | '`' | '“' | '”'))
+        .trim();
+    if line.is_empty() || line.eq_ignore_ascii_case("none") || line.chars().count() > MAX_SUGGESTION_CHARS {
+        return None;
+    }
+    Some(line.to_owned())
+}
+
+/// The placeholder text the editor renders dim.
+#[must_use]
+pub fn ghost(text: &str) -> String {
+    format!("{text}  (tab)")
+}
+
+/// Session-side suggestion state: one request in flight, stale results dropped by generation.
+#[derive(Default)]
+pub struct SuggestState {
+    pub enabled: bool,
+    pub model: Option<String>,
+    pub suggester: Option<Arc<dyn PromptSuggester>>,
+    generation: u64,
+    task: Option<tokio::task::JoinHandle<()>>,
+}
+
+impl SuggestState {
+    #[must_use]
+    pub fn new(config: PromptSuggestConfig, suggester: Option<Arc<dyn PromptSuggester>>) -> Self {
+        Self { enabled: config.enabled, model: config.model, suggester, ..Self::default() }
+    }
+
+    /// Abort any in-flight request and invalidate its result.
+    pub fn cancel(&mut self) {
+        self.generation = self.generation.wrapping_add(1);
+        if let Some(task) = self.task.take() {
+            task.abort();
+        }
+    }
+
+    /// Start a request when enabled; the note arrives on `notes`.
+    pub fn request(
+        &mut self,
+        entries: &[ChatEntry],
+        session_model: Option<(String, String)>,
+        notes: &tokio::sync::mpsc::UnboundedSender<SuggestNote>,
+    ) -> bool {
+        self.cancel();
+        let (true, Some(suggester)) = (self.enabled, self.suggester.clone()) else {
+            return false;
+        };
+        let Some(prompt) = build_prompt(entries) else {
+            return false;
+        };
+        let request = SuggestRequest { prompt, model: self.model.clone(), session_model };
+        let generation = self.generation;
+        let notes = notes.clone();
+        self.task = Some(tokio::spawn(async move {
+            let text = suggester.suggest(request).await.as_deref().and_then(clean);
+            let _ = notes.send(SuggestNote { generation, text });
+        }));
+        true
+    }
+
+    /// The note's text when it belongs to the current generation.
+    #[must_use]
+    pub fn accept(&mut self, note: SuggestNote) -> Option<String> {
+        if note.generation != self.generation {
+            return None;
+        }
+        self.task = None;
+        note.text
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::chat::AssistantMessage;
+
+    fn user(text: &str) -> ChatEntry {
+        ChatEntry::User { text: text.into() }
+    }
+
+    fn assistant(text: &str) -> ChatEntry {
+        ChatEntry::Assistant(Box::new(AssistantMessage {
+            blocks: vec![MessageBlock::Thinking("hmm".into()), MessageBlock::Text(text.into())],
+            has_tool_calls: false,
+            streaming: false,
+            error: None,
+            aborted: false,
+        }))
+    }
+
+    struct Fixed(&'static str);
+
+    impl PromptSuggester for Fixed {
+        fn suggest(&self, request: SuggestRequest) -> SuggestFuture {
+            assert!(request.prompt.starts_with("<transcript>"));
+            let text = self.0.to_owned();
+            Box::pin(async move { Some(text) })
+        }
+    }
+
+    #[test]
+    fn prompt_needs_a_finished_answer_last() {
+        assert_eq!(build_prompt(&[]), None);
+        assert_eq!(build_prompt(&[assistant("done"), user("next")]), None);
+        let ChatEntry::Assistant(mut aborted) = assistant("x") else { unreachable!() };
+        aborted.aborted = true;
+        assert_eq!(build_prompt(&[user("go"), ChatEntry::Assistant(aborted)]), None);
+    }
+
+    #[test]
+    fn prompt_lists_recent_turns_without_thinking() {
+        let prompt = build_prompt(&[user("fix it"), assistant("Fixed. Run tests?")]).expect("prompt");
+        assert_eq!(
+            prompt,
+            "<transcript>\nUSER: fix it\n\nASSISTANT: Fixed. Run tests?\n</transcript>\n\nPredict my next message."
+        );
+    }
+
+    #[test]
+    fn prompt_keeps_last_eight_and_tails_long_text() {
+        let mut entries: Vec<ChatEntry> = (0..10).map(|i| user(&format!("u{i}"))).collect();
+        entries.push(assistant(&format!("{}END", "x".repeat(2000))));
+        let prompt = build_prompt(&entries).expect("prompt");
+        assert!(!prompt.contains("USER: u2\n"));
+        assert!(prompt.contains("USER: u3"));
+        assert!(prompt.contains("ASSISTANT: …x"));
+        assert!(prompt.contains("END\n</transcript>"));
+    }
+
+    #[test]
+    fn clean_rejects_none_and_long_output() {
+        assert_eq!(clean("\n \"run the tests\"\nwhy"), Some("run the tests".into()));
+        assert_eq!(clean("NONE"), None);
+        assert_eq!(clean("none"), None);
+        assert_eq!(clean(&"a".repeat(121)), None);
+        assert_eq!(clean("  "), None);
+        assert_eq!(ghost("yes"), "yes  (tab)");
+    }
+
+    #[tokio::test]
+    async fn stale_generation_is_dropped() {
+        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+        let config = PromptSuggestConfig { enabled: true, model: None };
+        let mut state = SuggestState::new(config, Some(Arc::new(Fixed("\"commit it\""))));
+        let entries = [user("fix"), assistant("Done.")];
+
+        assert!(state.request(&entries, None, &tx));
+        let note = rx.recv().await.expect("note");
+        assert_eq!(state.accept(note), Some("commit it".into()));
+
+        assert!(state.request(&entries, None, &tx));
+        let generation = state.generation;
+        state.cancel();
+        let stale_note = SuggestNote { generation, text: Some("old".into()) };
+        assert_eq!(state.accept(stale_note), None);
+
+        state.enabled = false;
+        assert!(!state.request(&entries, None, &tx));
+    }
+}
