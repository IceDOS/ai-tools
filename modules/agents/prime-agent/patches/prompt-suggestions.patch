--- /dev/null
+++ prime-agent-src/crates/pa-cli/src/prompt_suggest.rs
@@ -0,0 +1,93 @@
+//! pa-cli side of next-prompt suggestions: resolve the model and run one short completion.
+
+use pa_tui::prompt_suggest::{PromptSuggester, SuggestFuture, SuggestRequest, SYSTEM_PROMPT};
+use std::path::PathBuf;
+use std::time::Duration;
+
+const MAX_TOKENS: u64 = 1024;
+const TIMEOUT: Duration = Duration::from_secs(20);
+
+pub(crate) struct CliPromptSuggester {
+    pub agent_dir: PathBuf,
+}
+
+impl PromptSuggester for CliPromptSuggester {
+    fn suggest(&self, request: SuggestRequest) -> SuggestFuture {
+        let agent_dir = self.agent_dir.clone();
+        Box::pin(async move {
+            let resolved = tokio::task::spawn_blocking(move || resolve(&agent_dir, &request))
+                .await
+                .ok()??;
+            let (model, api_key, headers, prompt) = resolved;
+            let context = pa_types::ai::Context {
+                system_prompt: Some(SYSTEM_PROMPT.to_owned()),
+                messages: vec![pa_types::ai::Message::User(pa_types::ai::UserMessage {
+                    content: pa_types::ai::UserContent::Text(prompt),
+                    timestamp: now_ms(),
+                    rest: serde_json::Map::default(),
+                })],
+                tools: None,
+            };
+            let mut options = pa_ai::types::SimpleStreamOptions::from_base(pa_ai::types::StreamOptions {
+                max_tokens: Some(MAX_TOKENS),
+                api_key,
+                headers: headers.map(|h| h.into_iter().collect()),
+                ..Default::default()
+            });
+            if model.reasoning {
+                options.reasoning = Some(pa_types::ai::ModelThinkingLevel::Minimal);
+            }
+            let call = pa_ai::complete_simple(&model, &context, Some(options));
+            let response = tokio::time::timeout(TIMEOUT, call).await.ok()?.ok()?;
+            if response.stop_reason != pa_types::ai::StopReason::Stop {
+                return None;
+            }
+            let text = response
+                .content
+                .iter()
+                .filter_map(|block| match block {
+                    pa_types::ai::AssistantContentBlock::Text(text) => Some(text.text.as_str()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+                .join("\n");
+            Some(text)
+        })
+    }
+}
+
+type Resolved = (
+    pa_types::ai::Model,
+    Option<String>,
+    Option<std::collections::BTreeMap<String, String>>,
+    String,
+);
+
+/// `provider/id` override first, then the session model; `None` when neither resolves or has auth.
+fn resolve(agent_dir: &std::path::Path, request: &SuggestRequest) -> Option<Resolved> {
+    let auth = pa_core::auth::AuthStorage::create(agent_dir);
+    let mut registry = pa_core::models::ModelRegistry::create(auth, agent_dir.join("models.json"));
+    registry.load_private_authorization_from_cache();
+    let wanted = request
+        .model
+        .as_deref()
+        .and_then(|spec| spec.split_once('/'))
+        .map(|(provider, id)| (provider.to_owned(), id.to_owned()))
+        .or_else(|| request.session_model.clone())?;
+    let model = registry
+        .get_all()
+        .iter()
+        .find(|m| m.provider == wanted.0 && m.id == wanted.1)?
+        .clone();
+    let auth = registry.get_api_key_and_headers(&model, model.headers.as_ref());
+    if !auth.ok {
+        return None;
+    }
+    Some((model, auth.api_key, auth.headers, request.prompt.clone()))
+}
+
+fn now_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis() as u64)
+}
