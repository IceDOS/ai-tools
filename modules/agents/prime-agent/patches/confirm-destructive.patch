Index: prime-agent-src/crates/pa-tui/src/session_ui/leave_guard.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-tui/src/session_ui/leave_guard.rs
@@ -0,0 +1,101 @@
+//! confirm-destructive: ask before `/new`, `/resume` or `/switch` leaves a busy session.
+
+use anyhow::Result;
+
+use super::settings::{LeaveTarget, PendingConfirm};
+use super::{AgentView, SessionUi};
+use crate::chat::ChatEntry;
+
+/// The newest row that is not a status note is the user's prompt.
+pub(crate) fn has_unreplied_user_message(chat: &[ChatEntry]) -> bool {
+    chat.iter()
+        .rev()
+        .find(|entry| !matches!(entry, ChatEntry::Status { .. }))
+        .is_some_and(|entry| matches!(entry, ChatEntry::User { .. }))
+}
+
+impl SessionUi {
+    fn leave_needs_confirm(&self, view: &AgentView) -> bool {
+        let enabled = self
+            .client_settings
+            .as_ref()
+            .is_none_or(|settings| settings.confirm_destructive());
+        enabled
+            && (self.turn_active
+                || view.working.is_some()
+                || self.work_in_flight()
+                || has_unreplied_user_message(&view.chat))
+    }
+
+    /// `true` when a confirm now owns the frame; its `Yes` runs the leave.
+    pub(super) fn park_leave(&mut self, pending: PendingConfirm, view: &mut AgentView) -> bool {
+        if !self.leave_needs_confirm(view) {
+            return false;
+        }
+        view.confirm = Some(crate::confirm::ConfirmPanel::yes_no(
+            "Leave session",
+            "This session has a running turn or an unanswered message.\nLeave it anyway? It keeps running in the daemon.",
+        ));
+        self.pending_confirm = Some(pending);
+        self.dirty = true;
+        true
+    }
+
+    pub(super) async fn run_leave(&mut self, pending: PendingConfirm, view: &mut AgentView) -> Result<()> {
+        match pending {
+            PendingConfirm::NewSession => self.start_new_session(view).await?,
+            PendingConfirm::LeaveSession { target: LeaveTarget::AgentsView } => {
+                self.open_agents_view = true;
+                self.exit_requested = true;
+            }
+            PendingConfirm::LeaveSession { target: LeaveTarget::Resume(selection) } => {
+                self.pending_selection = Some(selection);
+                self.exit_requested = true;
+            }
+            PendingConfirm::LeaveSession { target: LeaveTarget::Switch(target) } => {
+                self.switch_to(&target, view).await?;
+            }
+            _ => {}
+        }
+        self.dirty = true;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::chat::StatusKind;
+    use crate::theme::{ColorMode, Theme};
+    use std::path::PathBuf;
+
+    fn user(text: &str) -> ChatEntry {
+        ChatEntry::User { text: text.to_string() }
+    }
+
+    fn status(text: &str) -> ChatEntry {
+        ChatEntry::Status { text: text.to_string(), kind: StatusKind::Info }
+    }
+
+    #[test]
+    fn a_trailing_user_row_is_unreplied_even_behind_status_notes() {
+        assert!(!has_unreplied_user_message(&[]));
+        assert!(has_unreplied_user_message(&[user("go")]));
+        assert!(has_unreplied_user_message(&[user("go"), status("retrying")]));
+        assert!(!has_unreplied_user_message(&[status("started session")]));
+    }
+
+    #[test]
+    fn a_running_turn_parks_the_leave_and_an_idle_session_does_not() {
+        let mut session = SessionUi::test_new(PathBuf::from("/test/repo"));
+        let mut view = AgentView::new(Theme::builtin("prime", ColorMode::TrueColor));
+        assert!(!session.park_leave(PendingConfirm::NewSession, &mut view));
+        assert!(view.confirm.is_none());
+
+        session.turn_active = true;
+        let target = PendingConfirm::LeaveSession { target: LeaveTarget::Switch("2".to_string()) };
+        assert!(session.park_leave(target.clone(), &mut view));
+        assert!(view.confirm.is_some());
+        assert_eq!(session.pending_confirm, Some(target));
+    }
+}
