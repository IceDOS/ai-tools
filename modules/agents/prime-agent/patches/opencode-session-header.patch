Index: prime-agent-src/crates/pa-ai/src/providers/opencode_session.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-ai/src/providers/opencode_session.rs
@@ -0,0 +1,208 @@
+use std::fmt::Write as _;
+use std::sync::OnceLock;
+
+use sha2::{Digest, Sha256};
+
+pub use crate::providers::opencode_tools::is_opencode_provider;
+
+pub const SESSION_HEADER: &str = "x-opencode-session";
+
+const BASE62: &[u8; 62] = b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+
+fn now_millis() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |elapsed| {
+            u64::try_from(elapsed.as_millis()).unwrap_or(u64::MAX)
+        })
+}
+
+// ses_<12 hex><14 base62>; a uuidv7 input keeps its embedded creation time.
+#[must_use]
+pub fn opencode_session_id(session_id: &str) -> String {
+    opencode_session_id_at(session_id, now_millis())
+}
+
+#[allow(clippy::cast_sign_loss, clippy::cast_possible_truncation)]
+fn opencode_session_id_at(session_id: &str, fallback_millis: u64) -> String {
+    let hex: String = session_id.chars().filter(|c| *c != '-').collect();
+    let timestamp = match (hex.chars().nth(12), hex.get(..12)) {
+        (Some('7'), Some(prefix)) => u64::from_str_radix(prefix, 16).unwrap_or(fallback_millis),
+        _ => fallback_millis,
+    };
+    let now = !(i128::from(timestamp) * 0x1000 + 1);
+    let mut out = String::with_capacity(4 + 12 + 14);
+    out.push_str("ses_");
+    for i in 0..6 {
+        let byte = ((now >> (40 - 8 * i)) & 0xff) as u8;
+        let _ = write!(out, "{byte:02x}");
+    }
+    let digest = Sha256::digest(session_id.as_bytes());
+    for byte in digest.iter().take(14) {
+        out.push(BASE62[usize::from(*byte) % 62] as char);
+    }
+    out
+}
+
+#[must_use]
+pub fn sanitize_opencode_url(provider: &str, base_url: &str) -> String {
+    let trimmed = base_url.trim_end_matches('/');
+    if is_opencode_provider(provider) && trimmed.contains("opencode.ai/zen/v1") {
+        trimmed.replace("opencode.ai/zen/v1", "opencode.ai/inference/v1")
+    } else {
+        trimmed.to_string()
+    }
+}
+
+// Headers for opencode provider request; calls without session id share a process id.
+#[must_use]
+pub fn session_headers(provider: &str, session_id: Option<&str>) -> Vec<(String, String)> {
+    let mut headers = Vec::new();
+    push_session_headers(&mut headers, provider, session_id);
+    headers
+}
+
+// Append headers required by OpenCode inference gate.
+pub fn push_session_headers(
+    headers: &mut Vec<(String, String)>,
+    provider: &str,
+    session_id: Option<&str>,
+) {
+    static PROCESS_ID: OnceLock<String> = OnceLock::new();
+    if !is_opencode_provider(provider) {
+        return;
+    }
+
+    // User-Agent: rewrite legacy 1.x or push 2.0.29
+    let mut has_ua = false;
+    for (name, val) in headers.iter_mut() {
+        if name.eq_ignore_ascii_case("User-Agent") {
+            has_ua = true;
+            if val.starts_with("opencode/1.") || val == "opencode" {
+                *val = "opencode/latest/2.0.29/cli".to_string();
+            }
+        }
+    }
+    if !has_ua {
+        headers.push(("User-Agent".to_string(), "opencode/latest/2.0.29/cli".to_string()));
+    }
+
+    // Clean up stale or non-ses_ session headers (e.g. legacy UUID pins)
+    headers.retain(|(name, val)| {
+        if name.eq_ignore_ascii_case(SESSION_HEADER) {
+            val.starts_with("ses_")
+        } else {
+            true
+        }
+    });
+
+    let sid = if let Some((_, val)) = headers
+        .iter()
+        .find(|(name, _)| name.eq_ignore_ascii_case(SESSION_HEADER))
+    {
+        val.clone()
+    } else {
+        let source = match session_id.filter(|id| !id.is_empty()) {
+            Some(id) => id.to_string(),
+            None => PROCESS_ID
+                .get_or_init(|| format!("prime-agent-{}-{}", std::process::id(), now_millis()))
+                .clone(),
+        };
+        let val = opencode_session_id(&source);
+        headers.push((SESSION_HEADER.to_string(), val.clone()));
+        val
+    };
+
+    for header_name in ["x-opencode-session-id", "x-session-affinity", "x-session-id"] {
+        if !headers.iter().any(|(name, _)| name.eq_ignore_ascii_case(header_name)) {
+            headers.push((header_name.to_string(), sid.clone()));
+        }
+    }
+
+    if !headers.iter().any(|(name, _)| name.eq_ignore_ascii_case("x-opencode-client")) {
+        headers.push(("x-opencode-client".to_string(), "cli".to_string()));
+    }
+
+    if !headers.iter().any(|(name, _)| name.eq_ignore_ascii_case("x-opencode-project")) {
+        let cwd = std::env::current_dir().unwrap_or_default();
+        let hex_full = format!("{:x}", Sha256::digest(cwd.to_string_lossy().as_bytes()));
+        let hex_40 = if hex_full.len() >= 40 { &hex_full[..40] } else { &hex_full };
+        headers.push(("x-opencode-project".to_string(), hex_40.to_string()));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn uuidv7_input_reuses_its_timestamp() {
+        let id = "0199a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b";
+        assert_eq!(opencode_session_id(id), "ses_65e4d3c2bffeWm3vAwwKMFbd8o");
+        let first = opencode_session_id_at(id, 1);
+        let second = opencode_session_id_at(id, 2);
+        assert_eq!(
+            first, second,
+            "the fallback clock must not leak into a v7 id"
+        );
+        assert!(first.starts_with("ses_"));
+        assert_eq!(first.len(), 4 + 12 + 14);
+    }
+
+    #[test]
+    fn non_v7_input_uses_the_clock_and_a_stable_suffix() {
+        let a = opencode_session_id_at("not-a-uuid", 1_000);
+        let b = opencode_session_id_at("not-a-uuid", 2_000);
+        assert_ne!(a[4..16], b[4..16]);
+        assert_eq!(a[16..], b[16..], "the suffix hashes the session id only");
+        assert!(a[16..].bytes().all(|c| BASE62.contains(&c)));
+    }
+
+    #[test]
+    fn descending_ids_sort_newer_first() {
+        let older = opencode_session_id_at("x", 1_700_000_000_000);
+        let newer = opencode_session_id_at("x", 1_700_000_000_500);
+        assert!(newer[4..16] < older[4..16]);
+    }
+
+    #[test]
+    fn headers_only_for_opencode_providers_and_never_twice() {
+        assert!(session_headers("anthropic", Some("s")).is_empty());
+        assert!(!session_headers("opencode-go", None).is_empty());
+        let mut headers = vec![("X-OpenCode-Session".to_string(), "ses_valid0123456789".to_string())];
+        push_session_headers(&mut headers, "opencode", Some("s"));
+        assert_eq!(headers[0].1, "ses_valid0123456789");
+        assert!(headers.iter().any(|(k, _)| k == "x-opencode-session-id"));
+        assert!(headers.iter().any(|(k, _)| k == "x-opencode-client"));
+        assert!(headers.iter().any(|(k, _)| k == "x-opencode-project"));
+    }
+
+    #[test]
+    fn legacy_uuid_session_header_is_filtered() {
+        let mut headers = vec![("x-opencode-session".to_string(), "dc8edd48-001d-4050-aa32-f46c3935c285".to_string())];
+        push_session_headers(&mut headers, "opencode", Some("s"));
+        let session = headers.iter().find(|(k, _)| k == "x-opencode-session").unwrap();
+        assert!(session.1.starts_with("ses_"));
+        assert_ne!(session.1, "dc8edd48-001d-4050-aa32-f46c3935c285");
+    }
+
+    #[test]
+    fn legacy_user_agent_is_upgraded() {
+        let mut headers = vec![("User-Agent".to_string(), "opencode/1.19.0".to_string())];
+        push_session_headers(&mut headers, "opencode", Some("s"));
+        let ua = headers.iter().find(|(k, _)| k == "User-Agent").unwrap();
+        assert_eq!(ua.1, "opencode/latest/2.0.29/cli");
+    }
+
+    #[test]
+    fn url_sanitization_rewrites_zen() {
+        assert_eq!(
+            sanitize_opencode_url("opencode", "https://opencode.ai/zen/v1/"),
+            "https://opencode.ai/inference/v1"
+        );
+        assert_eq!(
+            sanitize_opencode_url("openai", "https://api.openai.com/v1/"),
+            "https://api.openai.com/v1"
+        );
+    }
+}
