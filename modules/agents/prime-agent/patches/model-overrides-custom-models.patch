 #[test]
+fn models_json_model_overrides_apply_to_custom_models() {
+    let dir = tempfile::tempdir().unwrap();
+    let models_path = dir.path().join("models.json");
+    std::fs::write(
+        &models_path,
+        r#"{ "providers": { "custom": {
+            "baseUrl": "https://custom.example", "apiKey": "custom-key",
+            "api": "openai-completions",
+            "models": [ { "id": "big", "contextWindow": 1000000 }, { "id": "other" } ],
+            "modelOverrides": { "big": { "contextWindow": 200000, "maxTokens": 8000 } }
+        } } }"#,
+    )
+    .unwrap();
+    let registry = ModelRegistry::create(auth_with(&serde_json::json!({})), &models_path);
+    assert!(registry.get_error().is_none());
+    let find = |id: &str| {
+        registry
+            .get_all()
+            .iter()
+            .find(|m| m.provider == "custom" && m.id == id)
+            .unwrap_or_else(|| panic!("custom model {id} merged"))
+            .clone()
+    };
+    let big = find("big");
+    assert_eq!(big.context_window, 200_000);
+    assert_eq!(big.max_tokens, 8_000);
+    assert!(big.max_tokens_explicit);
+    // A model without an override keeps its definition defaults.
+    assert_eq!(find("other").context_window, 128_000);
+}
