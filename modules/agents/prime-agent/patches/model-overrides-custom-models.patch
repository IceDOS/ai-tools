+    /// `modelOverrides` also apply to models defined in `models[]`, so a cap such as
+    /// `contextWindow` holds for custom providers too.
+    fn apply_custom_model_overrides(custom: &CustomModelsResult) -> Vec<Model> {
+        custom
+            .models
+            .iter()
+            .map(|model| {
+                custom
+                    .model_overrides
+                    .get(&model.provider)
+                    .and_then(|overrides| overrides.get(&model.id))
+                    .map_or_else(|| model.clone(), |over| apply_model_override(model, over))
+            })
+            .collect()
+    }
 
