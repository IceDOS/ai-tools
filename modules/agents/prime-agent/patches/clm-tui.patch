Index: prime-agent-src/crates/pa-tui/src/session_ui/clm.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-tui/src/session_ui/clm.rs
@@ -0,0 +1,179 @@
+//! `/clm`: CLM status, settings and the edits panel for the active session.
+
+use std::time::Duration;
+
+use anyhow::Result;
+use serde_json::{Map, Value};
+
+use pa_types::clm_view::ClmView;
+use pa_types::daemon::DaemonCommand;
+
+use super::AgentView;
+use crate::clm_view::{ClmPanel, ClmPanelAction, ClmTab};
+use crate::session_ui::UI_REQUEST_TIMEOUT_MS;
+
+const USAGE: &str = "Usage: /clm [edits|settings|status|config <key> <value>|config reset|on|off|reset]";
+
+pub(crate) fn status_lines(view: &ClmView) -> [String; 3] {
+    let status = &view.status;
+    let budget = status.budget.map_or_else(|| "no budget".to_string(), |budget| budget.to_string());
+    let observed = status
+        .observed
+        .map_or_else(String::new, |tokens| format!(" (provider last saw {tokens})"));
+    let changed: Vec<String> = view
+        .settings
+        .iter()
+        .filter(|setting| setting.value != setting.default)
+        .map(|setting| format!("{}={}", setting.key, setting.value))
+        .collect();
+    [
+        format!(
+            "CLM {}: ~{} of {budget} tokens{observed}",
+            if status.enabled { "on" } else { "paused" },
+            status.estimate
+        ),
+        format!("Projection revision {}, {} accepted edit(s)", status.revision, status.edit_count),
+        format!(
+            "Session settings: {}",
+            if changed.is_empty() { "defaults".to_string() } else { changed.join(", ") }
+        ),
+    ]
+}
+
+fn parse_view(data: Value) -> Result<ClmView> {
+    Ok(serde_json::from_value(data)?)
+}
+
+impl super::SessionUi {
+    async fn clm_request(&self, command: DaemonCommand) -> Result<ClmView> {
+        parse_view(self.bounded_request(Duration::from_millis(UI_REQUEST_TIMEOUT_MS), command).await?)
+    }
+
+    async fn clm_get(&self, revision: Option<u64>) -> Result<ClmView> {
+        self.clm_request(DaemonCommand::GetClmView {
+            id: None,
+            active_session_id: self.active_session_id.clone(),
+            revision,
+            rest: Map::default(),
+        })
+        .await
+    }
+
+    async fn clm_set(&self, action: &str, key: Option<&str>, value: Option<&str>) -> Result<ClmView> {
+        self.clm_request(DaemonCommand::ClmConfigure {
+            id: None,
+            active_session_id: self.active_session_id.clone(),
+            action: action.to_string(),
+            key: key.map(str::to_string),
+            value: value.map(str::to_string),
+            rest: Map::default(),
+        })
+        .await
+    }
+
+    pub(crate) async fn handle_clm_command(&mut self, args: &str, view: &mut AgentView) -> Result<()> {
+        let words: Vec<&str> = args.split_whitespace().collect();
+        let result = match words.as_slice() {
+            [] | ["edits"] => self.clm_get(None).await.map(|data| {
+                view.clm_view = Some(ClmPanel::new(data, ClmTab::Edits));
+                None
+            }),
+            ["settings"] => self.clm_get(None).await.map(|data| {
+                view.clm_view = Some(ClmPanel::new(data, ClmTab::Settings));
+                None
+            }),
+            ["status"] => self.clm_get(None).await.map(|data| Some(status_lines(&data).to_vec())),
+            ["config", "reset"] => self
+                .clm_set("reset_settings", None, None)
+                .await
+                .map(|_| Some(vec!["CLM settings back to the Nix defaults for this session".to_string()])),
+            ["config", key, value] => self
+                .clm_set("set", Some(key), Some(value))
+                .await
+                .map(|_| Some(vec![format!("CLM {key} set to {value} for this session")])),
+            ["on"] => self.clm_set("on", None, None).await.map(|_| Some(vec!["CLM is on for this session".to_string()])),
+            ["off"] => self
+                .clm_set("off", None, None)
+                .await
+                .map(|_| Some(vec!["CLM is paused for this session; requests use the raw context".to_string()])),
+            ["reset"] => self
+                .clm_set("reset", None, None)
+                .await
+                .map(|_| Some(vec!["CLM projection reset; the next request uses the raw context".to_string()])),
+            _ => {
+                self.error_row(USAGE, view);
+                return Ok(());
+            }
+        };
+        match result {
+            Ok(Some(lines)) => {
+                for line in lines {
+                    self.plain_row(&line, view);
+                }
+            }
+            Ok(None) => {}
+            Err(error) => self.error_row(&format!("{error:#}"), view),
+        }
+        self.dirty = true;
+        Ok(())
+    }
+
+    pub(crate) async fn handle_clm_view_key(
+        &mut self,
+        key: crossterm::event::KeyEvent,
+        view: &mut AgentView,
+    ) -> Result<()> {
+        let Some(id) = super::key_event_to_id(&key) else { return Ok(()) };
+        let action = view
+            .clm_view
+            .as_mut()
+            .map(|panel| panel.handle_key(&id, view.editor.keybindings()));
+        let Some(action) = action else { return Ok(()) };
+        let reply = match action {
+            ClmPanelAction::None => None,
+            ClmPanelAction::Close => {
+                view.clm_view = None;
+                None
+            }
+            ClmPanelAction::LoadRevision(revision) => Some(self.clm_get(Some(revision)).await),
+            ClmPanelAction::Set { key, value } => Some(self.clm_set("set", Some(&key), Some(&value)).await),
+        };
+        if let (Some(reply), Some(panel)) = (reply, view.clm_view.as_mut()) {
+            match reply {
+                Ok(data) => panel.replace(data),
+                Err(error) => panel.set_error(format!("{error:#}")),
+            }
+        }
+        self.dirty = true;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::status_lines;
+    use pa_types::clm_view::{ClmSetting, ClmSettingKind, ClmStatus, ClmView};
+
+    #[test]
+    fn status_prints_three_lines() {
+        let mut view = ClmView {
+            status: ClmStatus { enabled: true, estimate: 12_000, budget: Some(64_000), observed: Some(11_500), revision: 2, edit_count: 1 },
+            settings: vec![ClmSetting { key: "budget".into(), label: "Token budget".into(), value: "32000".into(), default: "64000".into(), kind: ClmSettingKind::Number, choices: vec![] }],
+            ..ClmView::default()
+        };
+        assert_eq!(
+            status_lines(&view),
+            [
+                "CLM on: ~12000 of 64000 tokens (provider last saw 11500)".to_string(),
+                "Projection revision 2, 1 accepted edit(s)".to_string(),
+                "Session settings: budget=32000".to_string(),
+            ]
+        );
+        view.settings[0].value = "64000".into();
+        view.status.enabled = false;
+        view.status.observed = None;
+        let lines = status_lines(&view);
+        assert!(lines[0].starts_with("CLM paused: ~12000 of 64000 tokens"));
+        assert_eq!(lines[2], "Session settings: defaults");
+    }
+}
