+//! The `/clm` panel: accepted edits as word diffs, and the session's CLM settings.
+
+use std::collections::BTreeSet;
+
+use pa_types::clm_view::{ClmEditMessage, ClmSegmentKind, ClmSettingKind, ClmView};
+use unicode_width::UnicodeWidthChar;
+
+use crate::keybindings::KeybindingsManager;
+use crate::theme::{Theme, ThemeColor};
+use crate::width::truncate_line;
+use crate::{Line, Span};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ClmTab {
+    Edits,
+    Settings,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ClmPanelAction {
+    None,
+    Close,
+    LoadRevision(u64),
+    Set { key: String, value: String },
+}
+
+#[derive(Debug)]
+pub struct ClmPanel {
+    view: ClmView,
+    tab: ClmTab,
+    selected: usize,
+    expanded: BTreeSet<usize>,
+    expand_all: bool,
+    error: Option<String>,
+}
+
+const SIDE_BY_SIDE_MIN: usize = 60;
+
+/// Wrap `text` into rows of at most `width` columns, breaking on characters.
+fn wrap(text: &str, width: usize) -> Vec<String> {
+    let mut rows = Vec::new();
+    for source in text.split('\n') {
+        let (mut row, mut used) = (String::new(), 0);
+        for ch in source.chars() {
+            let w = ch.width().unwrap_or(0);
+            if used + w > width.max(1) {
+                rows.push(std::mem::take(&mut row));
+                used = 0;
+            }
+            row.push(ch);
+            used += w;
+        }
+        rows.push(row);
+    }
+    rows
+}
+
+fn pad(text: &str, width: usize) -> String {
+    let used: usize = text.chars().map(|ch| ch.width().unwrap_or(0)).sum();
+    format!("{text}{}", " ".repeat(width.saturating_sub(used)))
+}
+
+impl ClmPanel {
+    #[must_use]
+    pub fn new(view: ClmView, tab: ClmTab) -> Self {
+        Self { view, tab, selected: 0, expanded: BTreeSet::new(), expand_all: false, error: None }
+    }
+
+    /// New data for the same panel (a revision switch or a settings change).
+    pub fn replace(&mut self, view: ClmView) {
+        if view.revision != self.view.revision {
+            self.expanded.clear();
+            if self.tab == ClmTab::Edits {
+                self.selected = 0;
+            }
+        }
+        self.view = view;
+        self.error = None;
+        self.selected = self.selected.min(self.rows().saturating_sub(1));
+    }
+
+    pub fn set_error(&mut self, text: String) {
+        self.error = Some(text);
+    }
+
+    fn rows(&self) -> usize {
+        match self.tab {
+            ClmTab::Edits => self.view.edits.len(),
+            ClmTab::Settings => self.view.settings.len(),
+        }
+    }
+
+    fn switch(&mut self, tab: ClmTab) {
+        if self.tab != tab {
+            self.tab = tab;
+            self.selected = 0;
+        }
+    }
+
+    fn step_revision(&self, newer: bool) -> ClmPanelAction {
+        let Some(current) = self.view.revision else { return ClmPanelAction::None };
+        let Some(index) = self.view.revisions.iter().position(|rev| *rev == current) else {
+            return ClmPanelAction::None;
+        };
+        let next = if newer { index.checked_add(1) } else { index.checked_sub(1) };
+        next.and_then(|index| self.view.revisions.get(index))
+            .map_or(ClmPanelAction::None, |rev| ClmPanelAction::LoadRevision(*rev))
+    }
+
+    pub fn handle_key(&mut self, key: &str, kb: &KeybindingsManager) -> ClmPanelAction {
+        if key == "q" || key == "ctrl+c" || key == "escape" || kb.matches(key, "tui.select.cancel") {
+            return ClmPanelAction::Close;
+        }
+        match key {
+            "tab" => {
+                self.switch(if self.tab == ClmTab::Edits { ClmTab::Settings } else { ClmTab::Edits });
+                return ClmPanelAction::None;
+            }
+            "1" => {
+                self.switch(ClmTab::Edits);
+                return ClmPanelAction::None;
+            }
+            "2" => {
+                self.switch(ClmTab::Settings);
+                return ClmPanelAction::None;
+            }
+            _ => {}
+        }
+        if kb.matches(key, "tui.select.up") {
+            self.selected = self.selected.saturating_sub(1);
+            return ClmPanelAction::None;
+        }
+        if kb.matches(key, "tui.select.down") {
+            self.selected = (self.selected + 1).min(self.rows().saturating_sub(1));
+            return ClmPanelAction::None;
+        }
+        match self.tab {
+            ClmTab::Edits => match key {
+                "left" => self.step_revision(false),
+                "right" => self.step_revision(true),
+                "a" => {
+                    self.expand_all = !self.expand_all;
+                    ClmPanelAction::None
+                }
+                _ if kb.matches(key, "tui.select.confirm") => {
+                    if !self.expanded.remove(&self.selected) {
+                        self.expanded.insert(self.selected);
+                    }
+                    ClmPanelAction::None
+                }
+                _ => ClmPanelAction::None,
+            },
+            ClmTab::Settings if kb.matches(key, "tui.select.confirm") => {
+                let Some(setting) = self.view.settings.get(self.selected) else {
+                    return ClmPanelAction::None;
+                };
+                if setting.kind == ClmSettingKind::Number || setting.choices.is_empty() {
+                    return ClmPanelAction::None;
+                }
+                let at = setting.choices.iter().position(|choice| *choice == setting.value).unwrap_or(0);
+                ClmPanelAction::Set {
+                    key: setting.key.clone(),
+                    value: setting.choices[(at + 1) % setting.choices.len()].clone(),
+                }
+            }
+            ClmTab::Settings => ClmPanelAction::None,
+        }
+    }
+
+    fn header(&self, theme: &Theme) -> Vec<Line> {
+        let status = &self.view.status;
+        let tab = |label: &str, active: bool| {
+            theme.fg_span(if active { ThemeColor::Accent } else { ThemeColor::Muted }, label.to_string())
+        };
+        let budget = status.budget.map_or_else(|| "no budget".to_string(), |budget| format!("{budget}"));
+        let observed = status.observed.map_or_else(String::new, |tokens| format!(", provider saw {tokens}"));
+        vec![
+            vec![
+                Span::raw("  "),
+                tab("1 Edits", self.tab == ClmTab::Edits),
+                Span::raw("   "),
+                tab("2 Settings", self.tab == ClmTab::Settings),
+                Span::raw("   "),
+                theme.fg_span(
+                    ThemeColor::Dim,
+                    format!(
+                        "{} ~{} of {budget} tokens{observed}",
+                        if status.enabled { "on" } else { "paused" },
+                        status.estimate
+                    ),
+                ),
+            ],
+            Vec::new(),
+        ]
+    }
+
+fn diff_rows(theme: &Theme, message: &ClmEditMessage, width: usize) -> Vec<Line> {
+    let inner = width.saturating_sub(4);
+    let colored = |text: String, kind: ClmSegmentKind| {
+        let color = match kind {
+            ClmSegmentKind::Del => ThemeColor::ToolDiffRemoved,
+            ClmSegmentKind::Add => ThemeColor::ToolDiffAdded,
+            ClmSegmentKind::Same => ThemeColor::Text,
+        };
+        theme.fg_span(color, text)
+    };
+    let (before, after) = (message.side(false), message.side(true));
+    if width >= SIDE_BY_SIDE_MIN {
+        let column = inner.saturating_sub(3) / 2;
+        let (left, right) = (wrap(&before, column), wrap(&after, column));
+        (0..left.len().max(right.len()))
+            .map(|row| {
+                vec![
+                    Span::raw("    "),
+                    colored(pad(left.get(row).map_or("", String::as_str), column), ClmSegmentKind::Del),
+                    theme.fg_span(ThemeColor::Dim, " | "),
+                    colored(right.get(row).cloned().unwrap_or_default(), ClmSegmentKind::Add),
+                ]
+            })
+            .collect()
+    } else {
+        let mut rows: Vec<Line> = wrap(&before, inner.saturating_sub(2))
+            .into_iter()
+            .map(|row| vec![Span::raw("    "), colored(format!("- {row}"), ClmSegmentKind::Del)])
+            .collect();
+        rows.extend(
+            wrap(&after, inner.saturating_sub(2))
+                .into_iter()
+                .map(|row| vec![Span::raw("    "), colored(format!("+ {row}"), ClmSegmentKind::Add)]),
+        );
+        rows
+    }
+}
+
+    fn edits(&self, theme: &Theme, width: usize) -> Vec<Line> {
+        let line = |color: ThemeColor, text: String| vec![Span::raw("  "), theme.fg_span(color, text)];
+        let Some(revision) = self.view.revision else {
+            return vec![line(ThemeColor::Muted, "No accepted edits in this session".into())];
+        };
+        let position = self.view.revisions.iter().position(|rev| *rev == revision).map_or(0, |index| index + 1);
+        let mut rows = vec![line(
+            ThemeColor::Text,
+            format!("Revision {revision} of {}  (left/right: revision, enter: diff, a: all)", self.view.revisions.len().max(position)),
+        )];
+        if let Some(note) = &self.view.note {
+            rows.push(line(ThemeColor::Warning, note.clone()));
+            return rows;
+        }
+        for (index, message) in self.view.edits.iter().enumerate() {
+            let marker = if index == self.selected { "> " } else { "  " };
+            let state = match (message.changed, message.segments.first().map(|segment| segment.kind)) {
+                (false, _) => "same",
+                (true, Some(ClmSegmentKind::Del)) if message.segments.len() == 1 => "deleted",
+                (true, Some(ClmSegmentKind::Add)) if message.segments.len() == 1 => "added",
+                _ => "changed",
+            };
+            let preview: String = message.side(true).split_whitespace().collect::<Vec<_>>().join(" ");
+            let room = width.saturating_sub(30);
+            let preview: String = preview.chars().take(room).collect();
+            rows.push(vec![
+                Span::raw("  "),
+                theme.fg_span(ThemeColor::Accent, marker.to_string()),
+                theme.fg_span(ThemeColor::Text, pad(&message.role, 10)),
+                theme.fg_span(if message.changed { ThemeColor::Warning } else { ThemeColor::Dim }, pad(state, 9)),
+                theme.fg_span(ThemeColor::Muted, preview),
+            ]);
+            if message.changed && (self.expand_all || self.expanded.contains(&index)) {
+                rows.extend(Self::diff_rows(theme, message, width));
+            }
+        }
+        rows
+    }
+
+    fn settings(&self, theme: &Theme) -> Vec<Line> {
+        self.view
+            .settings
+            .iter()
+            .enumerate()
+            .map(|(index, setting)| {
+                let marker = if index == self.selected { "> " } else { "  " };
+                let hint = match setting.kind {
+                    ClmSettingKind::Number => format!("set with /clm config {} <value>", setting.key),
+                    _ => "enter: change".to_string(),
+                };
+                let changed = setting.value != setting.default;
+                vec![
+                    Span::raw("  "),
+                    theme.fg_span(ThemeColor::Accent, marker.to_string()),
+                    theme.fg_span(ThemeColor::Text, pad(&setting.label, 26)),
+                    theme.fg_span(if changed { ThemeColor::Warning } else { ThemeColor::Text }, pad(&setting.value, 14)),
+                    theme.fg_span(ThemeColor::Dim, hint),
+                ]
+            })
+            .collect()
+    }
+
+    #[must_use]
+    pub fn render(&self, theme: &Theme, width: usize, _kb: &KeybindingsManager) -> Vec<Line> {
+        let mut rows = self.header(theme);
+        rows.extend(match self.tab {
+            ClmTab::Edits => self.edits(theme, width),
+            ClmTab::Settings => self.settings(theme),
+        });
+        if let Some(error) = &self.error {
+            rows.push(vec![Span::raw("  "), theme.fg_span(ThemeColor::Error, error.clone())]);
+        }
+        rows.push(vec![Span::raw("  "), theme.fg_span(ThemeColor::Dim, "tab or 1/2: page   q or esc: close".to_string())]);
+        rows.iter().map(|row| truncate_line(row, width, "")).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests;
