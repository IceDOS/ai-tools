+//! Word-level diff of an accepted edit, over the jsdiff line port.
+
+use pa_types::clm_view::{ClmEditMessage, ClmSegment, ClmSegmentKind};
+use serde_json::Value;
+
+use super::document::render_message;
+use super::jsdiff::diff_lines;
+
+// Tokens become diff lines, so newlines inside them are swapped out and back.
+const NEWLINE: char = '\u{1}';
+
+fn tokens(text: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for ch in text.chars() {
+        match out.last_mut() {
+            Some(last)
+                if last
+                    .chars()
+                    .last()
+                    .is_some_and(|prev| prev.is_whitespace() == ch.is_whitespace()) =>
+            {
+                last.push(ch);
+            }
+            _ => out.push(ch.to_string()),
+        }
+    }
+    out
+}
+
+fn as_lines(tokens: &[String]) -> String {
+    let mut out = String::new();
+    for token in tokens {
+        out.push_str(&token.replace('\n', &NEWLINE.to_string()));
+        out.push('\n');
+    }
+    out
+}
+
+fn push(out: &mut Vec<ClmSegment>, kind: ClmSegmentKind, text: String) {
+    if text.is_empty() {
+        return;
+    }
+    match out.last_mut() {
+        Some(last) if last.kind == kind => last.text.push_str(&text),
+        _ => out.push(ClmSegment { kind, text }),
+    }
+}
+
+#[must_use]
+pub fn word_segments(old: &str, new: &str) -> Vec<ClmSegment> {
+    let mut out = Vec::new();
+    for part in diff_lines(&as_lines(&tokens(old)), &as_lines(&tokens(new))) {
+        let kind = if part.added {
+            ClmSegmentKind::Add
+        } else if part.removed {
+            ClmSegmentKind::Del
+        } else {
+            ClmSegmentKind::Same
+        };
+        let text: String = part
+            .value
+            .split_terminator('\n')
+            .map(|token| token.replace(NEWLINE, "\n"))
+            .collect();
+        push(&mut out, kind, text);
+    }
+    out
+}
+
+fn label(message: &Value) -> String {
+    message["details"]["contextRole"]
+        .as_str()
+        .or_else(|| message["role"].as_str())
+        .unwrap_or("")
+        .to_string()
+}
+
+fn key(message: &Value) -> String {
+    format!(
+        "{}{NEWLINE}{}\n",
+        label(message),
+        render_message(message).replace('\n', &NEWLINE.to_string())
+    )
+}
+
+fn whole(message: &Value, kind: ClmSegmentKind) -> ClmEditMessage {
+    ClmEditMessage {
+        role: label(message),
+        changed: kind != ClmSegmentKind::Same,
+        segments: vec![ClmSegment {
+            kind,
+            text: render_message(message),
+        }],
+    }
+}
+
+/// One row per message: unchanged, rewritten (paired in order inside a changed
+/// run), deleted or added.
+#[must_use]
+pub fn message_edits(before: &[Value], after: &[Value]) -> Vec<ClmEditMessage> {
+    let old: String = before.iter().map(key).collect();
+    let new: String = after.iter().map(key).collect();
+    let parts = diff_lines(&old, &new);
+    let (mut out, mut i, mut j, mut k) = (Vec::new(), 0, 0, 0);
+    while k < parts.len() {
+        if !parts[k].added && !parts[k].removed {
+            for _ in 0..parts[k].count {
+                out.push(whole(&after[j], ClmSegmentKind::Same));
+                i += 1;
+                j += 1;
+            }
+            k += 1;
+            continue;
+        }
+        let (mut removed, mut added) = (0, 0);
+        while k < parts.len() && (parts[k].added || parts[k].removed) {
+            if parts[k].added {
+                added += parts[k].count;
+            } else {
+                removed += parts[k].count;
+            }
+            k += 1;
+        }
+        for n in 0..removed.max(added) {
+            out.push(match (n < removed, n < added) {
+                (true, true) => ClmEditMessage {
+                    role: label(&after[j + n]),
+                    changed: true,
+                    segments: word_segments(
+                        &render_message(&before[i + n]),
+                        &render_message(&after[j + n]),
+                    ),
+                },
+                (true, false) => whole(&before[i + n], ClmSegmentKind::Del),
+                _ => whole(&after[j + n], ClmSegmentKind::Add),
+            });
+        }
+        i += removed;
+        j += added;
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn seg(kind: ClmSegmentKind, text: &str) -> ClmSegment {
+        ClmSegment {
+            kind,
+            text: text.into(),
+        }
+    }
+
+    #[test]
+    fn words_diff_keeps_spacing_and_newlines() {
+        assert_eq!(
+            word_segments("fix the old bug\nnow", "fix the new bug\nnow"),
+            vec![
+                seg(ClmSegmentKind::Same, "fix the "),
+                seg(ClmSegmentKind::Del, "old"),
+                seg(ClmSegmentKind::Add, "new"),
+                seg(ClmSegmentKind::Same, " bug\nnow"),
+            ]
+        );
+        assert_eq!(
+            word_segments("", "added"),
+            vec![seg(ClmSegmentKind::Add, "added")]
+        );
+    }
+
+    #[test]
+    fn messages_pair_rewrites_and_mark_deletes_and_adds() {
+        let user = json!({ "role": "user", "content": "task: fix a.py", "timestamp": 1 });
+        let long = json!({ "role": "assistant", "content": [{ "type": "text", "text": "a very long read" }], "timestamp": 2 });
+        let short = json!({ "role": "assistant", "content": [{ "type": "text", "text": "a short read" }], "timestamp": 2 });
+        let gone = json!({ "role": "user", "content": "noise", "timestamp": 3 });
+        let note = json!({
+            "role": "custom",
+            "customType": "live-context-projection",
+            "content": "[context role=notes]\nplan",
+            "details": { "contextRole": "notes" },
+            "timestamp": 4
+        });
+        let rows = message_edits(&[user.clone(), long, gone], &[user, short, note]);
+        assert_eq!(rows.len(), 3);
+        assert!(!rows[0].changed);
+        assert_eq!(rows[1].side(false), "a very long read");
+        assert_eq!(rows[1].side(true), "a short read");
+        assert_eq!(rows[2].role, "notes");
+        assert_eq!(rows[2].side(true), "plan");
+        assert_eq!(rows[2].side(false), "noise");
+    }
+}
