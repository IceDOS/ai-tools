Index: prime-agent-src/crates/pa-types/src/clm_view.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-types/src/clm_view.rs
@@ -0,0 +1,111 @@
+//! Wire shape of the `/clm` panel (`get_clm_view` reply).
+
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, PartialEq, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ClmView {
+    pub status: ClmStatus,
+    pub settings: Vec<ClmSetting>,
+    /// Revisions with an accepted edit, oldest first.
+    pub revisions: Vec<u64>,
+    /// The revision `edits` belongs to.
+    pub revision: Option<u64>,
+    pub edits: Vec<ClmEditMessage>,
+    /// Why `edits` is empty although `revision` is set.
+    pub note: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ClmStatus {
+    pub enabled: bool,
+    pub estimate: u64,
+    pub budget: Option<u64>,
+    pub observed: Option<u64>,
+    pub revision: u64,
+    pub edit_count: usize,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum ClmSettingKind {
+    Bool,
+    Choice,
+    Number,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ClmSetting {
+    pub key: String,
+    pub label: String,
+    pub value: String,
+    pub default: String,
+    pub kind: ClmSettingKind,
+    pub choices: Vec<String>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum ClmSegmentKind {
+    Same,
+    Del,
+    Add,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ClmSegment {
+    pub kind: ClmSegmentKind,
+    pub text: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ClmEditMessage {
+    pub role: String,
+    pub changed: bool,
+    pub segments: Vec<ClmSegment>,
+}
+
+impl ClmEditMessage {
+    /// Text before (`Del` and `Same`) or after (`Add` and `Same`) the edit.
+    #[must_use]
+    pub fn side(&self, after: bool) -> String {
+        let skip = if after { ClmSegmentKind::Del } else { ClmSegmentKind::Add };
+        self.segments
+            .iter()
+            .filter(|segment| segment.kind != skip)
+            .map(|segment| segment.text.as_str())
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn view_round_trips_in_camel_case() {
+        let view = ClmView {
+            status: ClmStatus { enabled: true, edit_count: 1, ..ClmStatus::default() },
+            revision: Some(1),
+            edits: vec![ClmEditMessage {
+                role: "user".into(),
+                changed: true,
+                segments: vec![
+                    ClmSegment { kind: ClmSegmentKind::Same, text: "a ".into() },
+                    ClmSegment { kind: ClmSegmentKind::Del, text: "b".into() },
+                    ClmSegment { kind: ClmSegmentKind::Add, text: "c".into() },
+                ],
+            }],
+            ..ClmView::default()
+        };
+        let value = serde_json::to_value(&view).unwrap();
+        assert_eq!(value["status"]["editCount"], 1);
+        assert_eq!(value["edits"][0]["segments"][1]["kind"], "del");
+        assert_eq!(serde_json::from_value::<ClmView>(value).unwrap(), view);
+        assert_eq!(view.edits[0].side(false), "a b");
+        assert_eq!(view.edits[0].side(true), "a c");
+    }
+}
