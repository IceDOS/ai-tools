+//! `/clm` control: per-session setting overrides, pause, reset and the panel view.
+
+use pa_types::clm_view::ClmSettingKind;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Map, Value};
+
+use crate::settings::ContextLanguageModelsSettings;
+
+pub const SETTINGS_CUSTOM_TYPE: &str = "clm-settings";
+pub const RESET_CUSTOM_TYPE: &str = "clm-reset";
+pub const CLM_NOT_ENABLED: &str = "Context Language Models are not enabled for this session. Set contextLanguageModels.enabled and start a new session.";
+
+pub struct SettingSpec {
+    pub key: &'static str,
+    pub label: &'static str,
+    pub kind: ClmSettingKind,
+    pub choices: &'static [&'static str],
+    /// Shown when neither Nix nor an override sets the key.
+    pub unset: &'static str,
+}
+
+const fn spec(key: &'static str, label: &'static str, kind: ClmSettingKind, choices: &'static [&'static str], unset: &'static str) -> SettingSpec {
+    SettingSpec { key, label, kind, choices, unset }
+}
+
+pub const SETTINGS: [SettingSpec; 9] = [
+    spec("budget", "Token budget", ClmSettingKind::Number, &[], "model window"),
+    spec("reserve", "Generation reserve", ClmSettingKind::Number, &[], "2048"),
+    spec("observationCap", "Tool result cap (chars)", ClmSettingKind::Number, &[], "off"),
+    spec("observationCapHead", "Cap head fraction", ClmSettingKind::Number, &[], "0.8"),
+    spec("estimateFactor", "Estimate factor", ClmSettingKind::Number, &[], "1"),
+    spec("overflow", "Overflow guard", ClmSettingKind::Choice, &["withhold", "off"], "withhold"),
+    spec("nativeCompaction", "Native compaction", ClmSettingKind::Choice, &["auto", "off", "on"], "auto"),
+    spec("oneToolPerTurn", "One tool per turn", ClmSettingKind::Bool, &["false", "true"], "false"),
+    spec("sizeTrailer", "Size trailer", ClmSettingKind::Bool, &["false", "true"], "false"),
+];
+
+#[derive(Debug, Clone, PartialEq, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Overrides {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub enabled: Option<bool>,
+    #[serde(default)]
+    pub values: Map<String, Value>,
+}
+
+fn keys() -> String {
+    SETTINGS.iter().map(|spec| spec.key).collect::<Vec<_>>().join(", ")
+}
+
+fn integer(key: &str, raw: &str, min: u64) -> Result<Value, String> {
+    match raw.parse::<u64>() {
+        Ok(value) if value >= min => Ok(json!(value)),
+        _ => Err(format!("{key} must be an integer of at least {min}")),
+    }
+}
+
+fn fraction(key: &str, raw: &str, min: f64, max: f64) -> Result<Value, String> {
+    match raw.parse::<f64>() {
+        Ok(value) if (min..=max).contains(&value) => Ok(json!(value)),
+        _ => Err(format!("{key} must be a number from {min} to {max}")),
+    }
+}
+
+/// One `/clm config <key> <value>` value, checked against the table above.
+///
+/// # Errors
+/// Returns an error if the key is unknown or the value fails validation.
+pub fn parse_value(key: &str, raw: &str) -> Result<Value, String> {
+    let spec = SETTINGS
+        .iter()
+        .find(|spec| spec.key == key)
+        .ok_or_else(|| format!("Unknown setting {key}. Settable: {}", keys()))?;
+    match (spec.kind, key, raw) {
+        (ClmSettingKind::Bool, _, "true" | "on") => Ok(json!(true)),
+        (ClmSettingKind::Bool, _, "false" | "off") => Ok(json!(false)),
+        (ClmSettingKind::Bool, _, _) => Err(format!("{key} must be true or false")),
+        (ClmSettingKind::Choice, _, _) if spec.choices.contains(&raw) => Ok(json!(raw)),
+        (ClmSettingKind::Choice, _, _) => Err(format!("{key} must be one of {}", spec.choices.join(", "))),
+        (_, "budget" | "observationCap", "unset") | (_, "observationCap", "0") => Ok(Value::Null),
+        (_, "budget", _) => integer(key, raw, 1024),
+        (_, "reserve", _) => integer(key, raw, 0),
+        (_, "observationCap", _) => integer(key, raw, 200),
+        (_, "observationCapHead", _) => fraction(key, raw, 0.1, 0.9),
+        _ => fraction(key, raw, 1.0, 4.0),
+    }
+}
+
+/// Nix-seeded settings with the session overrides on top.
+///
+/// # Errors
+/// Returns an error if merged values are invalid or reserve exceeds budget.
+pub fn merged(seed: &ContextLanguageModelsSettings, overrides: &Overrides) -> Result<ContextLanguageModelsSettings, String> {
+    let mut value = serde_json::to_value(seed).map_err(|error| error.to_string())?;
+    if let Some(map) = value.as_object_mut() {
+        for (key, override_value) in &overrides.values {
+            map.insert(key.clone(), override_value.clone());
+        }
+    }
+    let settings: ContextLanguageModelsSettings = serde_json::from_value(value).map_err(|error| error.to_string())?;
+    if let (Some(reserve), Some(budget)) = (settings.reserve, settings.budget) {
+        if reserve > budget {
+            return Err(format!("reserve ({reserve}) must not exceed budget ({budget})"));
+        }
+    }
+    Ok(settings)
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ClmAction {
+    On,
+    Off,
+    Reset,
+    Set { key: String, value: String },
+    ResetSettings,
+}
+
+impl ClmAction {
+    /// # Errors
+    /// Returns an error if the action or arguments are invalid.
+    pub fn parse(action: &str, key: Option<&str>, value: Option<&str>) -> Result<Self, String> {
+        match (action, key, value) {
+            ("on", ..) => Ok(Self::On),
+            ("off", ..) => Ok(Self::Off),
+            ("reset", ..) => Ok(Self::Reset),
+            ("reset_settings", ..) => Ok(Self::ResetSettings),
+            ("set", Some(key), Some(value)) => Ok(Self::Set { key: key.to_string(), value: value.to_string() }),
+            _ => Err(format!("unknown clm_configure action \"{action}\"")),
+        }
+    }
+}
+
+use pa_types::clm_view::{ClmEditMessage, ClmSetting, ClmStatus, ClmView};
+
+use super::document::digest_messages;
+use super::{edits, ClmRuntime};
+
+fn shown(value: &Value, unset: &str) -> String {
+    match value {
+        Value::Null => unset.to_string(),
+        Value::String(text) => text.clone(),
+        other => other.to_string(),
+    }
+}
+
+fn settings_rows(runtime: &ClmRuntime) -> Vec<ClmSetting> {
+    let seed = serde_json::to_value(&runtime.seed).unwrap_or_default();
+    SETTINGS
+        .iter()
+        .map(|spec| {
+            let default = seed.get(spec.key).cloned().unwrap_or(Value::Null);
+            let value = runtime.overrides.values.get(spec.key).cloned().unwrap_or_else(|| default.clone());
+            ClmSetting {
+                key: spec.key.to_string(),
+                label: spec.label.to_string(),
+                value: shown(&value, spec.unset),
+                default: shown(&default, spec.unset),
+                kind: spec.kind,
+                choices: spec.choices.iter().map(ToString::to_string).collect(),
+            }
+        })
+        .collect()
+}
+
+/// Edits of one revision against the context it was made from: the previous
+/// revision's projection plus the raw rows it did not cover.
+fn revision_edits(runtime: &ClmRuntime, index: usize) -> Result<Vec<ClmEditMessage>, String> {
+    let target = &runtime.history[index];
+    // Checkpoint counts and digests cover conversation rows only (harness digests excluded).
+    let raw = &super::projection::conversation_rows(&runtime.last_raw);
+    let matches = |count: usize, digest: &str| raw.len() >= count && digest_messages(&raw[..count]) == digest;
+    if !matches(target.source_message_count, &target.source_digest) {
+        return Err(format!("The source of revision {} is no longer in the live context.", target.revision));
+    }
+    let before: Vec<Value> = match index.checked_sub(1).map(|previous| &runtime.history[previous]) {
+        Some(previous)
+            if previous.source_message_count <= target.source_message_count
+                && matches(previous.source_message_count, &previous.source_digest) =>
+        {
+            previous
+                .projected_messages
+                .iter()
+                .chain(&raw[previous.source_message_count..target.source_message_count])
+                .cloned()
+                .collect()
+        }
+        _ => raw[..target.source_message_count].to_vec(),
+    };
+    Ok(edits::message_edits(&before, &target.projected_messages))
+}
+
+#[must_use]
+pub fn view(runtime: &ClmRuntime, revision: Option<u64>) -> ClmView {
+    let index = match revision {
+        Some(wanted) => runtime.history.iter().position(|checkpoint| checkpoint.revision == wanted),
+        None => runtime.history.len().checked_sub(1),
+    };
+    let (edits, note) = match index.map(|index| revision_edits(runtime, index)) {
+        Some(Ok(edits)) => (edits, None),
+        Some(Err(note)) => (Vec::new(), Some(note)),
+        None => (Vec::new(), None),
+    };
+    ClmView {
+        status: ClmStatus {
+            enabled: !runtime.paused,
+            estimate: runtime.last_estimate,
+            budget: runtime
+                .config
+                .budget
+                .resolve(runtime.last_context_window)
+                .map(|resolved| resolved.budget),
+            observed: runtime.last_observed,
+            revision: runtime.revision,
+            edit_count: runtime.history.len(),
+        },
+        settings: settings_rows(runtime),
+        revisions: runtime.history.iter().map(|checkpoint| checkpoint.revision).collect(),
+        revision: index.map(|index| runtime.history[index].revision),
+        edits,
+        note,
+    }
+}
+
+/// Apply `action`; returns the custom entry (type, data) the caller persists.
+///
+/// # Errors
+/// Returns an error if the setting value or merged configuration is invalid.
+pub fn configure(runtime: &mut ClmRuntime, action: &ClmAction) -> Result<(&'static str, Value), String> {
+    if *action == ClmAction::Reset {
+        runtime.reset_projection();
+        return Ok((RESET_CUSTOM_TYPE, json!({ "revision": runtime.revision })));
+    }
+    let mut next = runtime.overrides.clone();
+    match action {
+        ClmAction::On => next.enabled = Some(true),
+        ClmAction::Off => next.enabled = Some(false),
+        ClmAction::ResetSettings => next.values.clear(),
+        ClmAction::Set { key, value } => {
+            next.values.insert(key.clone(), parse_value(key, value)?);
+        }
+        ClmAction::Reset => unreachable!("handled above"),
+    }
+    runtime.apply_overrides(next.clone())?;
+    Ok((SETTINGS_CUSTOM_TYPE, serde_json::to_value(&next).map_err(|error| error.to_string())?))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn values_are_checked_against_the_table() {
+        assert_eq!(parse_value("budget", "64000"), Ok(json!(64000)));
+        assert_eq!(parse_value("budget", "unset"), Ok(Value::Null));
+        assert!(parse_value("budget", "100").is_err());
+        assert_eq!(parse_value("observationCap", "0"), Ok(Value::Null));
+        assert!(parse_value("observationCap", "50").is_err());
+        assert_eq!(parse_value("observationCapHead", "0.5"), Ok(json!(0.5)));
+        assert!(parse_value("observationCapHead", "0.95").is_err());
+        assert!(parse_value("estimateFactor", "5").is_err());
+        assert_eq!(parse_value("overflow", "off"), Ok(json!("off")));
+        assert!(parse_value("nativeCompaction", "maybe").is_err());
+        assert_eq!(parse_value("sizeTrailer", "on"), Ok(json!(true)));
+        assert!(parse_value("remindAt", "0.5").unwrap_err().starts_with("Unknown setting remindAt"));
+    }
+
+    #[test]
+    fn overrides_merge_over_the_seed_and_reserve_stays_under_budget() {
+        let seed: ContextLanguageModelsSettings =
+            serde_json::from_value(json!({ "enabled": true, "budget": 64000, "steering": "/x.md" })).unwrap();
+        let mut overrides = Overrides::default();
+        overrides.values.insert("budget".into(), json!(32000));
+        overrides.values.insert("sizeTrailer".into(), json!(true));
+        let settings = merged(&seed, &overrides).unwrap();
+        assert_eq!((settings.budget, settings.size_trailer), (Some(32000), Some(true)));
+        assert_eq!(settings.steering.as_deref(), Some("/x.md"));
+        overrides.values.insert("reserve".into(), json!(40000));
+        assert!(merged(&seed, &overrides).unwrap_err().contains("must not exceed budget"));
+        let stored = serde_json::to_value(&overrides).unwrap();
+        assert_eq!(serde_json::from_value::<Overrides>(stored).unwrap(), overrides);
+    }
+
+    #[test]
+    fn actions_parse() {
+        assert_eq!(ClmAction::parse("set", Some("budget"), Some("9000")), Ok(ClmAction::Set { key: "budget".into(), value: "9000".into() }));
+        assert!(ClmAction::parse("set", Some("budget"), None).is_err());
+        assert_eq!(ClmAction::parse("reset_settings", None, None), Ok(ClmAction::ResetSettings));
+    }
+
+    #[test]
+    fn view_lists_settings_and_diffs_the_chosen_revision() {
+        use crate::clm::{ClmConfig, ClmRuntime};
+        let seed: ContextLanguageModelsSettings = serde_json::from_value(json!({ "enabled": true, "budget": 64000 })).unwrap();
+        let mut runtime = ClmRuntime::new(ClmConfig::from_settings(&seed).unwrap(), "s").unwrap();
+        runtime.set_seed(seed);
+        let raw = vec![
+            json!({ "role": "user", "content": "fix the old bug", "timestamp": 1 }),
+            json!({ "role": "user", "content": "noise", "timestamp": 2 }),
+        ];
+        let empty = view(&runtime, None);
+        assert_eq!((empty.revision, empty.edits.len()), (None, 0));
+        assert_eq!(empty.settings.len(), 9);
+        assert_eq!(empty.settings[0].value, "64000");
+        assert_eq!(empty.settings[2].value, "off");
+
+        runtime.transform(&raw, 0, 100_000);
+        // Plain text is a valid edit: it becomes one notes message (see the mod.rs tests).
+        std::fs::write(runtime.mirror_path(), "task: fix the new bug").unwrap();
+        runtime.commit_turn().expect("accepted");
+        runtime.transform(&raw, 0, 100_000);
+
+        let one = view(&runtime, None);
+        assert_eq!((one.revision, one.revisions.clone()), (Some(1), vec![1]));
+        assert_eq!(one.status.edit_count, 1);
+        assert!(one.edits.iter().any(|row| row.changed && row.side(true).contains("fix the new bug")), "{one:?}");
+        assert!(one.edits.iter().any(|row| row.changed && row.side(false).contains("noise")), "{one:?}");
+        assert_eq!(view(&runtime, Some(9)).revision, None, "unknown revision");
+
+        let (kind, data) = configure(&mut runtime, &ClmAction::Set { key: "budget".into(), value: "32000".into() }).unwrap();
+        assert_eq!((kind, data["values"]["budget"].clone()), (SETTINGS_CUSTOM_TYPE, json!(32000)));
+        assert_eq!(view(&runtime, None).settings[0].value, "32000");
+        assert_eq!(view(&runtime, None).settings[0].default, "64000");
+        assert!(configure(&mut runtime, &ClmAction::Set { key: "budget".into(), value: "5".into() }).is_err());
+        let (kind, _) = configure(&mut runtime, &ClmAction::Off).unwrap();
+        assert_eq!(kind, SETTINGS_CUSTOM_TYPE);
+        assert!(!view(&runtime, None).status.enabled);
+        let (kind, data) = configure(&mut runtime, &ClmAction::ResetSettings).unwrap();
+        assert_eq!(data["enabled"], json!(false), "reset_settings keeps the on/off state");
+        assert_eq!(kind, SETTINGS_CUSTOM_TYPE);
+        let (kind, _) = configure(&mut runtime, &ClmAction::Reset).unwrap();
+        assert_eq!(kind, RESET_CUSTOM_TYPE);
+        assert!(view(&runtime, None).revisions.is_empty());
+    }
+}
+
