+//! `get_clm_view` and `clm_configure`: the `/clm` panel's daemon side.
+
+use serde_json::Value;
+
+use crate::protocol::{response_failure, response_success, DaemonResponse};
+use crate::worker::Worker;
+
+impl Worker {
+    pub(crate) async fn handle_get_clm_view(&self, payload: &Value) -> DaemonResponse {
+        if let Err(response) = self.require_created("get_clm_view") {
+            return response;
+        }
+        let Some(engine) = &self.agent_engine else {
+            return response_failure(
+                None,
+                "get_clm_view",
+                pa_types::daemon::KERNEL_NOT_RUNNING_MESSAGE,
+                None,
+            );
+        };
+        let revision = payload.get("revision").and_then(Value::as_u64);
+        match engine.clm_view(revision).await {
+            Ok(view) => response_success(None, "get_clm_view", Some(view)),
+            Err(error) => response_failure(None, "get_clm_view", &format!("{error:#}"), None),
+        }
+    }
+
+    pub(crate) async fn handle_clm_configure(&self, payload: &Value) -> DaemonResponse {
+        if let Err(response) = self.require_created("clm_configure") {
+            return response;
+        }
+        let Some(engine) = &self.agent_engine else {
+            return response_failure(
+                None,
+                "clm_configure",
+                pa_types::daemon::KERNEL_NOT_RUNNING_MESSAGE,
+                None,
+            );
+        };
+        let field = |name: &str| payload.get(name).and_then(Value::as_str);
+        let action = match pa_core::clm::control::ClmAction::parse(
+            field("action").unwrap_or(""),
+            field("key"),
+            field("value"),
+        ) {
+            Ok(action) => action,
+            Err(error) => return response_failure(None, "clm_configure", &error, None),
+        };
+        match engine.clm_configure(action).await {
+            Ok(view) => response_success(None, "clm_configure", Some(view)),
+            Err(error) => response_failure(None, "clm_configure", &format!("{error:#}"), None),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::path::PathBuf;
+
+    use serde_json::json;
+
+    use super::*;
+    use crate::worker::WorkerConfig;
+
+    #[tokio::test]
+    async fn clm_commands_refuse_when_disabled_and_reject_bogus_action() {
+        let _faux = crate::agent_engine::FAUX_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let dir = tempfile::tempdir().unwrap();
+        let config = WorkerConfig {
+            socket_path: dir.path().join("worker.sock"),
+            supervisor_socket_path: PathBuf::new(),
+            token: "test-token".into(),
+            worker_instance_id: String::new(),
+            active_session_id: "clm-test-session".into(),
+            agent_dir: dir.path().join("agent"),
+            recovery_journal_path: dir.path().join("recovery.jsonl"),
+            telemetry_disabled: Some(true),
+            script: Some(json!({
+                "engine": "faux",
+                "responses": [],
+            })),
+        };
+        let worker = Worker::new(config, None);
+        let created = worker
+            .dispatch(
+                "create",
+                &json!({ "noSession": true, "cwd": "/tmp", "name": "clm-test" }),
+            )
+            .await;
+        assert!(created.success, "create failed: {created:?}");
+
+        let model = worker
+            .agent_engine
+            .as_ref()
+            .expect("agent engine")
+            .resolve_model()
+            .expect("model");
+        worker
+            .agent_engine
+            .as_ref()
+            .unwrap()
+            .ensure_core_session_async(&model)
+            .await
+            .expect("session built");
+
+        let view = worker.dispatch("get_clm_view", &json!({})).await;
+        assert!(!view.success);
+        assert_eq!(
+            view.error.as_deref(),
+            Some(pa_core::clm::control::CLM_NOT_ENABLED)
+        );
+
+        let bad = worker
+            .dispatch("clm_configure", &json!({ "action": "bogus" }))
+            .await;
+        assert!(!bad.success);
+        assert_eq!(
+            bad.error.as_deref(),
+            Some("unknown clm_configure action \"bogus\"")
+        );
+    }
+}
