+use super::*;
+use crate::keybindings::KeybindingsManager;
+use crate::theme::{ColorMode, Theme};
+use pa_types::clm_view::{ClmEditMessage, ClmSegment, ClmSegmentKind, ClmSetting, ClmSettingKind, ClmStatus, ClmView};
+
+fn theme() -> Theme {
+    Theme::builtin("prime", ColorMode::TrueColor)
+}
+
+fn kb() -> KeybindingsManager {
+    KeybindingsManager::new()
+}
+
+fn text(panel: &ClmPanel, width: usize) -> String {
+    panel
+        .render(&theme(), width, &kb())
+        .iter()
+        .map(|line| line.iter().map(|span| span.content.as_str()).collect::<String>().trim_end().to_string())
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn seg(kind: ClmSegmentKind, text: &str) -> ClmSegment {
+    ClmSegment { kind, text: text.into() }
+}
+
+fn sample() -> ClmView {
+    ClmView {
+        status: ClmStatus { enabled: true, estimate: 12_000, budget: Some(64_000), observed: Some(11_500), revision: 2, edit_count: 2 },
+        settings: vec![
+            ClmSetting { key: "budget".into(), label: "Token budget".into(), value: "64000".into(), default: "64000".into(), kind: ClmSettingKind::Number, choices: vec![] },
+            ClmSetting { key: "overflow".into(), label: "Overflow guard".into(), value: "withhold".into(), default: "withhold".into(), kind: ClmSettingKind::Choice, choices: vec!["withhold".into(), "off".into()] },
+            ClmSetting { key: "sizeTrailer".into(), label: "Size trailer".into(), value: "false".into(), default: "false".into(), kind: ClmSettingKind::Bool, choices: vec!["false".into(), "true".into()] },
+        ],
+        revisions: vec![1, 2],
+        revision: Some(2),
+        edits: vec![
+            ClmEditMessage { role: "user".into(), changed: false, segments: vec![seg(ClmSegmentKind::Same, "fix the bug")] },
+            ClmEditMessage { role: "assistant".into(), changed: true, segments: vec![seg(ClmSegmentKind::Same, "read "), seg(ClmSegmentKind::Del, "all of a.py"), seg(ClmSegmentKind::Add, "a.py summary")] },
+        ],
+        note: None,
+    }
+}
+
+#[test]
+fn edits_tab_lists_messages_and_expands_a_side_by_side_diff() {
+    let mut panel = ClmPanel::new(sample(), ClmTab::Edits);
+    let rows = text(&panel, 120);
+    assert!(rows.contains("Revision 2 of 2"), "{rows}");
+    assert!(rows.contains("assistant") && rows.contains("changed"), "{rows}");
+    assert_eq!(panel.handle_key("down", &kb()), ClmPanelAction::None);
+    assert_eq!(panel.handle_key("enter", &kb()), ClmPanelAction::None);
+    let rows = text(&panel, 120);
+    let diff_row = rows.lines().find(|row| row.contains("all of a.py")).expect(&rows);
+    assert!(diff_row.contains("a.py summary"), "side by side at 120 columns: {rows}");
+    let narrow = text(&panel, 50);
+    let lines: Vec<_> = narrow.lines().collect();
+    let before = lines.iter().position(|row| row.contains("all of a.py")).expect(&narrow);
+    let after = lines.iter().rposition(|row| row.contains("a.py summary")).expect(&narrow);
+    assert!(after > before, "one column under 60: {narrow}");
+    assert!(narrow.lines().all(|row| unicode_width::UnicodeWidthStr::width(row) <= 50), "{narrow}");
+}
+
+#[test]
+fn arrows_switch_revisions_and_tabs_switch_pages() {
+    let mut panel = ClmPanel::new(sample(), ClmTab::Edits);
+    assert_eq!(panel.handle_key("left", &kb()), ClmPanelAction::LoadRevision(1));
+    assert_eq!(panel.handle_key("right", &kb()), ClmPanelAction::None, "already the newest");
+    assert_eq!(panel.handle_key("a", &kb()), ClmPanelAction::None);
+    assert!(text(&panel, 120).contains("a.py summary"));
+    assert_eq!(panel.handle_key("tab", &kb()), ClmPanelAction::None);
+    assert!(text(&panel, 120).contains("Overflow guard"));
+    assert_eq!(panel.handle_key("1", &kb()), ClmPanelAction::None);
+    assert!(text(&panel, 120).contains("Revision 2 of 2"));
+    assert_eq!(panel.handle_key("q", &kb()), ClmPanelAction::Close);
+    assert_eq!(panel.handle_key("escape", &kb()), ClmPanelAction::Close);
+}
+
+#[test]
+fn settings_enter_cycles_choices_and_bools_and_points_numbers_at_the_command() {
+    let mut panel = ClmPanel::new(sample(), ClmTab::Settings);
+    let rows = text(&panel, 120);
+    assert!(rows.contains("set with /clm config budget <value>"), "{rows}");
+    assert_eq!(panel.handle_key("enter", &kb()), ClmPanelAction::None, "number rows do not cycle");
+    panel.handle_key("down", &kb());
+    assert_eq!(panel.handle_key("enter", &kb()), ClmPanelAction::Set { key: "overflow".into(), value: "off".into() });
+    panel.handle_key("down", &kb());
+    assert_eq!(panel.handle_key("enter", &kb()), ClmPanelAction::Set { key: "sizeTrailer".into(), value: "true".into() });
+}
+
+#[test]
+fn empty_and_unavailable_states_say_so() {
+    let mut view = sample();
+    view.revisions.clear();
+    view.revision = None;
+    view.edits.clear();
+    assert!(text(&ClmPanel::new(view.clone(), ClmTab::Edits), 120).contains("No accepted edits in this session"));
+    view.revisions = vec![1];
+    view.revision = Some(1);
+    view.note = Some("The source of revision 1 is no longer in the live context.".into());
+    assert!(text(&ClmPanel::new(view, ClmTab::Edits), 120).contains("no longer in the live context"));
+}
