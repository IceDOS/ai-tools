+//! The `LIVE_CONTEXT.md` mirror: render the effective context as editable blocks,
+//! parse the model's edit and turn it back into messages (pi-clm
+//! `context-document.ts`, CLM editing mode only).
+
+use std::collections::{HashMap, HashSet};
+
+use serde_json::{json, Map, Value};
+use sha2::{Digest, Sha256};
+
+pub const DOCUMENT_VERSION: u64 = 1;
+pub const NOTE_CUSTOM_TYPE: &str = "live-context-projection";
+const EDIT_HINT: &str = "# Edit bodies or delete editable CTX_TURN blocks.";
+
+/// Keys sorted at every level, so the digest ignores map insertion order.
+fn normalize(value: &Value) -> Value {
+    match value {
+        Value::Array(items) => Value::Array(items.iter().map(normalize).collect()),
+        Value::Object(map) => {
+            let mut keys: Vec<&String> = map.keys().collect();
+            keys.sort();
+            let mut out = Map::new();
+            for key in keys {
+                out.insert(key.clone(), normalize(&map[key]));
+            }
+            Value::Object(out)
+        }
+        other => other.clone(),
+    }
+}
+
+#[must_use]
+pub fn canonical_message(message: &Value) -> String {
+    normalize(message).to_string()
+}
+
+#[must_use]
+pub fn digest_messages(messages: &[Value]) -> String {
+    let mut hash = Sha256::new();
+    for message in messages {
+        hash.update(canonical_message(message).as_bytes());
+        hash.update(b"\n");
+    }
+    to_hex(&hash.finalize())
+}
+
+fn to_hex(bytes: &[u8]) -> String {
+    use std::fmt::Write as _;
+    bytes
+        .iter()
+        .fold(String::with_capacity(bytes.len() * 2), |mut out, byte| {
+            let _ = write!(out, "{byte:02x}");
+            out
+        })
+}
+
+fn role(message: &Value) -> &str {
+    message.get("role").and_then(Value::as_str).unwrap_or("")
+}
+
+fn text_from_content(content: Option<&Value>) -> String {
+    match content {
+        Some(Value::String(text)) => text.clone(),
+        Some(Value::Array(parts)) => parts
+            .iter()
+            .map(|part| match part.get("type").and_then(Value::as_str) {
+                Some("text") => part["text"].as_str().unwrap_or("").to_string(),
+                Some("thinking") => {
+                    format!("[thinking]\n{}", part["thinking"].as_str().unwrap_or(""))
+                }
+                Some("toolCall") => format!(
+                    "[tool call: {}]\n{}",
+                    part["name"].as_str().unwrap_or("tool"),
+                    normalize(part.get("arguments").unwrap_or(&json!({})))
+                ),
+                Some("image") => format!(
+                    "[image: {}; data omitted]",
+                    part["mimeType"].as_str().unwrap_or("unknown")
+                ),
+                _ => normalize(part).to_string(),
+            })
+            .filter(|text| !text.is_empty())
+            .collect::<Vec<_>>()
+            .join("\n"),
+        _ => String::new(),
+    }
+}
+
+fn authored_role(message: &Value) -> Option<&str> {
+    (role(message) == "custom" && message["customType"] == NOTE_CUSTOM_TYPE)
+        .then(|| message["details"]["contextRole"].as_str())
+        .flatten()
+}
+
+#[must_use]
+pub fn render_message(message: &Value) -> String {
+    let mut content = text_from_content(message.get("content"));
+    if let Some(label) = authored_role(message) {
+        let prefix = format!("[context role={label}]\n");
+        if let Some(rest) = content.strip_prefix(&prefix) {
+            content = rest.to_string();
+        }
+    }
+    let mut parts = Vec::new();
+    if !content.is_empty() {
+        parts.push(content);
+    }
+    if matches!(role(message), "compactionSummary" | "branchSummary") {
+        if let Some(summary) = message["summary"].as_str() {
+            parts.push(summary.to_string());
+        }
+    }
+    parts.join("\n\n").trim().to_string()
+}
+
+/// Characters / 4, rounded up; the same base unit as `compaction::estimate_tokens`.
+#[must_use]
+pub fn estimate_tokens(messages: &[Value]) -> u64 {
+    messages
+        .iter()
+        .map(|message| (render_message(message).chars().count() as u64).div_ceil(4))
+        .sum()
+}
+
+#[must_use]
+pub fn estimate_text_tokens(text: &str) -> u64 {
+    (text.chars().count() as u64).div_ceil(4)
+}
+
+fn block_id(message: &Value, index: usize) -> String {
+    let digest = to_hex(&Sha256::digest(canonical_message(message).as_bytes()));
+    format!("{}-{}", index + 1, &digest[..12])
+}
+
+fn document_id(seed: &str, revision: u64) -> String {
+    to_hex(&Sha256::digest(
+        format!("pi-live-context:{DOCUMENT_VERSION}:{revision}:{seed}").as_bytes(),
+    ))
+}
+
+fn is_structural(rest: &str) -> bool {
+    rest.starts_with("[[CTX_TURN ") || rest.starts_with("[[LIVE_CONTEXT ")
+}
+
+/// A header quoted inside a body (say a `head` of the mirror) gains one leading backslash.
+#[must_use]
+pub fn escape_structural_lines(body: &str) -> String {
+    body.split('\n')
+        .map(|line| {
+            let rest = line.trim_start_matches('\\');
+            if is_structural(rest) {
+                format!("\\{line}")
+            } else {
+                line.to_string()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[must_use]
+pub fn unescape_structural_lines(body: &str) -> String {
+    body.split('\n')
+        .map(|line| {
+            let rest = line.trim_start_matches('\\');
+            if is_structural(rest) && line.len() > rest.len() {
+                line[1..].to_string()
+            } else {
+                line.to_string()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[derive(Debug, Clone)]
+pub struct DocumentBlock {
+    pub index: usize,
+    pub id: String,
+    pub role: String,
+    pub body: String,
+    pub source: Value,
+}
+
+#[derive(Debug, Clone)]
+pub struct Snapshot {
+    pub revision: u64,
+    pub baseline_digest: String,
+    pub document_id: String,
+    pub text: String,
+    pub messages: Vec<Value>,
+    pub blocks: Vec<DocumentBlock>,
+}
+
+/// CLM rendering: no protected blocks, nonce derived from `seed` and the revision
+/// so block ids read on one call stay valid until the next accepted edit.
+#[must_use]
+pub fn render_document(messages: &[Value], revision: u64, seed: &str) -> Snapshot {
+    let baseline_digest = digest_messages(messages);
+    let document_id = document_id(&format!("seed:{seed}"), revision);
+    let blocks: Vec<DocumentBlock> = messages
+        .iter()
+        .enumerate()
+        .map(|(index, source)| {
+            let role = match authored_role(source) {
+                Some(label) if is_role_label(label) => label.to_string(),
+                _ => role(source).to_string(),
+            };
+            DocumentBlock {
+                index,
+                id: block_id(source, index),
+                role,
+                body: escape_structural_lines(&render_message(source)),
+                source: source.clone(),
+            }
+        })
+        .collect();
+    let mut sections = vec![
+        format!(
+            "[[LIVE_CONTEXT version={DOCUMENT_VERSION} revision={revision} document={document_id} baseline={baseline_digest}]]"
+        ),
+        format!("{EDIT_HINT} Keep metadata/header lines intact."),
+    ];
+    for block in &blocks {
+        sections.push(format!(
+            "[[CTX_TURN document={document_id} index={} role={} id={} protected=false]]\n{}",
+            block.index + 1,
+            block.role,
+            block.id,
+            block.body
+        ));
+    }
+    Snapshot {
+        revision,
+        baseline_digest,
+        document_id,
+        text: sections.join("\n\n"),
+        messages: messages.to_vec(),
+        blocks,
+    }
+}
+
+fn is_role_label(label: &str) -> bool {
+    let mut chars = label.chars();
+    chars.next().is_some_and(|c| c.is_ascii_alphabetic())
+        && chars.all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-')
+}
+
+#[derive(Debug)]
+struct ParsedBlock {
+    id: String,
+    role: String,
+    body: String,
+}
+
+#[derive(Debug, Default)]
+struct ParsedDocument {
+    revision: Option<u64>,
+    document_id: Option<String>,
+    blocks: Vec<ParsedBlock>,
+    preamble: String,
+    duplicate_ids: Vec<String>,
+    malformed_headers: usize,
+}
+
+fn parse_meta(line: &str) -> Option<(u64, u64, String)> {
+    let inner = line.strip_prefix("[[LIVE_CONTEXT ")?.strip_suffix("]]")?;
+    let mut fields = HashMap::new();
+    for pair in inner.split(' ') {
+        let (key, value) = pair.split_once('=')?;
+        fields.insert(key, value);
+    }
+    Some((
+        fields.get("version")?.parse().ok()?,
+        fields.get("revision")?.parse().ok()?,
+        (*fields.get("document")?).to_string(),
+    ))
+}
+
+/// `(role, id)` for a well-formed header of the current document.
+fn parse_header(line: &str, document_id: &str) -> Option<(String, String)> {
+    let inner = line
+        .strip_prefix(&format!("[[CTX_TURN document={document_id} "))?
+        .strip_suffix("]]")?;
+    let fields: Vec<(&str, &str)> = inner
+        .split(' ')
+        .filter_map(|pair| pair.split_once('='))
+        .collect();
+    let get = |key: &str| {
+        fields
+            .iter()
+            .find(|(name, _)| *name == key)
+            .map(|(_, value)| *value)
+    };
+    let index_ok = get("index")?.parse::<usize>().is_ok();
+    let protected_ok = matches!(get("protected")?, "true" | "false");
+    let role = get("role").filter(|role| is_role_label(role))?;
+    let id = get("id")
+        .filter(|id| !id.is_empty() && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '-'))?;
+    (fields.len() == 4 && index_ok && protected_ok).then(|| (role.to_string(), id.to_string()))
+}
+
+fn parse_document(text: &str, document_id: &str) -> ParsedDocument {
+    let mut parsed = ParsedDocument::default();
+    let mut lines = text.lines().peekable();
+    if let Some((_, revision, id)) = lines.peek().and_then(|line| parse_meta(line.trim_end())) {
+        parsed.revision = Some(revision);
+        parsed.document_id = Some(id);
+        lines.next();
+    }
+    let header_prefix = format!("[[CTX_TURN document={document_id} ");
+    let mut seen = HashSet::new();
+    let mut current: Option<(String, String, Vec<&str>)> = None;
+    let mut preamble = Vec::new();
+    for line in lines {
+        let trimmed = line.trim();
+        if let Some((role, id)) = parse_header(trimmed, document_id) {
+            if let Some((role, id, body)) = current.take() {
+                parsed.blocks.push(ParsedBlock {
+                    id,
+                    role,
+                    body: body.join("\n").trim().to_string(),
+                });
+            }
+            if !seen.insert(id.clone()) {
+                parsed.duplicate_ids.push(id.clone());
+            }
+            current = Some((role, id, Vec::new()));
+            continue;
+        }
+        if trimmed.starts_with(&header_prefix) {
+            parsed.malformed_headers += 1;
+        }
+        match current.as_mut() {
+            Some((_, _, body)) => body.push(line),
+            None if !trimmed.starts_with(EDIT_HINT) => preamble.push(line),
+            None => {}
+        }
+    }
+    if let Some((role, id, body)) = current {
+        parsed.blocks.push(ParsedBlock {
+            id,
+            role,
+            body: body.join("\n").trim().to_string(),
+        });
+    }
+    parsed.preamble = preamble.join("\n").trim().to_string();
+    parsed
+}
+
+fn now_millis() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |elapsed| elapsed.as_millis() as u64)
+}
+
+/// A model-authored block: a custom row the loop converts to user-role text.
+#[must_use]
+pub fn context_note(body: &str, source: Option<&Value>, label: Option<&str>) -> Value {
+    let timestamp = source
+        .and_then(|source| source["timestamp"].as_u64())
+        .unwrap_or_else(now_millis);
+    let mut note = json!({
+        "role": "custom",
+        "customType": NOTE_CUSTOM_TYPE,
+        "content": match label {
+            Some(label) => format!("[context role={label}]\n{body}"),
+            None => body.to_string(),
+        },
+        "display": false,
+        "timestamp": timestamp,
+    });
+    if let Some(label) = label {
+        note["details"] = json!({ "contextRole": label });
+    }
+    note
+}
+
+fn changed_message(source: &Value, body: &str, requested_role: &str) -> Value {
+    match (role(source), requested_role) {
+        ("assistant", "assistant") => {
+            let mut changed = source.clone();
+            changed["content"] = json!([{ "type": "text", "text": body }]);
+            changed["stopReason"] = json!("stop");
+            if let Some(map) = changed.as_object_mut() {
+                map.remove("errorMessage");
+            }
+            changed
+        }
+        ("user", "user") => {
+            let mut changed = source.clone();
+            changed["content"] = if source["content"].is_array() {
+                json!([{ "type": "text", "text": body }])
+            } else {
+                json!(body)
+            };
+            changed
+        }
+        _ => context_note(body, Some(source), Some(requested_role)),
+    }
+}
+
+fn tool_call_ids(message: &Value) -> HashSet<String> {
+    message["content"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|part| part["type"] == "toolCall")
+        .filter_map(|part| part["id"].as_str().map(str::to_string))
+        .collect()
+}
+
+/// Turn any assistant call without all its results, and any result without its
+/// call, into a note: providers reject orphaned tool rows.
+#[must_use]
+pub fn repair_tool_groups(messages: Vec<Value>) -> Vec<Value> {
+    let mut repaired = messages;
+    for index in 0..repaired.len() {
+        if role(&repaired[index]) != "assistant" {
+            continue;
+        }
+        let ids = tool_call_ids(&repaired[index]);
+        if ids.is_empty() {
+            continue;
+        }
+        let mut found = HashSet::new();
+        for next in &repaired[index + 1..] {
+            if role(next) != "toolResult" {
+                break;
+            }
+            if let Some(id) = next["toolCallId"].as_str().filter(|id| ids.contains(*id)) {
+                found.insert(id.to_string());
+            }
+        }
+        if found.len() < ids.len() {
+            let source = repaired[index].clone();
+            repaired[index] = context_note(&render_message(&source), Some(&source), None);
+        }
+    }
+    for index in 0..repaired.len() {
+        if role(&repaired[index]) != "toolResult" {
+            continue;
+        }
+        let owner = repaired[..index]
+            .iter()
+            .rev()
+            .find(|message| role(message) != "toolResult");
+        let ids = owner
+            .filter(|owner| role(owner) == "assistant")
+            .map(tool_call_ids)
+            .unwrap_or_default();
+        let matched = repaired[index]["toolCallId"]
+            .as_str()
+            .is_some_and(|id| ids.contains(id));
+        if !matched {
+            let source = repaired[index].clone();
+            repaired[index] = context_note(&render_message(&source), Some(&source), None);
+        }
+    }
+    repaired
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum ApplyOutcome {
+    Unchanged,
+    Accepted {
+        messages: Vec<Value>,
+        before_tokens: u64,
+        after_tokens: u64,
+        diagnostics: Vec<String>,
+    },
+    Rejected(String),
+}
+
+/// Apply the model's edited mirror against the snapshot it was rendered from.
+#[must_use]
+pub fn apply_document(edited: &str, snapshot: &Snapshot) -> ApplyOutcome {
+    if edited.trim() == snapshot.text.trim() {
+        return ApplyOutcome::Unchanged;
+    }
+    let before_tokens = estimate_tokens(&snapshot.messages);
+    let finalize = |candidate: Vec<Value>, diagnostics: Vec<String>| {
+        let messages = repair_tool_groups(candidate);
+        ApplyOutcome::Accepted {
+            after_tokens: estimate_tokens(&messages),
+            messages,
+            before_tokens,
+            diagnostics,
+        }
+    };
+    let parsed = parse_document(edited, &snapshot.document_id);
+    // No current headers at all: the model collapsed its context to free text.
+    if parsed.blocks.is_empty() {
+        let body: Vec<&str> = edited
+            .lines()
+            .filter(|line| {
+                parse_meta(line.trim_end()).is_none() && !line.trim().starts_with(EDIT_HINT)
+            })
+            .collect();
+        let body = unescape_structural_lines(body.join("\n").trim());
+        if body.is_empty() {
+            return ApplyOutcome::Rejected(
+                "Mirror is empty after removing metadata; nothing to apply.".into(),
+            );
+        }
+        let mut candidate: Vec<Value> = snapshot
+            .messages
+            .iter()
+            .find(|message| role(message) == "user")
+            .cloned()
+            .into_iter()
+            .collect();
+        candidate.push(context_note(&body, None, Some("notes")));
+        return finalize(
+            candidate,
+            vec!["Accepted a headerless rewrite: every block was replaced by one notes block after the first user turn.".into()],
+        );
+    }
+    if parsed.revision != Some(snapshot.revision)
+        || parsed.document_id.as_deref() != Some(&snapshot.document_id)
+    {
+        let first = snapshot.text.lines().next().unwrap_or_default();
+        return ApplyOutcome::Rejected(format!(
+            "Mirror metadata does not match the current context revision (expected revision {}). The first line must be exactly: {first}",
+            snapshot.revision
+        ));
+    }
+    if !parsed.duplicate_ids.is_empty() {
+        return ApplyOutcome::Rejected(format!(
+            "Mirror contains duplicate block IDs: {}.",
+            parsed.duplicate_ids.join(", ")
+        ));
+    }
+    if parsed.malformed_headers > 0 {
+        return ApplyOutcome::Rejected(
+            "Mirror contains malformed headers for the current document.".into(),
+        );
+    }
+    let source_by_id: HashMap<&str, &DocumentBlock> = snapshot
+        .blocks
+        .iter()
+        .map(|block| (block.id.as_str(), block))
+        .collect();
+    let unknown: Vec<&str> = parsed
+        .blocks
+        .iter()
+        .map(|block| block.id.as_str())
+        .filter(|id| !source_by_id.contains_key(id) && !id.starts_with("new-"))
+        .collect();
+    if !unknown.is_empty() {
+        return ApplyOutcome::Rejected(format!(
+            "Mirror contains unknown block IDs: {}. Use ids from the current mirror headers, or prefix a new block's id with new-.",
+            unknown.join(", ")
+        ));
+    }
+    let mut candidate = Vec::new();
+    if !parsed.preamble.is_empty() {
+        candidate.push(context_note(
+            &unescape_structural_lines(&parsed.preamble),
+            None,
+            None,
+        ));
+    }
+    // CLM follows the edited order; blocks missing from the edit are removed.
+    for block in &parsed.blocks {
+        let body = unescape_structural_lines(&block.body);
+        match source_by_id.get(block.id.as_str()) {
+            None if !block.body.is_empty() => {
+                candidate.push(context_note(&body, None, Some(&block.role)));
+            }
+            None => {}
+            Some(_) if block.body.is_empty() => {}
+            Some(source) if block.body == source.body && block.role == source.role => {
+                candidate.push(source.source.clone());
+            }
+            Some(source) => candidate.push(changed_message(&source.source, &body, &block.role)),
+        }
+    }
+    finalize(candidate, Vec::new())
+}
