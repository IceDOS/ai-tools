+//! Observation cap and overflow guard (pi-clm `observation.ts`, `overflow.ts`).
+//! Both act on the effective context only; raw history is never touched.
+
+use std::path::{Path, PathBuf};
+
+use serde_json::{json, Value};
+
+pub const MIN_OBSERVATION_CAP: usize = 200;
+/// Keeps the request inside the window the output clamp leaves room for.
+pub const WINDOW_SAFETY_MARGIN: u64 = 4096;
+const WITHHELD_PREFIX: &str = "[pi-clm overflow guard]";
+
+fn text_parts(message: &Value) -> (String, Vec<Value>) {
+    match &message["content"] {
+        Value::String(text) => (text.clone(), Vec::new()),
+        Value::Array(parts) => {
+            let text = parts
+                .iter()
+                .filter(|part| part["type"] == "text")
+                .filter_map(|part| part["text"].as_str())
+                .collect::<String>();
+            let other = parts
+                .iter()
+                .filter(|part| part["type"] != "text")
+                .cloned()
+                .collect();
+            (text, other)
+        }
+        _ => (String::new(), Vec::new()),
+    }
+}
+
+fn thousands(value: usize) -> String {
+    let digits = value.to_string();
+    let mut out = String::new();
+    for (index, digit) in digits.chars().enumerate() {
+        if index > 0 && (digits.len() - index).is_multiple_of(3) {
+            out.push(',');
+        }
+        out.push(digit);
+    }
+    out
+}
+
+/// Keep `max_chars` of a tool result: `head_fraction` from the start, the rest from the end.
+#[must_use]
+pub fn cap_tool_result(message: &Value, max_chars: usize, head_fraction: f64) -> Option<Value> {
+    if message["role"] != "toolResult" {
+        return None;
+    }
+    let (text, other) = text_parts(message);
+    let chars: Vec<char> = text.chars().collect();
+    let total = chars.len();
+    if total <= max_chars {
+        return None;
+    }
+    let head_budget = (max_chars as f64 * head_fraction).floor() as usize;
+    let tail_budget = max_chars - head_budget;
+    let head: String = chars[..head_budget].iter().collect();
+    let cut = if tail_budget > 0 {
+        let tail: String = chars[total - tail_budget..].iter().collect();
+        format!(
+            "{head}\n…[{} characters omitted]…\n{tail}",
+            thousands(total - head_budget - tail_budget)
+        )
+    } else {
+        head
+    };
+    let capped = format!(
+        "{cut}\n\n[pi-clm observation cap: {} of {} characters shown. The complete output remains in the session history; re-read the source with offset/limit if you need the rest.]",
+        thousands(head_budget + tail_budget),
+        thousands(total)
+    );
+    let mut content = vec![json!({ "type": "text", "text": capped })];
+    content.extend(other);
+    let mut out = message.clone();
+    out["content"] = Value::Array(content);
+    Some(out)
+}
+
+pub fn cap_observations(messages: &mut [Value], max_chars: usize, head_fraction: f64) {
+    for message in messages.iter_mut() {
+        if let Some(capped) = cap_tool_result(message, max_chars, head_fraction) {
+            *message = capped;
+        }
+    }
+}
+
+#[must_use]
+pub fn overflow_guard_limit(budget: u64, reserve: u64, context_window: u64) -> u64 {
+    let from_budget = budget.saturating_sub(reserve);
+    if context_window == 0 {
+        return from_budget;
+    }
+    from_budget.min(context_window.saturating_sub(WINDOW_SAFETY_MARGIN + reserve))
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Withheld {
+    pub tool_call_id: String,
+    pub tool_name: String,
+    pub tokens: u64,
+    pub file: Option<PathBuf>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct GuardResult {
+    pub withheld: Vec<Withheld>,
+    pub estimated: u64,
+}
+
+fn safe_id(id: &str) -> String {
+    id.chars()
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || c == '_' || c == '-' {
+                c
+            } else {
+                '_'
+            }
+        })
+        .collect()
+}
+
+fn save_withheld(directory: &Path, id: &str, text: &str) -> Option<PathBuf> {
+    let file = directory.join(format!("{}.txt", safe_id(id)));
+    if file.exists() {
+        return Some(file);
+    }
+    std::fs::create_dir_all(directory).ok()?;
+    std::fs::write(&file, text).ok()?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let _ = std::fs::set_permissions(&file, std::fs::Permissions::from_mode(0o600));
+    }
+    Some(file)
+}
+
+/// Withhold tool results at or after `protect_before`, oldest first, until
+/// `fixed_tokens + estimate(messages) <= limit` or nothing is left to withhold.
+pub fn apply_overflow_guard(
+    messages: &mut [Value],
+    limit: u64,
+    fixed_tokens: u64,
+    estimate: &dyn Fn(&[Value]) -> u64,
+    save_directory: Option<&Path>,
+    protect_before: usize,
+) -> GuardResult {
+    let mut estimated = fixed_tokens + estimate(messages);
+    let mut withheld = Vec::new();
+    if estimated <= limit {
+        return GuardResult {
+            withheld,
+            estimated,
+        };
+    }
+    for index in protect_before..messages.len() {
+        if messages[index]["role"] != "toolResult" {
+            continue;
+        }
+        let (text, _) = text_parts(&messages[index]);
+        if text.starts_with(WITHHELD_PREFIX) {
+            continue;
+        }
+        let tokens = estimate(std::slice::from_ref(&messages[index]));
+        let tool_call_id = messages[index]["toolCallId"]
+            .as_str()
+            .unwrap_or("unknown")
+            .to_string();
+        let tool_name = messages[index]["toolName"]
+            .as_str()
+            .unwrap_or("tool")
+            .to_string();
+        let file =
+            save_directory.and_then(|directory| save_withheld(directory, &tool_call_id, &text));
+        let location = match &file {
+            Some(path) => format!(" Full text: {}", path.display()),
+            None => " Full text remains in the session history.".to_string(),
+        };
+        messages[index]["content"] = json!([{
+            "type": "text",
+            "text": format!("{WITHHELD_PREFIX} {tool_name}#{tool_call_id} (~{} tok) withheld over budget.{location}", thousands(tokens as usize)),
+        }]);
+        withheld.push(Withheld {
+            tool_call_id,
+            tool_name,
+            tokens,
+            file,
+        });
+        estimated = fixed_tokens + estimate(messages);
+        if estimated <= limit {
+            break;
+        }
+    }
+    GuardResult {
+        withheld,
+        estimated,
+    }
+}
+
+#[must_use]
+pub fn overflow_notice_text(result: &GuardResult, limit: u64) -> String {
+    let count = result.withheld.len();
+    let list: Vec<String> = result
+        .withheld
+        .iter()
+        .map(|record| {
+            format!(
+                "{}#{} (~{} tok)",
+                record.tool_name,
+                record.tool_call_id,
+                thousands(record.tokens as usize)
+            )
+        })
+        .collect();
+    let with_files = if result.withheld.iter().any(|record| record.file.is_some()) {
+        " with file paths"
+    } else {
+        ""
+    };
+    let still_over = if result.estimated <= limit {
+        ""
+    } else {
+        " and still over the limit; edit your context now"
+    };
+    format!(
+        "[CLM BUDGET] Overflow guard: the request would have exceeded the limit of {} tokens, so {count} tool result{} {} withheld from your context and replaced by notes{with_files}: {}. Estimated request is now {} tokens{still_over}. Nothing was re-run; the full outputs are in the files named in the notes and in the session history. Free space in your context and re-read only what you need.",
+        thousands(limit as usize),
+        if count == 1 { "" } else { "s" },
+        if count == 1 { "was" } else { "were" },
+        list.join(", "),
+        thousands(result.estimated as usize),
+    )
+}
