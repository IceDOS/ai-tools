+    #[test]
+    fn cap_keeps_head_and_tail_with_a_marker() {
+        let mut message = tool_result("c1", 1000);
+        message["content"][0]["text"] = json!(format!("{}{}", "h".repeat(500), "t".repeat(500)));
+        let capped = cap_tool_result(&message, 200, 0.8).unwrap();
+        let text = capped["content"][0]["text"].as_str().unwrap();
+        assert!(text.starts_with(&"h".repeat(160)));
+        assert!(text.contains(&format!(
+            "{}\n\n[pi-clm observation cap: 200 of 1,000",
+            "t".repeat(40)
+        )));
+        assert!(cap_tool_result(&tool_result("c2", 100), 200, 0.8).is_none());
+    }
+
+    #[test]
+    fn guard_limit_takes_the_tighter_ceiling() {
+        assert_eq!(overflow_guard_limit(100_000, 2048, 0), 97_952);
+        assert_eq!(
+            overflow_guard_limit(100_000, 2048, 50_000),
+            50_000 - 4096 - 2048
+        );
+    }
+
+    #[test]
+    fn guard_withholds_oldest_unprotected_results_and_saves_them() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut messages = vec![
+            tool_result("old", 4000),
+            tool_result("a/b", 4000),
+            tool_result("new", 4000),
+        ];
+        let result = apply_overflow_guard(
+            &mut messages,
+            2200,
+            0,
+            &|m| estimate_tokens(m),
+            Some(dir.path()),
+            1,
+        );
+        assert_eq!(
+            result.withheld.len(),
+            1,
+            "one withheld result brings it under"
+        );
+        assert_eq!(result.withheld[0].tool_call_id, "a/b");
+        assert_eq!(
+            messages[0]["content"][0]["text"].as_str().unwrap().len(),
+            4000,
+            "protected prefix kept"
+        );
+        let saved = result.withheld[0].file.clone().unwrap();
+        assert!(saved.ends_with("a_b.txt"));
+        assert_eq!(std::fs::read_to_string(saved).unwrap().len(), 4000);
+        assert!(overflow_notice_text(&result, 2200).contains("1 tool result was withheld"));
+    }
