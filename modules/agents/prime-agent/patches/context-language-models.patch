+//! Budget reminders and estimate calibration (pi-clm `budget.ts`).
+
+use std::collections::HashSet;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct BudgetPolicy {
+    /// Tokens; `None` falls back to the model window.
+    pub context_budget: Option<u64>,
+    pub reserve: u64,
+    /// Ascending fractions in (0, 1).
+    pub remind_at: Vec<f64>,
+    pub remind_at_reserve: bool,
+}
+
+impl Default for BudgetPolicy {
+    fn default() -> Self {
+        Self {
+            context_budget: None,
+            reserve: 2048,
+            remind_at: vec![0.5, 0.75, 0.9],
+            remind_at_reserve: true,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ResolvedBudget {
+    pub budget: u64,
+    pub reserve: u64,
+    pub from_config: bool,
+}
+
+impl BudgetPolicy {
+    #[must_use]
+    pub fn resolve(&self, context_window: u64) -> Option<ResolvedBudget> {
+        match self.context_budget {
+            Some(budget) if budget > 0 => Some(ResolvedBudget {
+                budget,
+                reserve: self.reserve.min(budget),
+                from_config: true,
+            }),
+            _ if context_window > 0 => Some(ResolvedBudget {
+                budget: context_window,
+                reserve: self.reserve.min(context_window),
+                from_config: false,
+            }),
+            _ => None,
+        }
+    }
+
+    /// Ascending tiers; tiers at the same token count keep the more urgent label.
+    #[must_use]
+    pub fn tiers(&self, resolved: ResolvedBudget) -> Vec<BudgetTier> {
+        let mut tiers: Vec<BudgetTier> = self
+            .remind_at
+            .iter()
+            .map(|fraction| BudgetTier {
+                label: format!("{}%", (fraction * 100.0).round() as u64),
+                tokens: (resolved.budget as f64 * fraction).floor() as u64,
+            })
+            .collect();
+        if self.remind_at_reserve && resolved.reserve > 0 && resolved.budget > resolved.reserve {
+            tiers.push(BudgetTier {
+                label: RESERVE_TIER.into(),
+                tokens: resolved.budget - resolved.reserve,
+            });
+        }
+        tiers.sort_by_key(|tier| tier.tokens);
+        let mut kept: Vec<BudgetTier> = Vec::new();
+        for tier in tiers {
+            match kept.last_mut() {
+                Some(last) if last.tokens == tier.tokens => *last = tier,
+                _ => kept.push(tier),
+            }
+        }
+        kept
+    }
+}
+
+pub const RESERVE_TIER: &str = "budget-reserve";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BudgetTier {
+    pub label: String,
+    pub tokens: u64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct BudgetReading {
+    pub budget: ResolvedBudget,
+    /// Calibrated estimate of the next request.
+    pub estimated: u64,
+    /// Provider-reported size of the previous request.
+    pub observed: Option<u64>,
+    /// An accepted edit landed after `observed` was measured.
+    pub observed_stale: bool,
+    pub calibration: f64,
+}
+
+impl BudgetReading {
+    /// The larger measurement governs, unless the observation predates an edit.
+    #[must_use]
+    pub fn governing(&self) -> u64 {
+        if self.observed_stale {
+            self.estimated
+        } else {
+            self.estimated.max(self.observed.unwrap_or(0))
+        }
+    }
+}
+
+/// Fires each tier once; a tier re-arms when usage drops back below it.
+#[derive(Debug, Default)]
+pub struct BudgetTracker {
+    fired: HashSet<String>,
+    tier_key: String,
+}
+
+impl BudgetTracker {
+    pub fn reset(&mut self) {
+        self.fired.clear();
+    }
+
+    pub fn observe(&mut self, governing: u64, tiers: &[BudgetTier]) -> Option<BudgetTier> {
+        let key: Vec<String> = tiers
+            .iter()
+            .map(|tier| format!("{}:{}", tier.label, tier.tokens))
+            .collect();
+        let key = key.join("|");
+        if key != self.tier_key {
+            self.tier_key = key;
+            self.fired.clear();
+        }
+        self.fired.retain(|label| {
+            tiers
+                .iter()
+                .any(|tier| &tier.label == label && governing >= tier.tokens)
+        });
+        let top = tiers
+            .iter()
+            .rfind(|tier| governing >= tier.tokens && !self.fired.contains(&tier.label))?
+            .clone();
+        for tier in tiers.iter().filter(|tier| tier.tokens <= top.tokens) {
+            self.fired.insert(tier.label.clone());
+        }
+        Some(top)
+    }
+}
+
+fn thousands(value: u64) -> String {
+    let digits = value.to_string();
+    let mut out = String::new();
+    for (index, digit) in digits.chars().enumerate() {
+        if index > 0 && (digits.len() - index).is_multiple_of(3) {
+            out.push(',');
+        }
+        out.push(digit);
+    }
+    out
+}
+
+/// The model-facing reminder. States both measurements and the budget.
+#[must_use]
+pub fn budget_notice_text(reading: &BudgetReading, tier: &BudgetTier, mirror_path: &str) -> String {
+    let governing = reading.governing();
+    let budget = reading.budget.budget;
+    let remaining = budget.saturating_sub(governing);
+    let calibrated = if reading.calibration > 1.005 {
+        format!(
+            " (calibrated x{:.2} from provider counts)",
+            reading.calibration
+        )
+    } else {
+        String::new()
+    };
+    let measurement = match reading.observed {
+        None => format!(
+            "estimated {} tokens for the next request{calibrated}, excluding tool schemas and provider framing; provider-reported size of the previous request unknown",
+            thousands(reading.estimated)
+        ),
+        Some(observed) => format!(
+            "estimated {} tokens for the next request{calibrated}, excluding tool schemas and provider framing; the provider reported {} for the previous one{}",
+            thousands(reading.estimated),
+            thousands(observed),
+            if reading.observed_stale { ", before your last accepted edit" } else { "" }
+        ),
+    };
+    if tier.label == RESERVE_TIER {
+        return format!(
+            "[CLM BUDGET] Context is at {} of a {}-token budget ({measurement}). Only {} tokens remain, which is inside the {}-token generation reserve. Edit {mirror_path} now to free space. The budget is a target, not enforced: the request will still be sent and may overflow the provider's actual window.",
+            thousands(governing),
+            thousands(budget),
+            thousands(remaining),
+            thousands(reading.budget.reserve)
+        );
+    }
+    format!(
+        "[CLM BUDGET] Context crossed {} of a {}-token budget: {measurement}. {} tokens remain. You may reorganize {mirror_path} at any time; the final reminder comes at {} tokens.",
+        tier.label,
+        thousands(budget),
+        thousands(remaining),
+        thousands(budget - reading.budget.reserve)
+    )
+}
+
+/// Scales the chars/4 estimate by the provider's own counts. EMA, clamped to [1, 4].
+#[derive(Debug, Clone)]
+pub struct EstimateCalibrator {
+    initial: f64,
+    current: f64,
+    samples: u32,
+    pending: Option<(u64, usize)>,
+}
+
+const CALIBRATION_MIN: f64 = 1.0;
+const CALIBRATION_MAX: f64 = 4.0;
+const CALIBRATION_SMOOTHING: f64 = 0.5;
+
+impl EstimateCalibrator {
+    #[must_use]
+    pub fn new(initial: Option<f64>) -> Self {
+        let initial = initial
+            .unwrap_or(1.0)
+            .clamp(CALIBRATION_MIN, CALIBRATION_MAX);
+        Self {
+            initial,
+            current: initial,
+            samples: 0,
+            pending: None,
+        }
+    }
+
+    #[must_use]
+    pub fn factor(&self) -> f64 {
+        self.current
+    }
+
+    pub fn reset(&mut self) {
+        *self = Self::new(Some(self.initial));
+    }
+
+    /// The raw estimate of the request about to go out, and the raw transcript length.
+    pub fn record(&mut self, estimate: u64, raw_count: usize) {
+        if estimate > 0 {
+            self.pending = Some((estimate, raw_count));
+        }
+    }
+
+    /// Only an assistant row appended after the recorded request measures it.
+    pub fn observe(&mut self, observed: Option<(u64, usize)>) -> f64 {
+        let (Some((tokens, index)), Some((estimate, raw_count))) = (observed, self.pending) else {
+            return self.current;
+        };
+        if index < raw_count {
+            return self.current;
+        }
+        self.pending = None;
+        let sample = tokens as f64 / estimate as f64;
+        if !sample.is_finite() || sample <= 0.0 {
+            return self.current;
+        }
+        let next = if self.samples == 0 {
+            sample
+        } else {
+            self.current * (1.0 - CALIBRATION_SMOOTHING) + sample * CALIBRATION_SMOOTHING
+        };
+        self.current = next.clamp(CALIBRATION_MIN, CALIBRATION_MAX);
+        self.samples += 1;
+        self.current
+    }
+
+    #[must_use]
+    pub fn apply(&self, estimate: u64) -> u64 {
+        (estimate as f64 * self.current).ceil() as u64
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn resolved(budget: u64, reserve: u64) -> ResolvedBudget {
+        ResolvedBudget {
+            budget,
+            reserve,
+            from_config: true,
+        }
+    }
+
+    #[test]
+    fn tiers_cover_fractions_and_the_reserve() {
+        let tiers = BudgetPolicy::default().tiers(resolved(100_000, 2048));
+        let tokens: Vec<u64> = tiers.iter().map(|tier| tier.tokens).collect();
+        assert_eq!(tokens, vec![50_000, 75_000, 90_000, 97_952]);
+        assert_eq!(tiers.last().unwrap().label, RESERVE_TIER);
+    }
+
+    #[test]
+    fn resolve_prefers_config_and_caps_the_reserve() {
+        let policy = BudgetPolicy {
+            context_budget: Some(1000),
+            ..BudgetPolicy::default()
+        };
+        assert_eq!(policy.resolve(200_000), Some(resolved(1000, 1000)));
+        assert_eq!(BudgetPolicy::default().resolve(0), None);
+        assert!(!BudgetPolicy::default().resolve(8000).unwrap().from_config);
+    }
+
+    #[test]
+    fn tracker_fires_the_top_tier_once_and_rearms_after_a_drop() {
+        let tiers = BudgetPolicy::default().tiers(resolved(100_000, 2048));
+        let mut tracker = BudgetTracker::default();
+        assert_eq!(tracker.observe(80_000, &tiers).unwrap().label, "75%");
+        assert!(tracker.observe(80_000, &tiers).is_none());
+        assert!(tracker.observe(40_000, &tiers).is_none());
+        assert_eq!(tracker.observe(55_000, &tiers).unwrap().label, "50%");
+    }
+
+    #[test]
+    fn stale_observation_never_governs() {
+        let mut reading = BudgetReading {
+            budget: resolved(100, 0),
+            estimated: 10,
+            observed: Some(90),
+            observed_stale: false,
+            calibration: 1.0,
+        };
+        assert_eq!(reading.governing(), 90);
+        reading.observed_stale = true;
+        assert_eq!(reading.governing(), 10);
+    }
+
+    #[test]
+    fn calibrator_learns_from_later_rows_only_and_clamps() {
+        let mut calibrator = EstimateCalibrator::new(None);
+        calibrator.record(1000, 5);
+        assert_eq!(
+            calibrator.observe(Some((2000, 4))),
+            1.0,
+            "an older row measures nothing"
+        );
+        assert_eq!(calibrator.observe(Some((2000, 5))), 2.0);
+        calibrator.record(1000, 7);
+        assert_eq!(calibrator.observe(Some((9000, 8))), 4.0, "clamped at 4");
+        assert_eq!(calibrator.apply(10), 40);
+        calibrator.reset();
+        assert_eq!(calibrator.factor(), 1.0);
+    }
+
+    #[test]
+    fn notice_names_both_measurements() {
+        let reading = BudgetReading {
+            budget: resolved(32_000, 2048),
+            estimated: 30_500,
+            observed: Some(29_000),
+            observed_stale: false,
+            calibration: 1.0,
+        };
+        let tier = BudgetTier {
+            label: RESERVE_TIER.into(),
+            tokens: 29_952,
+        };
+        let text = budget_notice_text(&reading, &tier, "/tmp/m/LIVE_CONTEXT.md");
+        assert!(text.contains("30,500 of a 32,000-token budget"));
+        assert!(text.contains("reported 29,000"));
+        assert!(text.contains("Only 1,500 tokens remain"));
+    }
+}
