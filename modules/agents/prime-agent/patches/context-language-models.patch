+++ prime-agent-src/crates/pa-core/src/clm/projection.rs
@@ -0,0 +1,168 @@
+//! Projection checkpoints (pi-clm `projection.ts`): an accepted edit replaces a
+//! digest-checked raw prefix, and raw messages after it pass through.
+
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+use super::document::digest_messages;
+
+pub const CHECKPOINT_CUSTOM_TYPE: &str = "clm-state";
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Checkpoint {
+    pub version: u32,
+    pub revision: u64,
+    pub source_message_count: usize,
+    pub source_digest: String,
+    pub projected_messages: Vec<Value>,
+    pub before_estimate: u64,
+    pub after_estimate: u64,
+}
+
+impl Checkpoint {
+    #[must_use]
+    pub fn new(
+        revision: u64,
+        source: &[Value],
+        projected: Vec<Value>,
+        before: u64,
+        after: u64,
+    ) -> Self {
+        Self {
+            version: 1,
+            revision,
+            source_message_count: source.len(),
+            source_digest: digest_messages(source),
+            projected_messages: projected,
+            before_estimate: before,
+            after_estimate: after,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Projection {
+    /// Effective messages and the index where the raw suffix starts.
+    Valid {
+        messages: Vec<Value>,
+        suffix_start: usize,
+    },
+    /// Fail closed: the raw context is used and the checkpoint should be dropped.
+    Invalid(String),
+}
+
+pub const PREFIX_MISMATCH: &str = "Raw context prefix no longer matches the projection checkpoint.";
+
+#[must_use]
+pub fn apply_projection(raw: &[Value], checkpoint: Option<&Checkpoint>) -> Projection {
+    let Some(checkpoint) = checkpoint else {
+        return Projection::Valid {
+            messages: raw.to_vec(),
+            suffix_start: 0,
+        };
+    };
+    if checkpoint.version != 1 {
+        return Projection::Invalid(format!(
+            "Unsupported projection version: {}.",
+            checkpoint.version
+        ));
+    }
+    if raw.len() < checkpoint.source_message_count {
+        return Projection::Invalid(
+            "Raw context is shorter than the projection source prefix.".into(),
+        );
+    }
+    if digest_messages(&raw[..checkpoint.source_message_count]) != checkpoint.source_digest {
+        return Projection::Invalid(PREFIX_MISMATCH.into());
+    }
+    let mut messages = checkpoint.projected_messages.clone();
+    let suffix_start = messages.len();
+    messages.extend_from_slice(&raw[checkpoint.source_message_count..]);
+    Projection::Valid {
+        messages,
+        suffix_start,
+    }
+}
+
+/// Newest checkpoint in `history` whose prefix still matches: the branch-switch
+/// and resume path (TS `findHistoricalRecovery`).
+#[must_use]
+pub fn latest_matching<'a>(raw: &[Value], history: &'a [Checkpoint]) -> Option<&'a Checkpoint> {
+    history.iter().rev().find(|checkpoint| {
+        matches!(
+            apply_projection(raw, Some(checkpoint)),
+            Projection::Valid { .. }
+        )
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn raw(count: usize) -> Vec<Value> {
+        (0..count)
+            .map(|index| json!({ "role": "user", "content": format!("m{index}"), "timestamp": index }))
+            .collect()
+    }
+
+    #[test]
+    fn valid_checkpoint_replaces_the_prefix_and_keeps_the_suffix() {
+        let source = raw(3);
+        let checkpoint = Checkpoint::new(
+            1,
+            &source,
+            vec![json!({ "role": "custom", "content": "notes" })],
+            30,
+            5,
+        );
+        let Projection::Valid {
+            messages,
+            suffix_start,
+        } = apply_projection(&raw(5), Some(&checkpoint))
+        else {
+            panic!("projection invalid");
+        };
+        assert_eq!(suffix_start, 1);
+        assert_eq!(messages.len(), 3);
+        assert_eq!(messages[1]["content"], "m3");
+    }
+
+    #[test]
+    fn changed_or_short_prefix_fails_closed() {
+        let checkpoint = Checkpoint::new(1, &raw(3), Vec::new(), 0, 0);
+        let mut edited = raw(4);
+        edited[0]["content"] = json!("rewritten by a compaction");
+        assert_eq!(
+            apply_projection(&edited, Some(&checkpoint)),
+            Projection::Invalid(PREFIX_MISMATCH.into())
+        );
+        assert!(matches!(
+            apply_projection(&raw(2), Some(&checkpoint)),
+            Projection::Invalid(_)
+        ));
+    }
+
+    #[test]
+    fn checkpoint_round_trips_through_a_custom_entry() {
+        let checkpoint = Checkpoint::new(2, &raw(2), raw(1), 10, 4);
+        let value = serde_json::to_value(&checkpoint).unwrap();
+        assert_eq!(value["sourceMessageCount"], 2);
+        assert_eq!(
+            serde_json::from_value::<Checkpoint>(value).unwrap(),
+            checkpoint
+        );
+    }
+
+    #[test]
+    fn history_lookup_finds_the_newest_matching_branch_point() {
+        let older = Checkpoint::new(1, &raw(2), Vec::new(), 0, 0);
+        let mut other_branch = raw(4);
+        other_branch[3]["content"] = json!("other branch");
+        let newer = Checkpoint::new(2, &other_branch, Vec::new(), 0, 0);
+        let history = [older.clone(), newer];
+        assert_eq!(latest_matching(&raw(5), &history), Some(&older));
+    }
+}
