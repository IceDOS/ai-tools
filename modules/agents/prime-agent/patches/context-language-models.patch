+//! Context language models (settings `contextLanguageModels`): a port of the
+//! pi-clm extension. The model edits a mirror of its own effective context; an
+//! accepted edit becomes a projection checkpoint that replaces the raw prefix on
+//! later requests. Raw session history is never rewritten.
+
+pub mod budget;
+pub mod document;
+pub mod guard;
+pub mod projection;
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+use serde_json::{json, Value};
+
+use crate::settings::ContextLanguageModelsSettings;
+use budget::{BudgetPolicy, BudgetReading, BudgetTracker, EstimateCalibrator};
+use document::{
+    apply_document, estimate_text_tokens, estimate_tokens, render_document, ApplyOutcome, Snapshot,
+};
+use projection::{apply_projection, latest_matching, Checkpoint, Projection};
+
+pub const NOTICE_CUSTOM_TYPE: &str = "clm-notice";
+pub const MIRROR_FILE: &str = "LIVE_CONTEXT.md";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NativeCompaction {
+    /// Cancel threshold compaction while the overflow guard enforces a budget.
+    Auto,
+    /// Cancel every automatic compaction.
+    Off,
+    /// Leave compaction alone.
+    On,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct ClmConfig {
+    pub budget: BudgetPolicy,
+    pub observation_cap: Option<(usize, f64)>,
+    pub overflow_withhold: bool,
+    pub estimate_factor: Option<f64>,
+    pub one_tool_per_turn: bool,
+    pub size_trailer: bool,
+    pub native_compaction: NativeCompaction,
+    pub steering: Option<PathBuf>,
+}
+
+impl ClmConfig {
+    /// Same validation as the pi-clm env parsers.
+    ///
+    /// # Errors
+    /// An out-of-range value is an error, never a silent default.
+    pub fn from_settings(settings: &ContextLanguageModelsSettings) -> Result<Self, String> {
+        let mut budget = BudgetPolicy {
+            context_budget: settings.budget,
+            ..BudgetPolicy::default()
+        };
+        if let Some(reserve) = settings.reserve {
+            budget.reserve = reserve;
+        }
+        if let Some(remind_at) = &settings.remind_at {
+            if let Some(bad) = remind_at.iter().find(|f| !(**f > 0.0 && **f < 1.0)) {
+                return Err(format!("remindAt entries must be in (0, 1), got {bad}"));
+            }
+            budget.remind_at.clone_from(remind_at);
+            budget.remind_at.sort_by(f64::total_cmp);
+            budget.remind_at_reserve = !remind_at.is_empty();
+        }
+        let head = settings.observation_cap_head.unwrap_or(0.8);
+        if !(head > 0.0 && head <= 1.0) {
+            return Err(format!("observationCapHead must be in (0, 1], got {head}"));
+        }
+        let observation_cap = match settings.observation_cap {
+            None | Some(0) => None,
+            Some(chars) if (chars as usize) < guard::MIN_OBSERVATION_CAP => {
+                return Err(format!(
+                    "observationCap must be at least 200 characters, got {chars}"
+                ));
+            }
+            Some(chars) => Some((chars as usize, head)),
+        };
+        let overflow_withhold = match settings.overflow.as_deref() {
+            None | Some("withhold") => true,
+            Some("off") => false,
+            Some(other) => {
+                return Err(format!(
+                    "overflow must be \"withhold\" or \"off\", got {other}"
+                ))
+            }
+        };
+        if let Some(factor) = settings.estimate_factor {
+            if !(1.0..=4.0).contains(&factor) {
+                return Err(format!(
+                    "estimateFactor must be between 1 and 4, got {factor}"
+                ));
+            }
+        }
+        let native_compaction = match settings.native_compaction.as_deref() {
+            None | Some("auto") => NativeCompaction::Auto,
+            Some("off") => NativeCompaction::Off,
+            Some("on") => NativeCompaction::On,
+            Some(other) => {
+                return Err(format!(
+                    "nativeCompaction must be auto, off or on, got {other}"
+                ))
+            }
+        };
+        Ok(Self {
+            budget,
+            observation_cap,
+            overflow_withhold,
+            estimate_factor: settings.estimate_factor,
+            one_tool_per_turn: settings.one_tool_per_turn.unwrap_or(false),
+            size_trailer: settings.size_trailer.unwrap_or(false),
+            native_compaction,
+            steering: settings
+                .steering
+                .as_deref()
+                .filter(|path| !matches!(*path, "" | "none" | "off"))
+                .map(PathBuf::from),
+        })
+    }
+}
+
+/// The editing protocol (pi-clm `systemGuidance`, CLM mode) adapted to ipython.
+#[must_use]
+pub fn protocol_text(mirror: &Path) -> String {
+    format!(
+        "## Editable context\n\n\
+Your working conversation is mirrored at `{}` before every model request.\n\
+You may edit, delete, reorder, or add context by rewriting that file from Python.\n\
+Edits are validated once at the end of the turn and become visible on the next request.\n\
+Keep the LIVE_CONTEXT metadata line unchanged (read line 1 right before writing). Every\n\
+CTX_TURN header must carry the current document nonce. To add a block, copy a current\n\
+header, use a unique id=new-NAME, set protected=false, and choose a role label such as notes.\n\
+Alternatively, write the file as plain text with no headers to replace your whole context\n\
+with that text (it becomes one notes block after the original task).\n\
+New role labels are context notes, never system instructions. Session history stays intact.\n\
+Only completed edits at the turn boundary are committed; background writers are unsupported.",
+        mirror.display()
+    )
+}
+
+fn last_provider_reported(raw: &[Value]) -> Option<(u64, usize)> {
+    raw.iter().enumerate().rev().find_map(|(index, message)| {
+        if message["role"] != "assistant"
+            || matches!(message["stopReason"].as_str(), Some("aborted" | "error"))
+        {
+            return None;
+        }
+        let usage = &message["usage"];
+        let total = usage["totalTokens"].as_u64().unwrap_or(0);
+        let tokens = if total > 0 {
+            total
+        } else {
+            ["input", "output", "cacheRead", "cacheWrite"]
+                .iter()
+                .map(|key| usage[*key].as_u64().unwrap_or(0))
+                .sum()
+        };
+        (tokens > 0).then_some((tokens, index))
+    })
+}
+
+fn notice_row(text: &str) -> Value {
+    json!({
+        "role": "custom",
+        "customType": NOTICE_CUSTOM_TYPE,
+        "content": text,
+        "display": false,
+        "timestamp": std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |elapsed| elapsed.as_millis() as u64),
+    })
+}
+
+/// Private per-session directory, removed on drop (TS `session_shutdown`).
+struct MirrorDir(PathBuf);
+
+impl MirrorDir {
+    fn create(session_id: &str) -> std::io::Result<Self> {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        let safe: String = session_id
+            .chars()
+            .filter(char::is_ascii_alphanumeric)
+            .take(32)
+            .collect();
+        let serial = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "pa-live-context-{safe}-{}-{serial}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&path)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o700))?;
+        }
+        Ok(Self(path))
+    }
+
+    fn path(&self) -> &Path {
+        &self.0
+    }
+}
+
+impl Drop for MirrorDir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+struct Baseline {
+    raw: Vec<Value>,
+    snapshot: Snapshot,
+}
+
+/// One session's CLM state. The engine holds it behind a mutex shared by the
+/// transform seam, the turn-end listener and the tool hooks.
+pub struct ClmRuntime {
+    config: ClmConfig,
+    session_seed: String,
+    /// Removed with the runtime (TS `session_shutdown`).
+    mirror_dir: MirrorDir,
+    revision: u64,
+    checkpoint: Option<Checkpoint>,
+    history: Vec<Checkpoint>,
+    calibrator: EstimateCalibrator,
+    tracker: BudgetTracker,
+    baseline: Option<Baseline>,
+    pending_notices: Vec<String>,
+    /// Raw length when the last edit landed; older provider counts are stale.
+    edit_raw_len: Option<usize>,
+    last_estimate: u64,
+    tool_calls_this_turn: u32,
+}
+
+impl ClmRuntime {
+    /// # Errors
+    /// The mirror directory cannot be created.
+    pub fn new(config: ClmConfig, session_id: &str) -> std::io::Result<Self> {
+        let mirror_dir = MirrorDir::create(session_id)?;
+        Ok(Self {
+            calibrator: EstimateCalibrator::new(config.estimate_factor),
+            config,
+            session_seed: session_id.to_string(),
+            mirror_dir,
+            revision: 0,
+            checkpoint: None,
+            history: Vec::new(),
+            tracker: BudgetTracker::default(),
+            baseline: None,
+            pending_notices: Vec::new(),
+            edit_raw_len: None,
+            last_estimate: 0,
+            tool_calls_this_turn: 0,
+        })
+    }
+
+    #[must_use]
+    pub fn mirror_path(&self) -> PathBuf {
+        self.mirror_dir.path().join(MIRROR_FILE)
+    }
+
+    #[must_use]
+    pub fn config(&self) -> &ClmConfig {
+        &self.config
+    }
+
+    /// Protocol plus the optional steering document, for the system prompt.
+    #[must_use]
+    pub fn system_prompt_section(&self) -> String {
+        let mut text = protocol_text(&self.mirror_path());
+        if let Some(path) = &self.config.steering {
+            match std::fs::read_to_string(path) {
+                Ok(steering) if !steering.trim().is_empty() => {
+                    let name = path
+                        .file_name()
+                        .map_or_else(String::new, |n| n.to_string_lossy().into_owned());
+                    text.push_str("\n\n## Context-management guidance (");
+                    text.push_str(&name);
+                    text.push_str(")\n\n");
+                    text.push_str(steering.trim());
+                }
+                _ => tracing::warn!("clm steering document unreadable: {}", path.display()),
+            }
+        }
+        text
+    }
+
+    /// Checkpoints read back from the session's `clm-state` custom entries, oldest first.
+    pub fn restore(&mut self, history: Vec<Checkpoint>) {
+        self.revision = history
+            .iter()
+            .map(|checkpoint| checkpoint.revision)
+            .max()
+            .unwrap_or(0);
+        self.history = history;
+        self.checkpoint = None;
+    }
+
+    /// The `transform_context` body: projection, observation cap, overflow guard,
+    /// mirror refresh and notices, in pi-clm's order.
+    pub fn transform(
+        &mut self,
+        raw: &[Value],
+        system_prompt_tokens: u64,
+        context_window: u64,
+    ) -> Vec<Value> {
+        let mut projection = apply_projection(raw, self.checkpoint.as_ref());
+        if let Projection::Invalid(reason) = &projection {
+            self.pending_notices
+                .push(format!("Discarded a stale projection: {reason}"));
+            self.checkpoint = None;
+        }
+        if self.checkpoint.is_none() {
+            if let Some(found) = latest_matching(raw, &self.history).cloned() {
+                projection = apply_projection(raw, Some(&found));
+                self.checkpoint = Some(found);
+            }
+        }
+        let (mut effective, suffix_start) = match projection {
+            Projection::Valid {
+                messages,
+                suffix_start,
+            } => (messages, suffix_start),
+            Projection::Invalid(_) => (raw.to_vec(), 0),
+        };
+        if let Some((chars, head)) = self.config.observation_cap {
+            guard::cap_observations(&mut effective, chars, head);
+        }
+        let observed = last_provider_reported(raw);
+        self.calibrator.observe(observed);
+        let resolved = self.config.budget.resolve(context_window);
+
+        let mut notices: Vec<String> = std::mem::take(&mut self.pending_notices);
+        if let (true, Some(resolved)) = (self.config.overflow_withhold, resolved) {
+            let limit =
+                guard::overflow_guard_limit(resolved.budget, resolved.reserve, context_window);
+            let calibrator = self.calibrator.clone();
+            let notice_tokens: u64 = notices
+                .iter()
+                .map(|notice| estimate_text_tokens(notice))
+                .sum();
+            let result = guard::apply_overflow_guard(
+                &mut effective,
+                limit,
+                calibrator.apply(system_prompt_tokens + notice_tokens),
+                &|messages| calibrator.apply(estimate_tokens(messages)),
+                Some(&self.mirror_dir.path().join("withheld")),
+                if self.checkpoint.is_some() {
+                    suffix_start
+                } else {
+                    0
+                },
+            );
+            if !result.withheld.is_empty() {
+                notices.push(guard::overflow_notice_text(&result, limit));
+            }
+        }
+
+        let seed_digest = self
+            .checkpoint
+            .as_ref()
+            .map_or("raw", |c| c.source_digest.as_str());
+        let snapshot = render_document(
+            &effective,
+            self.revision,
+            &format!("{}:{seed_digest}", self.session_seed),
+        );
+        match std::fs::write(self.mirror_path(), &snapshot.text) {
+            Ok(()) => {
+                self.baseline = Some(Baseline {
+                    raw: raw.to_vec(),
+                    snapshot,
+                });
+            }
+            Err(error) => {
+                self.baseline = None;
+                notices.push(format!("Mirror refresh failed: {error}"));
+            }
+        }
+
+        if let Some(resolved) = resolved {
+            let notice_tokens: u64 = notices
+                .iter()
+                .map(|notice| estimate_text_tokens(notice))
+                .sum();
+            let reading = BudgetReading {
+                budget: resolved,
+                estimated: self
+                    .calibrator
+                    .apply(system_prompt_tokens + estimate_tokens(&effective) + notice_tokens),
+                observed: observed.map(|(tokens, _)| tokens),
+                observed_stale: matches!((observed, self.edit_raw_len), (Some((_, index)), Some(len)) if index < len),
+                calibration: self.calibrator.factor(),
+            };
+            self.last_estimate = reading.estimated;
+            let tiers = self.config.budget.tiers(resolved);
+            if let Some(tier) = self.tracker.observe(reading.governing(), &tiers) {
+                notices.push(budget::budget_notice_text(
+                    &reading,
+                    &tier,
+                    &self.mirror_path().display().to_string(),
+                ));
+            }
+        }
+
+        let mut output = effective;
+        output.extend(notices.iter().map(|notice| notice_row(notice)));
+        self.calibrator
+            .record(system_prompt_tokens + estimate_tokens(&output), raw.len());
+        output
+    }
+
+    /// The turn-end commit. Returns a new checkpoint for the caller to persist as
+    /// a `clm-state` custom entry.
+    pub fn commit_turn(&mut self) -> Option<Checkpoint> {
+        let baseline = self.baseline.take()?;
+        let edited = match std::fs::read_to_string(self.mirror_path()) {
+            Ok(text) => text,
+            Err(error) => {
+                self.pending_notices
+                    .push(format!("Mirror read failed: {error}"));
+                self.baseline = Some(baseline);
+                return None;
+            }
+        };
+        match apply_document(&edited, &baseline.snapshot) {
+            ApplyOutcome::Unchanged => {
+                self.baseline = Some(baseline);
+                None
+            }
+            ApplyOutcome::Rejected(reason) => {
+                self.pending_notices
+                    .push(format!("Edit rejected: {reason}"));
+                self.baseline = Some(baseline);
+                None
+            }
+            ApplyOutcome::Accepted {
+                messages,
+                before_tokens,
+                after_tokens,
+                diagnostics,
+            } => {
+                self.revision += 1;
+                let checkpoint = Checkpoint::new(
+                    self.revision,
+                    &baseline.raw,
+                    messages,
+                    before_tokens,
+                    after_tokens,
+                );
+                let mut notice = format!(
+                    "Applied revision {}; estimated tokens {before_tokens}->{after_tokens}.",
+                    self.revision
+                );
+                for line in diagnostics {
+                    notice.push(' ');
+                    notice.push_str(&line);
+                }
+                self.pending_notices.push(notice);
+                self.edit_raw_len = Some(baseline.raw.len());
+                self.tracker.reset();
+                self.history.push(checkpoint.clone());
+                self.checkpoint = Some(checkpoint.clone());
+                Some(checkpoint)
+            }
+        }
+    }
+
+    /// Refresh mirror and baseline when a turn settles.
+    pub fn on_turn_end(&mut self, message: Value, tool_results: Vec<Value>) {
+        let mirror_path = self.mirror_path();
+        if let Some(baseline) = &mut self.baseline {
+            baseline.raw.push(message);
+            baseline.raw.extend(tool_results);
+            let projection = apply_projection(&baseline.raw, self.checkpoint.as_ref());
+            let effective = match projection {
+                Projection::Valid { messages, .. } => messages,
+                Projection::Invalid(_) => baseline.raw.clone(),
+            };
+            let seed_digest = self
+                .checkpoint
+                .as_ref()
+                .map_or("raw", |c| c.source_digest.as_str());
+            let snapshot = render_document(
+                &effective,
+                self.revision,
+                &format!("{}:{seed_digest}", self.session_seed),
+            );
+            if std::fs::write(&mirror_path, &snapshot.text).is_ok() {
+                baseline.snapshot = snapshot;
+            }
+        }
+    }
+
+    pub fn on_turn_start(&mut self) {
+        self.tool_calls_this_turn = 0;
+    }
+
+    /// `oneToolPerTurn`: the block reason for every call after the first in a turn.
+    pub fn gate_tool_call(&mut self, tool_name: &str) -> Option<String> {
+        if !self.config.one_tool_per_turn {
+            return None;
+        }
+        self.tool_calls_this_turn += 1;
+        (self.tool_calls_this_turn > 1).then(|| {
+            format!(
+                "pi-clm paper mode allows exactly one tool call per turn; this {tool_name} call (#{} in the turn) was not executed. Issue it again on its own in your next turn.",
+                self.tool_calls_this_turn
+            )
+        })
+    }
+
+    /// `sizeTrailer`: the line appended to a tool result.
+    #[must_use]
+    pub fn size_trailer(&self, result_text: &str, context_window: u64) -> Option<String> {
+        if !self.config.size_trailer {
+            return None;
+        }
+        let resolved = self.config.budget.resolve(context_window)?;
+        let approx = self.last_estimate + self.calibrator.apply(estimate_text_tokens(result_text));
+        Some(format!(
+            "\n\n[context: ~{approx} of {} tokens after this result]",
+            resolved.budget
+        ))
+    }
+
+    /// Gate for `auto_compaction_due` (threshold) and overflow recovery.
+    #[must_use]
+    pub fn cancels_compaction(&self, overflow_recovery: bool) -> bool {
+        match self.config.native_compaction {
+            NativeCompaction::On => false,
+            NativeCompaction::Off => true,
+            NativeCompaction::Auto => !overflow_recovery && self.config.overflow_withhold,
+        }
+    }
+}
+
+pub type SharedClm = Arc<Mutex<ClmRuntime>>;
+
+/// Wrap the engine's transform seam: CLM runs first, then `inner`.
+#[must_use]
+pub fn transform_context_fn(
+    runtime: SharedClm,
+    inner: pa_agent::agent_loop::TransformContextFn,
+    system_prompt_tokens: u64,
+    context_window: u64,
+) -> pa_agent::agent_loop::TransformContextFn {
+    Arc::new(move |messages, signal| {
+        let runtime = Arc::clone(&runtime);
+        let inner = Arc::clone(&inner);
+        Box::pin(async move {
+            let raw: Vec<Value> = messages
+                .iter()
+                .map(serde_json::to_value)
+                .collect::<Result<_, _>>()?;
+            let effective = runtime
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .transform(&raw, system_prompt_tokens, context_window);
+            let messages = effective
+                .into_iter()
+                .map(serde_json::from_value)
+                .collect::<Result<Vec<pa_agent::types::AgentMessage>, _>>()?;
+            inner(messages, signal).await
+        })
+    })
+}
