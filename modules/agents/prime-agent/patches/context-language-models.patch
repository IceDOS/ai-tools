+        let config = ClmConfig::from_settings(&settings(json!({ "enabled": true }))).unwrap();
+        assert!(config.overflow_withhold);
+        assert_eq!(config.native_compaction, NativeCompaction::Auto);
+        assert_eq!(config.observation_cap, None);
+        assert!(ClmConfig::from_settings(&settings(json!({ "observationCap": 50 }))).is_err());
+        assert!(ClmConfig::from_settings(&settings(json!({ "remindAt": [1.5] }))).is_err());
+        assert!(ClmConfig::from_settings(&settings(json!({ "estimateFactor": 9 }))).is_err());
+        let quiet = ClmConfig::from_settings(&settings(json!({ "remindAt": [] }))).unwrap();
+        assert!(!quiet.budget.remind_at_reserve);
+    }
+
+    #[test]
+    fn transform_writes_the_mirror_and_an_edit_becomes_the_next_context() {
+        let config = ClmConfig::from_settings(&settings(json!({ "budget": 1_000_000 }))).unwrap();
+        let mut runtime = ClmRuntime::new(config, "0199-session").unwrap();
+        let raw = conversation(400);
+        let output = runtime.transform(&raw, 100, 1_000_000);
+        assert_eq!(output.len(), 3, "no notices under budget");
+        let mirror = std::fs::read_to_string(runtime.mirror_path()).unwrap();
+        assert!(mirror.starts_with("[[LIVE_CONTEXT version=1 revision=0"));
+
+        std::fs::write(
+            runtime.mirror_path(),
+            "task: fix bug in a.py; a.py was read",
+        )
+        .unwrap();
+        let checkpoint = runtime.commit_turn().expect("edit accepted");
+        assert_eq!(checkpoint.revision, 1);
+        assert_eq!(checkpoint.source_message_count, 3);
+
+        let mut next = raw.clone();
+        next.push(json!({ "role": "user", "content": "go on", "timestamp": 9 }));
+        let output = runtime.transform(&next, 100, 1_000_000);
+        assert_eq!(output[1]["details"]["contextRole"], "notes");
+        assert_eq!(output[2]["content"], "go on");
+        assert_eq!(
+            output.last().unwrap()["customType"],
+            NOTICE_CUSTOM_TYPE,
+            "applied notice"
+        );
+    }
+
+    #[test]
+    fn rejected_edit_reports_on_the_next_request() {
+        let config = ClmConfig::from_settings(&settings(json!({}))).unwrap();
+        let mut runtime = ClmRuntime::new(config, "s").unwrap();
+        let raw = conversation(10);
+        runtime.transform(&raw, 0, 100_000);
+        let mirror = std::fs::read_to_string(runtime.mirror_path()).unwrap();
+        std::fs::write(
+            runtime.mirror_path(),
+            mirror.replacen("revision=0", "revision=7", 1),
+        )
+        .unwrap();
+        assert!(runtime.commit_turn().is_none());
+        let output = runtime.transform(&raw, 0, 100_000);
+        let notice = output.last().unwrap()["content"].as_str().unwrap();
+        assert!(notice.starts_with("Edit rejected: Mirror metadata does not match"));
+    }
+
+    #[test]
+    fn overflow_guard_withholds_when_over_the_budget() {
+        let config = ClmConfig::from_settings(&settings(
+            json!({ "budget": 3000, "reserve": 0, "remindAt": [] }),
+        ))
+        .unwrap();
+        let mut runtime = ClmRuntime::new(config, "s").unwrap();
+        let output = runtime.transform(&conversation(40_000), 0, 0);
+        let note = output[2]["content"][0]["text"].as_str().unwrap();
+        assert!(note.starts_with("[pi-clm overflow guard] ipython#c1"));
+        assert!(output.last().unwrap()["content"]
+            .as_str()
+            .unwrap()
+            .contains("Overflow guard"));
+        assert!(runtime
+            .mirror_path()
+            .parent()
+            .unwrap()
+            .join("withheld/c1.txt")
+            .exists());
+    }
+
+    #[test]
+    fn restored_history_reapplies_on_resume() {
+        let config = ClmConfig::from_settings(&settings(json!({}))).unwrap();
+        let raw = conversation(10);
+        let checkpoint = Checkpoint::new(
+            3,
+            &raw,
+            vec![json!({ "role": "user", "content": "short", "timestamp": 1 })],
+            9,
+            2,
+        );
+        let mut runtime = ClmRuntime::new(config, "s").unwrap();
+        runtime.restore(vec![checkpoint]);
+        let output = runtime.transform(&raw, 0, 100_000);
+        assert_eq!(output[0]["content"], "short");
+        assert!(std::fs::read_to_string(runtime.mirror_path())
+            .unwrap()
+            .contains("revision=3"));
+    }
+
+    #[test]
+    fn tool_gate_and_compaction_policy() {
+        let config = ClmConfig::from_settings(&settings(
+            json!({ "oneToolPerTurn": true, "nativeCompaction": "off" }),
+        ))
+        .unwrap();
+        let mut runtime = ClmRuntime::new(config, "s").unwrap();
+        assert!(runtime.gate_tool_call("ipython").is_none());
+        assert!(runtime
+            .gate_tool_call("ipython")
+            .unwrap()
+            .contains("#2 in the turn"));
+        runtime.on_turn_start();
+        assert!(runtime.gate_tool_call("ipython").is_none());
+        assert!(runtime.cancels_compaction(true));
+        let auto =
+            ClmRuntime::new(ClmConfig::from_settings(&settings(json!({}))).unwrap(), "s").unwrap();
+        assert!(auto.cancels_compaction(false));
+        assert!(!auto.cancels_compaction(true));
+    }
+
+    #[test]
+    fn notes_round_trip_through_the_agent_message_type() {
+        let note = document::context_note("plan", None, Some("notes"));
+        let message: pa_agent::types::AgentMessage = serde_json::from_value(note).unwrap();
+        assert_eq!(message.role(), "custom");
+        let converted = crate::session_engine::messages::loop_convert_to_llm(vec![message]);
+        assert_eq!(
+            converted.len(),
+            1,
+            "a note reaches the provider as a user turn"
+        );
+    }
+}
