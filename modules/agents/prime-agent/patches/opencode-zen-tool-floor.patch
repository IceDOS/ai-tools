diff --git a/packages/ai/src/providers/opencode-headers.ts b/packages/ai/src/providers/opencode-headers.ts
index e5f956a..1f8946f 100644
--- a/packages/ai/src/providers/opencode-headers.ts
+++ b/packages/ai/src/providers/opencode-headers.ts
@@ -14,3 +14,18 @@ export function withOpenCodeHeaders<T extends string | null>(
 	}
 	return merged;
 }
+
+export function isOpenCodeProvider(provider: string): boolean {
+	return provider === "opencode" || provider === "opencode-go";
+}
+
+// zen rejects a free-tier request whose tools omit opencode's own, so stubs for the
+// missing names are appended. The model is told not to call them.
+export const OPENCODE_REQUIRED_TOOLS = ["bash", "grep", "glob", "read"];
+
+export const OPENCODE_STUB_TOOL_DESCRIPTION = "Unavailable in this environment. Use the ipython tool instead.";
+
+export function missingOpenCodeTools(present: Iterable<string>): string[] {
+	const have = new Set(present);
+	return OPENCODE_REQUIRED_TOOLS.filter((name) => !have.has(name));
+}
