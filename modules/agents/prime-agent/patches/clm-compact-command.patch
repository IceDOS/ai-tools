+//! `/clm-compact [instructions]` (pi-clm `compact.ts`): ask the model to compact its own
+//! live context now. The model edits the mirror; the edit commits at turn end like any other.
+
+use std::path::Path;
+
+pub const COMMAND: &str = "clm-compact";
+
+pub const DEFAULT_COMPACT_PROMPT: &str = "Compact your live context now.
+
+Your next request is about {{current}} tokens{{budget}}. Your context is mirrored at `{{mirror}}`; edit that file, following the Editable context protocol, to remove what you no longer need.
+
+Keep what you still need: the task and the user's latest requests, decisions and their reasons, open items, and exact values (ids, paths, numbers) you will use again. Drop what you no longer need: tool output you have already used, superseded drafts and intermediate steps. Prefer one scripted edit of the whole file over many small ones.
+
+{{instructions}}
+
+When the edit is saved, reply in one line: what you kept, and the new approximate size.";
+
+const EMPTY_SLOT: char = '\u{0}';
+
+/// The arguments of a `/clm-compact` prompt, or `None` for any other text.
+#[must_use]
+pub fn parse_command(text: &str) -> Option<String> {
+    let (name, args) = pa_types::slash_commands::parse_slash_command(text)?;
+    (name == COMMAND).then_some(args)
+}
+
+/// pi-clm `formatTokens`: `850`, `85.4k`, `1.25m`.
+#[must_use]
+pub fn format_tokens(value: u64) -> String {
+    let scaled = |divisor: f64, digits: usize| {
+        let text = format!("{:.digits$}", value as f64 / divisor);
+        text.trim_end_matches('0').trim_end_matches('.').to_string()
+    };
+    if value >= 1_000_000 {
+        format!("{}m", scaled(1_000_000.0, 2))
+    } else if value >= 1_000 {
+        format!("{}k", scaled(1_000.0, 1))
+    } else {
+        value.to_string()
+    }
+}
+
+/// Fill `{{mirror}}`, `{{current}}`, `{{budget}}` and `{{instructions}}`; unknown
+/// placeholders stay as written.
+#[must_use]
+pub fn build_prompt(
+    template: &str,
+    mirror: &Path,
+    current: u64,
+    budget: Option<u64>,
+    instructions: &str,
+) -> String {
+    let instructions = match instructions.trim() {
+        "" => String::new(),
+        text => format!("Also: {text}"),
+    };
+    // Typed instructions are never dropped: a template without the slot gets them at the end.
+    let template = if !instructions.is_empty() && !template.contains("{{instructions}}") {
+        format!("{template}\n\n{{{{instructions}}}}")
+    } else {
+        template.to_string()
+    };
+    let value = |name: &str| match name {
+        "mirror" => Some(mirror.display().to_string()),
+        "current" => Some(format_tokens(current)),
+        "budget" => Some(budget.map_or_else(String::new, |b| format!(" (budget {})", format_tokens(b)))),
+        "instructions" if instructions.is_empty() => Some(EMPTY_SLOT.to_string()),
+        "instructions" => Some(instructions.clone()),
+        _ => None,
+    };
+    let mut filled = String::new();
+    let mut rest = template.as_str();
+    while let Some(start) = rest.find("{{") {
+        filled.push_str(&rest[..start]);
+        let after = &rest[start + 2..];
+        let name_len = after.find(|c: char| !(c.is_ascii_alphanumeric() || c == '_')).unwrap_or(after.len());
+        let replacement = (name_len > 0 && after[name_len..].starts_with("}}"))
+            .then(|| value(&after[..name_len]))
+            .flatten();
+        match replacement {
+            Some(text) => {
+                filled.push_str(&text);
+                rest = &after[name_len + 2..];
+            }
+            None => {
+                filled.push_str("{{");
+                rest = after;
+            }
+        }
+    }
+    filled.push_str(rest);
+    collapse_empty_slot(&filled).trim().to_string()
+}
+
+// An empty instructions slot takes its own blank lines with it.
+fn collapse_empty_slot(text: &str) -> String {
+    let Some(slot) = text.find(EMPTY_SLOT) else {
+        return text.to_string();
+    };
+    let head = text[..slot].trim_end_matches('\n');
+    let tail = text[slot + 1..].trim_start_matches('\n');
+    let had_newline = head.len() < slot || tail.len() < text.len() - slot - 1;
+    let joined = format!("{head}{}{tail}", if had_newline { "\n\n" } else { "" });
+    collapse_empty_slot(&joined)
+}
+
+/// The built-in prompt, or the template at `path` (read on every use, so edits apply at once).
+///
+/// # Errors
+/// The template cannot be read or is empty.
+pub fn load_template(path: Option<&Path>) -> Result<String, String> {
+    let Some(path) = path else {
+        return Ok(DEFAULT_COMPACT_PROMPT.to_string());
+    };
+    let text = std::fs::read_to_string(path)
+        .map_err(|error| format!("compact prompt not loaded: {error}"))?;
+    let text = text.trim();
+    if text.is_empty() {
+        return Err(format!("compact prompt is empty: {}", path.display()));
+    }
+    Ok(text.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MIRROR: &str = "/run/clm/LIVE_CONTEXT.md";
+
+    fn build(template: &str, budget: Option<u64>, instructions: &str) -> String {
+        build_prompt(template, Path::new(MIRROR), 85_432, budget, instructions)
+    }
+
+    #[test]
+    fn parses_only_the_compact_command() {
+        assert_eq!(parse_command("/clm-compact").as_deref(), Some(""));
+        assert_eq!(parse_command("/clm-compact keep the logs").as_deref(), Some("keep the logs"));
+        assert_eq!(parse_command("/clm status"), None);
+        assert_eq!(parse_command("compact please"), None);
+    }
+
+    #[test]
+    fn formats_tokens_like_pi_clm() {
+        assert_eq!(format_tokens(850), "850");
+        assert_eq!(format_tokens(85_432), "85.4k");
+        assert_eq!(format_tokens(120_000), "120k");
+        assert_eq!(format_tokens(1_250_000), "1.25m");
+        assert_eq!(format_tokens(2_000_000), "2m");
+    }
+
+    #[test]
+    fn default_prompt_names_the_mirror_and_size() {
+        let prompt = build(DEFAULT_COMPACT_PROMPT, Some(120_000), "");
+        assert!(prompt.contains("about 85.4k tokens (budget 120k)."));
+        assert!(prompt.contains(&format!("mirrored at `{MIRROR}`")));
+        assert!(!prompt.contains("{{"));
+        // The empty slot leaves one blank line between the paragraphs around it.
+        assert!(prompt.contains("small ones.\n\nWhen the edit is saved"));
+    }
+
+    #[test]
+    fn instructions_fill_the_slot() {
+        let prompt = build(DEFAULT_COMPACT_PROMPT, None, "  keep the build errors ");
+        assert!(prompt.contains("about 85.4k tokens. Your"));
+        assert!(prompt.contains("small ones.\n\nAlso: keep the build errors\n\nWhen the edit"));
+    }
+
+    #[test]
+    fn custom_template_keeps_unknown_placeholders_and_gets_instructions_appended() {
+        let prompt = build("Shrink {{mirror}} from {{current}}; {{other}} stays.", None, "be brief");
+        assert_eq!(prompt, format!("Shrink {MIRROR} from 85.4k; {{{{other}}}} stays.\n\nAlso: be brief"));
+    }
+
+    #[test]
+    fn inline_empty_slot_disappears() {
+        assert_eq!(build("Compact.{{instructions}} Done.", None, ""), "Compact. Done.");
+    }
+
+    #[test]
+    fn loads_the_default_or_a_template_file() {
+        assert_eq!(load_template(None).unwrap(), DEFAULT_COMPACT_PROMPT);
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("compact.md");
+        std::fs::write(&path, "\n  Compact {{mirror}}.\n").unwrap();
+        assert_eq!(load_template(Some(&path)).unwrap(), "Compact {{mirror}}.");
+        std::fs::write(&path, "  \n").unwrap();
+        assert!(load_template(Some(&path)).unwrap_err().contains("empty"));
+        assert!(load_template(Some(&dir.path().join("missing.md"))).unwrap_err().contains("not loaded"));
+    }
+}
