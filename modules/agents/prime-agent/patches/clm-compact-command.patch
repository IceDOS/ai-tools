+    /// The `/clm-compact` prompt for the current size and budget.
+    ///
+    /// # Errors
+    /// CLM is paused, nothing has been measured yet, or the template cannot be read.
+    pub fn compact_prompt(&self, instructions: &str) -> Result<String, String> {
+        if self.paused {
+            return Err("CLM is off, so there is no live context to compact. Turn it on with /clm on.".into());
+        }
+        let current = Some(self.last_estimate)
+            .filter(|tokens| *tokens > 0)
+            .or(self.last_observed)
+            .ok_or("Nothing to compact yet: the context has not been measured. Send a message first.")?;
+        let template = compact::load_template(self.config.compact_prompt.as_deref())?;
+        let budget = self
+            .config
+            .budget
+            .resolve(self.last_context_window)
+            .map(|resolved| resolved.budget);
+        Ok(compact::build_prompt(&template, &self.mirror_path(), current, budget, instructions))
+    }
