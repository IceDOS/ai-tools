@@ -1377,3 +1377,64 @@ async fn clm_restore_handles_settings_and_reset_entries() {
 
 
 
+
+#[tokio::test]
+async fn clm_compact_command_sends_the_filled_prompt_and_needs_clm() {
+    let model = pa_agent::types::Model {
+        id: "m".into(),
+        name: "m".into(),
+        api: "test".into(),
+        provider: "test".into(),
+        base_url: "http://localhost".into(),
+        reasoning: false,
+        cost: pa_agent::types::UsageCost::default(),
+        context_window: 100_000,
+        max_tokens: 1_000,
+        max_tokens_explicit: false,
+    };
+    let tmp = tempfile::tempdir().unwrap();
+    let mut engines = Vec::new();
+    for (name, settings) in [
+        ("clm", r#"{ "contextLanguageModels": { "enabled": true } }"#),
+        ("plain", "{}"),
+    ] {
+        let provider = Arc::new(ScriptedProvider::new(model.clone()));
+        provider.push_text_turn("first answer");
+        provider.push_text_turn("compacted");
+        let cwd = tmp.path().join(name).join("project");
+        let agent_dir = tmp.path().join(name).join("agent");
+        std::fs::create_dir_all(&cwd).unwrap();
+        std::fs::create_dir_all(&agent_dir).unwrap();
+        std::fs::write(agent_dir.join("settings.json"), settings).unwrap();
+        let engine = create_session(SessionEngineConfig {
+            cwd,
+            agent_dir,
+            model: Some(model.clone()),
+            stream_fn: Some(provider.stream_fn()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+        engines.push((engine, provider));
+    }
+
+    let (engine, provider) = &engines[0];
+    engine.prompt("first turn", PromptOptions::default()).await.unwrap();
+    engine.session.agent().wait_for_idle().await;
+    let outcome = engine
+        .prompt("/clm-compact keep the build errors", PromptOptions::default())
+        .await
+        .unwrap();
+    assert_eq!(outcome, PromptOutcome::Prompt);
+    engine.session.agent().wait_for_idle().await;
+    let mirror = engine.session.clm.as_ref().unwrap().lock().unwrap().mirror_path();
+    let sent = format!("{:?}", provider.calls()[1].messages);
+    assert!(sent.contains("Compact your live context now."), "{sent}");
+    assert!(sent.contains(&mirror.display().to_string()), "{sent}");
+    assert!(sent.contains("Also: keep the build errors"), "{sent}");
+    assert!(!sent.contains("/clm-compact"), "{sent}");
+
+    let (plain, _) = &engines[1];
+    let error = plain.prompt("/clm-compact", PromptOptions::default()).await.unwrap_err();
+    assert!(error.to_string().contains("needs context language models"), "{error}");
+}
