+    fn clm_worker(dir: &std::path::Path, agent: &str) -> Worker {
+        let agent_dir = dir.join(agent);
+        std::fs::create_dir_all(&agent_dir).unwrap();
+        std::fs::write(
+            agent_dir.join("settings.json"),
+            r#"{ "contextLanguageModels": { "enabled": true } }"#,
+        )
+        .unwrap();
+        Worker::new(
+            WorkerConfig {
+                socket_path: dir.join(format!("{agent}.sock")),
+                supervisor_socket_path: PathBuf::new(),
+                token: "test-token".into(),
+                worker_instance_id: String::new(),
+                active_session_id: "clm-durable".into(),
+                agent_dir,
+                recovery_journal_path: dir.join(format!("{agent}-recovery.jsonl")),
+                telemetry_disabled: Some(true),
+                script: Some(json!({ "engine": "faux", "responses": [] })),
+            },
+            None,
+        )
+    }
+
+    async fn build_session(worker: &Worker, path: &std::path::Path) {
+        let created = worker
+            .dispatch("create", &json!({ "sessionPath": path, "cwd": "/tmp" }))
+            .await;
+        assert!(created.success, "create failed: {created:?}");
+        let engine = worker.agent_engine.as_ref().expect("agent engine");
+        let model = engine.resolve_model().expect("model");
+        engine.ensure_core_session_async(&model).await.expect("session built");
+    }
+
+    #[tokio::test]
+    async fn clm_settings_survive_a_second_worker_on_the_same_file() {
+        let _faux = crate::agent_engine::FAUX_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("durable.jsonl");
+        let mut file = crate::session_store::SessionFile::create("/tmp", None, 0);
+        file.set_path(path.clone());
+        file.rewrite().unwrap();
+
+        let first = clm_worker(dir.path(), "agent-a");
+        build_session(&first, &path).await;
+        let set = first
+            .dispatch(
+                "clm_configure",
+                &json!({ "action": "set", "key": "budget", "value": "32000" }),
+            )
+            .await;
+        assert!(set.success, "{set:?}");
+        let text = std::fs::read_to_string(&path).unwrap();
+        assert!(text.contains(r#""customType":"clm-settings""#), "{text}");
+        drop(first);
+
+        let second = clm_worker(dir.path(), "agent-b");
+        build_session(&second, &path).await;
+        let view = second.dispatch("get_clm_view", &json!({})).await;
+        assert!(view.success, "{view:?}");
+        let budget = view.data.as_ref().unwrap()["settings"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|row| row["key"] == "budget")
+            .unwrap()["value"]
+            .clone();
+        assert_eq!(budget, json!("32000"));
+    }
 }
