+/// Persist engine custom entries as durable `custom` rows, in order.
+pub(crate) fn persist_durable_custom_entries(
+    core: &mut SessionCore,
+    entries: Vec<(String, serde_json::Value)>,
+) {
+    let Some(store) = core.store.as_mut() else { return };
+    for (custom_type, data) in entries {
+        if let Err(error) = store.persist_entry(
+            "custom",
+            serde_json::json!({ "customType": custom_type, "data": data }),
+        ) {
+            eprintln!("pa-daemon: failed to persist {custom_type}: {error:#}");
+        }
+    }
+}
