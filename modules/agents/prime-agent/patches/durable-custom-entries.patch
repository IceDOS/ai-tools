+/// Rebuild checkpoints, settings overrides and annotations from the session's active branch.
+pub fn restore(clm: &SharedClm, session: &SessionManager) {
+    let mut history: Vec<super::projection::Checkpoint> = Vec::new();
+    let mut overrides = super::control::Overrides::default();
+    for entry in session.active_branch_entries() {
+        let FileEntry::Custom { payload, .. } = entry else { continue };
+        match payload.custom_type.as_str() {
+            super::projection::CHECKPOINT_CUSTOM_TYPE => {
+                history.extend(payload.data.clone().and_then(|v| serde_json::from_value(v).ok()));
+            }
+            super::control::RESET_CUSTOM_TYPE => history.clear(),
+            super::control::SETTINGS_CUSTOM_TYPE => {
+                if let Some(saved) = payload.data.clone().and_then(|v| serde_json::from_value(v).ok()) {
+                    overrides = saved;
+                }
+            }
+            _ => {}
+        }
+    }
+    {
+        let mut runtime = clm.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Err(error) = runtime.apply_overrides(overrides) {
+            tracing::warn!("clm settings overrides ignored: {error}");
+        }
+        runtime.restore(history);
+    }
+    refresh(clm, session);
+}
