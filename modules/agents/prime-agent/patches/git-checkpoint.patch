@@ -0,0 +1,89 @@
+//! git-checkpoint: offer to restore the code when forking from a checkpointed prompt.
+
+use std::time::Duration;
+
+use anyhow::Result;
+use serde_json::{Map, Value};
+
+use pa_types::daemon::DaemonCommand;
+
+use super::settings::PendingConfirm;
+use super::{AgentView, SessionUi, UI_REQUEST_TIMEOUT_MS};
+
+/// The ref of a `get_git_checkpoint` reply, when the entry has a checkpoint.
+pub(crate) fn checkpoint_ref(data: &Value) -> Option<String> {
+    data.get("checkpoint")?.get("ref")?.as_str().map(str::to_string)
+}
+
+impl SessionUi {
+    pub(super) async fn fork_or_ask_restore(&mut self, entry_id: &str, view: &mut AgentView) -> Result<()> {
+        let reply = self
+            .bounded_request(
+                Duration::from_millis(UI_REQUEST_TIMEOUT_MS),
+                DaemonCommand::GetGitCheckpoint {
+                    id: None,
+                    active_session_id: self.active_session_id.clone(),
+                    entry_id: entry_id.to_string(),
+                    rest: Map::default(),
+                },
+            )
+            .await;
+        // A lookup error forks as before.
+        let Some(checkpoint_ref) = reply.ok().as_ref().and_then(checkpoint_ref) else {
+            self.fork(entry_id, None, view).await?;
+            return Ok(());
+        };
+        view.confirm = Some(crate::confirm::ConfirmPanel::yes_no_cancel(
+            "Fork",
+            "Restore code to this point?\nTracked files only; untracked files stay as they are.",
+        ));
+        self.pending_confirm = Some(PendingConfirm::ForkCheckpoint {
+            entry_id: entry_id.to_string(),
+            checkpoint_ref,
+        });
+        self.dirty = true;
+        Ok(())
+    }
+
+    pub(super) async fn answer_fork_checkpoint(
+        &mut self,
+        entry_id: &str,
+        checkpoint_ref: &str,
+        option: &str,
+        view: &mut AgentView,
+    ) -> Result<()> {
+        if option == "Cancel" || !self.fork(entry_id, None, view).await? || option != "Yes" {
+            return Ok(());
+        }
+        match self
+            .bounded_request(
+                Duration::from_millis(UI_REQUEST_TIMEOUT_MS * 3),
+                DaemonCommand::RestoreGitCheckpoint {
+                    id: None,
+                    active_session_id: self.active_session_id.clone(),
+                    checkpoint_ref: checkpoint_ref.to_string(),
+                    rest: Map::default(),
+                },
+            )
+            .await
+        {
+            Ok(_) => self.note("Restored code to the checkpoint", view),
+            Err(error) => self.error_row(&format!("restore failed: {error:#}"), view),
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn checkpoint_ref_reads_the_reply() {
+        let found = json!({ "checkpoint": { "ref": "refs/prime-agent/checkpoints/s/e", "commit": "abc" } });
+        assert_eq!(checkpoint_ref(&found).as_deref(), Some("refs/prime-agent/checkpoints/s/e"));
+        assert_eq!(checkpoint_ref(&json!({ "checkpoint": null })), None);
+        assert_eq!(checkpoint_ref(&json!({})), None);
+    }
+}
