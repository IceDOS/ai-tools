+//! `get_git_checkpoint` and `restore_git_checkpoint`: the fork selector's restore offer.
+
+use std::path::PathBuf;
+
+use serde_json::{json, Value};
+
+use crate::git_checkpoint;
+use crate::protocol::{response_failure, response_success, DaemonResponse};
+use crate::worker::Worker;
+
+impl Worker {
+    /// The session cwd and durable session id, or `None` without a store.
+    fn checkpoint_scope(&self) -> Option<(PathBuf, String)> {
+        let core = self.core.lock().unwrap();
+        let store = core.store.as_ref()?;
+        Some((PathBuf::from(&core.cwd), store.session_id().to_string()))
+    }
+
+    pub(crate) async fn handle_get_git_checkpoint(&self, payload: &Value) -> DaemonResponse {
+        const COMMAND: &str = "get_git_checkpoint";
+        if let Err(response) = self.require_created(COMMAND) {
+            return response;
+        }
+        let Some(entry_id) = payload.get("entryId").and_then(Value::as_str) else {
+            return response_failure(None, COMMAND, "entryId is required", None);
+        };
+        let Some((cwd, session_id)) = self.checkpoint_scope() else {
+            return response_success(None, COMMAND, Some(json!({ "checkpoint": null })));
+        };
+        let name = git_checkpoint::ref_name(&session_id, entry_id);
+        let lookup_name = name.clone();
+        let commit = tokio::task::spawn_blocking(move || git_checkpoint::lookup(&cwd, &lookup_name))
+            .await
+            .ok()
+            .flatten();
+        let checkpoint = commit.map_or(Value::Null, |commit| json!({ "ref": name, "commit": commit }));
+        response_success(None, COMMAND, Some(json!({ "checkpoint": checkpoint })))
+    }
+
+    pub(crate) async fn handle_restore_git_checkpoint(&self, payload: &Value) -> DaemonResponse {
+        const COMMAND: &str = "restore_git_checkpoint";
+        if let Err(response) = self.require_created(COMMAND) {
+            return response;
+        }
+        let Some(name) = payload.get("checkpointRef").and_then(Value::as_str).map(str::to_string) else {
+            return response_failure(None, COMMAND, "checkpointRef is required", None);
+        };
+        let cwd = PathBuf::from(&self.core.lock().unwrap().cwd);
+        match tokio::task::spawn_blocking(move || git_checkpoint::restore(&cwd, &name)).await {
+            Ok(Ok(output)) => response_success(None, COMMAND, Some(json!({ "output": output }))),
+            Ok(Err(error)) => response_failure(None, COMMAND, &format!("{error:#}"), None),
+            Err(error) => response_failure(None, COMMAND, &format!("{error}"), None),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::path::{Path, PathBuf};
+    use std::process::Command;
+
+    use serde_json::{json, Value};
+
+    use crate::worker::{Worker, WorkerConfig};
+
+    fn git_ok(dir: &Path, args: &[&str]) {
+        let status = Command::new("git").arg("-C").arg(dir).args(args).status().unwrap();
+        assert!(status.success(), "git {args:?}");
+    }
+
+    fn repo(dir: &Path) -> PathBuf {
+        let repo = dir.join("repo");
+        std::fs::create_dir_all(&repo).unwrap();
+        git_ok(&repo, &["init", "-q"]);
+        git_ok(&repo, &["config", "user.name", "t"]);
+        git_ok(&repo, &["config", "user.email", "t@example.com"]);
+        std::fs::write(repo.join("a.txt"), "one\n").unwrap();
+        git_ok(&repo, &["add", "a.txt"]);
+        git_ok(&repo, &["commit", "-qm", "init"]);
+        repo
+    }
+
+    async fn worker_in(dir: &Path, cwd: &Path) -> (Worker, PathBuf) {
+        let path = dir.join("session.jsonl");
+        let mut file = crate::session_store::SessionFile::create(cwd.to_str().unwrap(), None, 0);
+        file.set_path(path.clone());
+        file.rewrite().unwrap();
+        let worker = Worker::new(
+            WorkerConfig {
+                socket_path: dir.join("worker.sock"),
+                supervisor_socket_path: PathBuf::new(),
+                token: "test-token".into(),
+                worker_instance_id: String::new(),
+                active_session_id: "checkpoint-session".into(),
+                agent_dir: dir.join("agent"),
+                recovery_journal_path: dir.join("recovery.jsonl"),
+                telemetry_disabled: Some(true),
+                script: Some(json!({ "responses": ["done"] })),
+            },
+            None,
+        );
+        let created = worker
+            .dispatch("create", &json!({ "sessionPath": path, "cwd": cwd }))
+            .await;
+        assert!(created.success, "create failed: {created:?}");
+        (worker, path)
+    }
+
+    fn user_entry_id(path: &Path) -> String {
+        std::fs::read_to_string(path)
+            .unwrap()
+            .lines()
+            .filter_map(|line| serde_json::from_str::<Value>(line).ok())
+            .find(|entry| entry["type"] == "message" && entry["message"]["role"] == "user")
+            .and_then(|entry| entry["id"].as_str().map(str::to_string))
+            .expect("a persisted user entry")
+    }
+
+    async fn prompt(worker: &Worker) {
+        let done = worker
+            .dispatch(
+                "prompt_and_wait",
+                &json!({ "activeSessionId": "checkpoint-session", "message": "go" }),
+            )
+            .await;
+        assert!(done.success, "{done:?}");
+    }
+
+    #[tokio::test]
+    async fn a_dirty_turn_leaves_a_checkpoint_that_restores() {
+        let dir = tempfile::tempdir().unwrap();
+        let repo = repo(dir.path());
+        std::fs::write(repo.join("a.txt"), "two\n").unwrap();
+        let (worker, path) = worker_in(dir.path(), &repo).await;
+        prompt(&worker).await;
+
+        let entry_id = user_entry_id(&path);
+        let found = worker
+            .dispatch("get_git_checkpoint", &json!({ "entryId": entry_id }))
+            .await;
+        assert!(found.success, "{found:?}");
+        let checkpoint = found.data.as_ref().unwrap()["checkpoint"].clone();
+        let checkpoint_ref = checkpoint["ref"].as_str().expect("a checkpoint").to_string();
+        assert!(checkpoint_ref.ends_with(&format!("/{entry_id}")), "{checkpoint_ref}");
+        let repos = std::fs::read_to_string(dir.path().join("agent").join(crate::git_checkpoint::REPOS_FILE)).unwrap();
+        assert_eq!(repos.lines().count(), 1, "{repos}");
+
+        git_ok(&repo, &["checkout", "--", "a.txt"]);
+        let restored = worker
+            .dispatch("restore_git_checkpoint", &json!({ "checkpointRef": checkpoint_ref }))
+            .await;
+        assert!(restored.success, "{restored:?}");
+        assert_eq!(std::fs::read_to_string(repo.join("a.txt")).unwrap(), "two\n");
+
+        git_ok(&repo, &["update-ref", "-d", &checkpoint_ref]);
+        let missing = worker
+            .dispatch("restore_git_checkpoint", &json!({ "checkpointRef": checkpoint_ref }))
+            .await;
+        assert!(!missing.success);
+        assert_eq!(missing.error.as_deref(), Some("checkpoint missing"));
+    }
+
+    #[tokio::test]
+    async fn a_clean_turn_leaves_no_checkpoint() {
+        let dir = tempfile::tempdir().unwrap();
+        let repo = repo(dir.path());
+        let (worker, path) = worker_in(dir.path(), &repo).await;
+        prompt(&worker).await;
+        let found = worker
+            .dispatch("get_git_checkpoint", &json!({ "entryId": user_entry_id(&path) }))
+            .await;
+        assert!(found.success, "{found:?}");
+        assert_eq!(found.data.as_ref().unwrap()["checkpoint"], Value::Null);
+        assert!(!dir.path().join("agent").join(crate::git_checkpoint::REPOS_FILE).exists());
+    }
+}
