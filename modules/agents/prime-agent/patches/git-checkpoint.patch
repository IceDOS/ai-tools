@@ -0,0 +1,131 @@
+//! Per-turn git checkpoints: `git stash create` commits kept under `refs/prime-agent/checkpoints/`.
+
+use std::path::Path;
+use std::process::Command;
+
+pub(crate) const REF_PREFIX: &str = "refs/prime-agent/checkpoints/";
+/// One repo top-level per line; the `icedos gc` hook prunes refs of deleted sessions there.
+pub(crate) const REPOS_FILE: &str = "git-checkpoint-repos";
+
+fn git(cwd: &Path, args: &[&str]) -> Option<String> {
+    let output = Command::new("git").arg("-C").arg(cwd).args(args).output().ok()?;
+    output
+        .status
+        .success()
+        .then(|| String::from_utf8_lossy(&output.stdout).trim().to_string())
+}
+
+pub(crate) fn ref_name(session_id: &str, entry_id: &str) -> String {
+    format!("{REF_PREFIX}{session_id}/{entry_id}")
+}
+
+/// The stash commit of the tracked changes; `None` on a clean tree or outside a repo.
+pub(crate) fn snapshot(cwd: &Path) -> Option<String> {
+    git(cwd, &["stash", "create"]).filter(|commit| !commit.is_empty())
+}
+
+pub(crate) fn save(cwd: &Path, ref_name: &str, commit: &str, agent_dir: &Path) -> anyhow::Result<()> {
+    git(cwd, &["update-ref", ref_name, commit])
+        .ok_or_else(|| anyhow::anyhow!("git update-ref {ref_name} failed"))?;
+    if let Some(top) = git(cwd, &["rev-parse", "--show-toplevel"]) {
+        record_repo(agent_dir, &top)?;
+    }
+    Ok(())
+}
+
+fn record_repo(agent_dir: &Path, repo: &str) -> anyhow::Result<()> {
+    use std::io::Write;
+    let path = agent_dir.join(REPOS_FILE);
+    let known = std::fs::read_to_string(&path).unwrap_or_default();
+    if known.lines().any(|line| line == repo) {
+        return Ok(());
+    }
+    std::fs::create_dir_all(agent_dir)?;
+    let mut file = std::fs::OpenOptions::new().create(true).append(true).open(&path)?;
+    writeln!(file, "{repo}")?;
+    Ok(())
+}
+
+pub(crate) fn lookup(cwd: &Path, ref_name: &str) -> Option<String> {
+    let spec = format!("{ref_name}^{{commit}}");
+    git(cwd, &["rev-parse", "--verify", "--quiet", &spec])
+}
+
+/// `git stash apply` of a checkpoint; returns git's output.
+pub(crate) fn restore(cwd: &Path, ref_name: &str) -> anyhow::Result<String> {
+    anyhow::ensure!(ref_name.starts_with(REF_PREFIX), "not a checkpoint ref: {ref_name}");
+    let commit = lookup(cwd, ref_name).ok_or_else(|| anyhow::anyhow!("checkpoint missing"))?;
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(cwd)
+        .args(["stash", "apply", &commit])
+        .output()?;
+    let text = format!(
+        "{}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    )
+    .trim()
+    .to_string();
+    anyhow::ensure!(output.status.success(), "git stash apply failed: {text}");
+    Ok(text)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::process::Command;
+
+    fn git_ok(dir: &Path, args: &[&str]) {
+        let status = Command::new("git").arg("-C").arg(dir).args(args).status().unwrap();
+        assert!(status.success(), "git {args:?}");
+    }
+
+    fn repo() -> tempfile::TempDir {
+        let dir = tempfile::tempdir().unwrap();
+        git_ok(dir.path(), &["init", "-q"]);
+        git_ok(dir.path(), &["config", "user.name", "t"]);
+        git_ok(dir.path(), &["config", "user.email", "t@example.com"]);
+        std::fs::write(dir.path().join("a.txt"), "one\n").unwrap();
+        git_ok(dir.path(), &["add", "a.txt"]);
+        git_ok(dir.path(), &["commit", "-qm", "init"]);
+        dir
+    }
+
+    #[test]
+    fn a_clean_tree_or_a_plain_dir_has_no_snapshot() {
+        let repo = repo();
+        assert_eq!(snapshot(repo.path()), None);
+        let plain = tempfile::tempdir().unwrap();
+        assert_eq!(snapshot(plain.path()), None);
+    }
+
+    #[test]
+    fn a_saved_checkpoint_restores_the_edit_and_records_the_repo_once() {
+        let repo = repo();
+        let agent = tempfile::tempdir().unwrap();
+        std::fs::write(repo.path().join("a.txt"), "two\n").unwrap();
+        let commit = snapshot(repo.path()).expect("dirty tree snapshots");
+        let name = ref_name("s1", "e1");
+        assert_eq!(name, "refs/prime-agent/checkpoints/s1/e1");
+        save(repo.path(), &name, &commit, agent.path()).unwrap();
+        save(repo.path(), &name, &commit, agent.path()).unwrap();
+        assert_eq!(lookup(repo.path(), &name), Some(commit));
+        let repos = std::fs::read_to_string(agent.path().join(REPOS_FILE)).unwrap();
+        assert_eq!(repos.lines().count(), 1, "{repos}");
+
+        git_ok(repo.path(), &["checkout", "--", "a.txt"]);
+        assert_eq!(std::fs::read_to_string(repo.path().join("a.txt")).unwrap(), "one\n");
+        restore(repo.path(), &name).unwrap();
+        assert_eq!(std::fs::read_to_string(repo.path().join("a.txt")).unwrap(), "two\n");
+    }
+
+    #[test]
+    fn restore_refuses_foreign_refs_and_reports_a_missing_one() {
+        let repo = repo();
+        let foreign = restore(repo.path(), "refs/heads/master").unwrap_err();
+        assert!(format!("{foreign:#}").contains("not a checkpoint ref"), "{foreign:#}");
+        let missing = restore(repo.path(), &ref_name("s1", "gone")).unwrap_err();
+        assert_eq!(format!("{missing:#}"), "checkpoint missing");
+    }
+}
