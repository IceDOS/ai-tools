+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn gemini_model() -> Model {
+        serde_json::from_value::<Model>(json!({
+            "id": "gemini-2.5-pro", "name": "Gemini 2.5 Pro",
+            "api": "google-generative-ai", "provider": "google",
+            "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
+            "reasoning": true, "input": ["text"],
+            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
+            "contextWindow": 1_000_000, "maxTokens": 65_536
+        }))
+        .unwrap()
+    }
+
+    #[test]
+    fn system_prompt_is_sent_as_content_parts() {
+        let context = Context {
+            system_prompt: Some("be brief".into()),
+            ..Context::default()
+        };
+        let params = build_params(&gemini_model(), &context, &GoogleOptions::default());
+        assert_eq!(params["systemInstruction"], json!({ "parts": [{ "text": "be brief" }] }));
+    }
+}
