+#[tokio::test]
+async fn clm_projection_survives_resume_after_a_retried_error() {
+    let model = pa_agent::types::Model {
+        id: "m".into(),
+        name: "m".into(),
+        api: "test".into(),
+        provider: "test".into(),
+        base_url: "http://localhost".into(),
+        reasoning: false,
+        cost: pa_agent::types::UsageCost::default(),
+        context_window: 100_000,
+        max_tokens: 1_000,
+        max_tokens_explicit: false,
+    };
+    let tmp = tempfile::tempdir().unwrap();
+    let cwd = tmp.path().join("project");
+    let agent_dir = tmp.path().join("agent");
+    let sessions_dir = tmp.path().join("sessions");
+    for dir in [&cwd, &agent_dir, &sessions_dir] {
+        std::fs::create_dir_all(dir).unwrap();
+    }
+    std::fs::write(
+        agent_dir.join("settings.json"),
+        r#"{ "contextLanguageModels": { "enabled": true } }"#,
+    )
+    .unwrap();
+
+    let provider = Arc::new(ScriptedProvider::new(model.clone()));
+    provider.push_stream_failure_turn("partial", "connection reset by peer");
+    provider.push_text_turn("first answer with dropme text");
+    provider.push_text_turn("second answer");
+    let manager = SessionManager::persisted(&cwd, &sessions_dir);
+    let session_file = manager
+        .get_session_file()
+        .expect("persisted session file")
+        .to_path_buf();
+    let engine = create_session(SessionEngineConfig {
+        cwd: cwd.clone(),
+        agent_dir: agent_dir.clone(),
+        model: Some(model.clone()),
+        stream_fn: Some(provider.stream_fn()),
+        session_manager: Some(manager),
+        ..Default::default()
+    })
+    .await
+    .unwrap();
+
+    let _ = engine.prompt("first turn", PromptOptions::default()).await;
+    engine.session.agent().wait_for_idle().await;
+    engine
+        .session
+        .drop_trailing_assistant(crate::session_engine::TrailingAssistantFilter::ErrorOnly)
+        .await;
+    engine
+        .prompt("retried turn", PromptOptions::default())
+        .await
+        .unwrap();
+    engine.session.agent().wait_for_idle().await;
+
+    let mirror_path = engine.session.clm.as_ref().unwrap().lock().unwrap().mirror_path();
+    let mirror = std::fs::read_to_string(&mirror_path).unwrap();
+    let kept: Vec<&str> = mirror
+        .lines()
+        .filter(|line| !line.contains("dropme") && !line.contains("role=assistant"))
+        .collect();
+    std::fs::write(&mirror_path, kept.join("\n")).unwrap();
+    engine
+        .prompt("third turn", PromptOptions::default())
+        .await
+        .unwrap();
+    engine.session.agent().wait_for_idle().await;
+    drop(engine);
+
+    let resumed_provider = Arc::new(ScriptedProvider::new(model.clone()));
+    resumed_provider.push_text_turn("resumed answer");
+    let resumed = create_session(SessionEngineConfig {
+        cwd: cwd.clone(),
+        agent_dir: agent_dir.clone(),
+        model: Some(model),
+        stream_fn: Some(resumed_provider.stream_fn()),
+        session_manager: Some(SessionManager::open(&cwd, &sessions_dir, &session_file)),
+        ..Default::default()
+    })
+    .await
+    .unwrap();
+    resumed
+        .prompt("fourth turn", PromptOptions::default())
+        .await
+        .unwrap();
+    resumed.session.agent().wait_for_idle().await;
+
+
+    let request = format!("{:?}", resumed_provider.calls()[0].messages);
+    assert!(!request.contains("dropme"), "projection lost on resume: {request}");
+
+    assert!(request.contains("Recovered projection revision 1"), "{request}");
+}
