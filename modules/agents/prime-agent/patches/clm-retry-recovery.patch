+/// Where a retry-error reconciliation found a checkpoint prefix.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RetryRecovery {
+    /// End of the target prefix in the conversation stream.
+    pub source_end: usize,
+    pub removed: usize,
+    /// None when the walk started at the session start.
+    pub anchor_revision: Option<u64>,
+}
+
+fn is_retry_error(message: &Value) -> bool {
+    message["role"] == "assistant" && message["stopReason"] == "error"
+}
+
+/// Match target against raw once failed assistant rows are skipped.
+#[must_use]
+pub fn recover_from_retry_errors(
+    raw: &[Value],
+    target: &Checkpoint,
+    history: &[Checkpoint],
+) -> Option<RetryRecovery> {
+    let conv = conversation_rows(raw);
+    if matches!(apply_projection(raw, Some(target)), Projection::Valid { .. }) {
+        return Some(RetryRecovery {
+            source_end: target.source_message_count,
+            removed: 0,
+            anchor_revision: None,
+        });
+    }
+    let mut anchors: Vec<(usize, Option<u64>)> = history
+        .iter()
+        .filter(|anchor| {
+            anchor.source_message_count <= target.source_message_count
+                && anchor.source_message_count <= conv.len()
+                && digest_messages(&conv[..anchor.source_message_count]) == anchor.source_digest
+        })
+        .map(|anchor| (anchor.source_message_count, Some(anchor.revision)))
+        .collect();
+    anchors.sort_by_key(|a| std::cmp::Reverse(a.0));
+    anchors.push((0, None));
+    for (start, anchor_revision) in anchors {
+        let mut cleaned = conv[..start].to_vec();
+        let (mut end, mut removed) = (start, 0);
+        while cleaned.len() < target.source_message_count && end < conv.len() {
+            if is_retry_error(&conv[end]) {
+                removed += 1;
+            } else {
+                cleaned.push(conv[end].clone());
+            }
+            end += 1;
+        }
+        if removed > 0
+            && cleaned.len() == target.source_message_count
+            && digest_messages(&cleaned) == target.source_digest
+        {
+            return Some(RetryRecovery {
+                source_end: end,
+                removed,
+                anchor_revision,
+            });
+        }
+    }
+    None
+}
