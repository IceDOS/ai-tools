+#[cfg(unix)]
+#[tokio::test]
+async fn venv_bootstrap_never_downloads_a_managed_python() {
+    // The packaged build supplies Python on PATH; `uv python install` would fetch a second one.
+    let dir = tempfile::tempdir().unwrap();
+    let uv = fake_uv(
+        dir.path(),
+        &format!(
+            "#!/bin/sh\nprintf '%s\\n' \"$*\" >> {}\nexit 0\n",
+            dir.path().join("uv.log").display()
+        ),
+    );
+    let venv = dir.path().join("venv");
+    // The fake uv creates nothing; the real `uv venv` makes this directory.
+    std::fs::create_dir_all(&venv).unwrap();
+    let source_dir = require_runtime_source_dir().unwrap();
+    let runtime_identity = hash_runtime_source(&source_dir).unwrap();
+    bootstrap_venv_with_uv(
+        uv.to_str().unwrap(),
+        &venv,
+        &source_dir,
+        &runtime_identity,
+        &[],
+        &EnsureKernelPythonOptions::default(),
+    )
+    .await
+    .unwrap();
+    let calls = uv_invocations(dir.path());
+    assert!(
+        calls.iter().all(|call| !call.starts_with("python install")),
+        "no managed Python download: {calls:?}"
+    );
+    assert!(
+        calls[0].starts_with("venv ") && calls[0].contains(&format!("--python {PYTHON_VERSION}")),
+        "the venv is created first, from the requested version: {calls:?}"
+    );
+}
