+    pub agent_end: Option<Vec<LifecycleHookEntry>>,
+    /// Failed or aborted runs; when unset, `agentEnd` fires for them too.
+    pub agent_error: Option<Vec<LifecycleHookEntry>>,
+    /// Also fire inside RLM child sessions (default false).
+    pub include_subagents: Option<bool>,
+}
