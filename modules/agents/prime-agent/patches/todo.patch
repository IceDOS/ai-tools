+"""Session todo list over the kernel host bridge (todo.* requests)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from rlm import host_request
+
+
+async def list() -> dict[str, Any]:  # noqa: A001 - the skill's public name
+    return await host_request("todo.list")
+
+
+async def add(text: str) -> dict[str, Any]:
+    if not text.strip():
+        raise ValueError("text must not be empty")
+    return await host_request("todo.add", {"text": text})
+
+
+async def toggle(id: int) -> dict[str, Any]:
+    return await host_request("todo.toggle", {"id": int(id)})
+
+
+async def clear() -> dict[str, Any]:
+    return await host_request("todo.clear")
