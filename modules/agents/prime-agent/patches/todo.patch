+//! The session todo list. A `todo` custom entry holds the whole list; the latest one on the branch wins.
+
+use serde::{Deserialize, Serialize};
+
+pub const TODO_CUSTOM_TYPE: &str = "todo";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct TodoItem {
+    pub id: u64,
+    pub text: String,
+    pub done: bool,
+}
+
+/// One line per item, `[x] 2 text` when done; `No todos` for an empty list.
+#[must_use]
+pub fn format_lines(items: &[TodoItem]) -> Vec<String> {
+    if items.is_empty() {
+        return vec!["No todos".to_string()];
+    }
+    items
+        .iter()
+        .map(|item| format!("[{}] {} {}", if item.done { "x" } else { " " }, item.id, item.text))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lines_mark_done_items_and_name_an_empty_list() {
+        let items = vec![
+            TodoItem { id: 1, text: "write the plan".into(), done: false },
+            TodoItem { id: 2, text: "run the tests".into(), done: true },
+        ];
+        assert_eq!(format_lines(&items), vec!["[ ] 1 write the plan", "[x] 2 run the tests"]);
+        assert_eq!(format_lines(&[]), vec!["No todos"]);
+    }
+
+    #[test]
+    fn items_use_the_wire_shape() {
+        let item: TodoItem = serde_json::from_str(r#"{"id":3,"text":"t","done":false}"#).unwrap();
+        assert_eq!(serde_json::to_string(&item).unwrap(), r#"{"id":3,"text":"t","done":false}"#);
+    }
+}
