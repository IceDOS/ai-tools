@@ -0,0 +1,40 @@
+import asyncio
+import importlib.util
+import sys
+import types
+from pathlib import Path
+from unittest.mock import AsyncMock
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[1] / "src" / "todo" / "__init__.py"
+
+
+def load(host):
+    sys.modules["rlm"] = types.SimpleNamespace(host_request=host)
+    spec = importlib.util.spec_from_file_location("todo", SRC)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_calls_map_to_todo_requests():
+    host = AsyncMock(return_value={"items": [], "text": "No todos"})
+    todo = load(host)
+    asyncio.run(todo.add("write the plan"))
+    asyncio.run(todo.toggle(1))
+    asyncio.run(todo.list())
+    asyncio.run(todo.clear())
+    calls = [call.args for call in host.await_args_list]
+    assert calls == [
+        ("todo.add", {"text": "write the plan"}),
+        ("todo.toggle", {"id": 1}),
+        ("todo.list",),
+        ("todo.clear",),
+    ]
+
+
+def test_add_refuses_empty_text():
+    todo = load(AsyncMock(return_value={}))
+    with pytest.raises(ValueError):
+        asyncio.run(todo.add("   "))
