--- /dev/null
+++ prime-agent-src/crates/pa-core/src/todo.rs
@@ -0,0 +1,172 @@
+//! `todo.*` kernel host requests behind the `todo` skill.
+
+use std::sync::Arc;
+
+use anyhow::{anyhow, bail};
+use serde_json::{json, Value};
+
+use crate::kernel::shared::{host_handler, HostRequestHandlers};
+use crate::session::manager::SessionManager;
+use pa_types::session::FileEntry;
+use pa_types::todo::{format_lines, TodoItem, TODO_CUSTOM_TYPE};
+
+const CALLS: [&str; 4] = ["todo.list", "todo.add", "todo.toggle", "todo.clear"];
+
+/// The list from the latest `todo` entry on the active branch.
+#[must_use]
+pub fn current(session: &SessionManager) -> Vec<TodoItem> {
+    session
+        .active_branch_entries()
+        .into_iter()
+        .rev()
+        .find_map(|entry| match entry {
+            FileEntry::Custom { payload, .. } if payload.custom_type == TODO_CUSTOM_TYPE => Some(
+                payload
+                    .data
+                    .clone()
+                    .and_then(|data| serde_json::from_value(data).ok())
+                    .unwrap_or_default(),
+            ),
+            _ => None,
+        })
+        .unwrap_or_default()
+}
+
+fn save(session: &mut SessionManager, items: &[TodoItem]) -> anyhow::Result<()> {
+    session.append_custom_entry(TODO_CUSTOM_TYPE, Some(serde_json::to_value(items)?))?;
+    Ok(())
+}
+
+/// Record an empty list on the active branch.
+///
+/// # Errors
+///
+/// Returns the session write error.
+pub fn clear(session: &mut SessionManager) -> anyhow::Result<()> {
+    save(session, &[])
+}
+
+fn reply(items: &[TodoItem]) -> Value {
+    json!({ "items": items, "text": format_lines(items).join("\n") })
+}
+
+/// One `todo.*` request. Errors reach Python as `RuntimeError`.
+///
+/// # Errors
+///
+/// Returns an error for empty text, an unknown id, an unknown request or a failed write.
+pub fn handle(request_type: &str, payload: &Value, session: &mut SessionManager) -> anyhow::Result<Value> {
+    let mut items = current(session);
+    match request_type {
+        "todo.list" => Ok(reply(&items)),
+        "todo.add" => {
+            let text = payload["text"]
+                .as_str()
+                .map(str::trim)
+                .filter(|text| !text.is_empty())
+                .ok_or_else(|| anyhow!("todo.add needs non-empty text"))?;
+            let id = items.iter().map(|item| item.id).max().unwrap_or(0) + 1;
+            items.push(TodoItem { id, text: text.to_string(), done: false });
+            save(session, &items)?;
+            let mut value = reply(&items);
+            value["id"] = json!(id);
+            Ok(value)
+        }
+        "todo.toggle" => {
+            let id = payload["id"]
+                .as_u64()
+                .ok_or_else(|| anyhow!("todo.toggle needs an integer id"))?;
+            let item = items
+                .iter_mut()
+                .find(|item| item.id == id)
+                .ok_or_else(|| anyhow!("Todo {id} is not on the list."))?;
+            item.done = !item.done;
+            save(session, &items)?;
+            Ok(reply(&items))
+        }
+        "todo.clear" => {
+            clear(session)?;
+            Ok(reply(&[]))
+        }
+        other => bail!("unknown todo request type \"{other}\""),
+    }
+}
+
+/// Register every `todo.*` call on the session's host bridge.
+#[allow(clippy::needless_pass_by_value)]
+pub fn register(handlers: &mut HostRequestHandlers, session: Arc<tokio::sync::Mutex<SessionManager>>) {
+    for name in CALLS {
+        let session = session.clone();
+        handlers.register(
+            name,
+            host_handler(move |payload| {
+                let session = session.clone();
+                Box::pin(async move {
+                    let mut session = session.lock().await;
+                    handle(name, &payload.data, &mut session)
+                })
+            }),
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn session() -> SessionManager {
+        SessionManager::in_memory(std::path::Path::new("/tmp"))
+    }
+
+    #[test]
+    fn add_toggle_list_and_clear_round_trip() {
+        let mut session = session();
+        let first = handle("todo.add", &json!({ "text": "  write the plan " }), &mut session).unwrap();
+        assert_eq!(first["id"], 1);
+        handle("todo.add", &json!({ "text": "run the tests" }), &mut session).unwrap();
+        let toggled = handle("todo.toggle", &json!({ "id": 1 }), &mut session).unwrap();
+        assert_eq!(toggled["text"], "[x] 1 write the plan\n[ ] 2 run the tests");
+        let listed = handle("todo.list", &json!({}), &mut session).unwrap();
+        assert_eq!(listed["items"][1]["text"], "run the tests");
+        let cleared = handle("todo.clear", &json!({}), &mut session).unwrap();
+        assert_eq!(cleared["text"], "No todos");
+        assert!(current(&session).is_empty());
+        let next = handle("todo.add", &json!({ "text": "again" }), &mut session).unwrap();
+        assert_eq!(next["id"], 1);
+    }
+
+    #[test]
+    fn bad_requests_are_errors() {
+        let mut session = session();
+        assert!(handle("todo.add", &json!({ "text": "   " }), &mut session).is_err());
+        assert_eq!(
+            handle("todo.toggle", &json!({ "id": 9 }), &mut session).unwrap_err().to_string(),
+            "Todo 9 is not on the list."
+        );
+        assert!(handle("todo.toggle", &json!({ "id": "x" }), &mut session).is_err());
+        assert!(handle("todo.bogus", &json!({}), &mut session).is_err());
+    }
+
+    #[test]
+    fn the_list_follows_the_branch() {
+        let mut session = session();
+        handle("todo.add", &json!({ "text": "on main" }), &mut session).unwrap();
+        let fork_point = session.get_leaf_id().unwrap().to_string();
+        handle("todo.add", &json!({ "text": "later" }), &mut session).unwrap();
+        assert_eq!(current(&session).len(), 2);
+        session.branch(&fork_point);
+        let items = current(&session);
+        assert_eq!(items.len(), 1);
+        assert_eq!(items[0].text, "on main");
+    }
+
+    #[tokio::test]
+    async fn register_answers_every_call() {
+        let session = Arc::new(tokio::sync::Mutex::new(session()));
+        let mut handlers = HostRequestHandlers::new();
+        register(&mut handlers, session);
+        for name in CALLS {
+            assert!(handlers.get(name).is_some(), "{name} is not registered");
+        }
+    }
+}
