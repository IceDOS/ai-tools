@@ -0,0 +1,172 @@
+//! `get_todos` and `todo_clear`: the `/todos` command's daemon side.
+
+use serde_json::{json, Value};
+
+use crate::protocol::{response_failure, response_success, DaemonResponse};
+use crate::session_store::SessionFile;
+use crate::worker::Worker;
+use pa_types::todo::{TodoItem, TODO_CUSTOM_TYPE};
+
+/// The list from the latest `todo` row on the worker file's active branch.
+fn latest_todos(store: &SessionFile) -> Vec<TodoItem> {
+    store
+        .branch()
+        .into_iter()
+        .rev()
+        .find(|entry| entry.type_ == "custom" && entry.fields["customType"] == TODO_CUSTOM_TYPE)
+        .and_then(|entry| serde_json::from_value(entry.fields["data"].clone()).ok())
+        .unwrap_or_default()
+}
+
+impl Worker {
+    fn todo_items(&self) -> Value {
+        let core = self.core.lock().unwrap();
+        json!({ "items": core.store.as_ref().map(latest_todos).unwrap_or_default() })
+    }
+
+    pub(crate) fn handle_get_todos(&self) -> DaemonResponse {
+        if let Err(response) = self.require_created("get_todos") {
+            return response;
+        }
+        response_success(None, "get_todos", Some(self.todo_items()))
+    }
+
+    pub(crate) async fn handle_todo_clear(&self) -> DaemonResponse {
+        if let Err(response) = self.require_created("todo_clear") {
+            return response;
+        }
+        let through_engine = match &self.agent_engine {
+            Some(engine) => match engine.todo_clear().await {
+                Ok(done) => done,
+                Err(error) => return response_failure(None, "todo_clear", &format!("{error:#}"), None),
+            },
+            None => false,
+        };
+        if through_engine {
+            // `dispatch` drains the engine outbox after this command; drain now so the reply sees the row.
+            let entries = self.engine.take_durable_custom_entries();
+            crate::worker::persist_durable_custom_entries(&mut self.core.lock().unwrap(), entries);
+        } else if let Some(store) = self.core.lock().unwrap().store.as_mut() {
+            if let Err(error) = store.persist_entry(
+                "custom",
+                json!({ "customType": TODO_CUSTOM_TYPE, "data": [] }),
+            ) {
+                return response_failure(None, "todo_clear", &format!("{error:#}"), None);
+            }
+        }
+        response_success(None, "todo_clear", Some(self.todo_items()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::path::{Path, PathBuf};
+
+    use serde_json::json;
+
+    use super::*;
+    use crate::worker::WorkerConfig;
+
+    fn todo_worker(dir: &Path, agent: &str) -> Worker {
+        let agent_dir = dir.join(agent);
+        std::fs::create_dir_all(&agent_dir).unwrap();
+        Worker::new(
+            WorkerConfig {
+                socket_path: dir.join(format!("{agent}.sock")),
+                supervisor_socket_path: PathBuf::new(),
+                token: "test-token".into(),
+                worker_instance_id: String::new(),
+                active_session_id: "todo-session".into(),
+                agent_dir,
+                recovery_journal_path: dir.join(format!("{agent}-recovery.jsonl")),
+                telemetry_disabled: Some(true),
+                script: Some(json!({ "engine": "faux", "responses": [] })),
+            },
+            None,
+        )
+    }
+
+    fn session_with_one_todo(dir: &Path) -> PathBuf {
+        let path = dir.join("todos.jsonl");
+        let mut file = crate::session_store::SessionFile::create("/tmp", None, 0);
+        file.append_entry(
+            "custom",
+            json!({ "customType": "todo", "data": [{ "id": 1, "text": "write the plan", "done": false }] }),
+        );
+        file.set_path(path.clone());
+        file.rewrite().unwrap();
+        path
+    }
+
+    async fn open(worker: &Worker, path: &Path) {
+        let created = worker
+            .dispatch("create", &json!({ "sessionPath": path, "cwd": "/tmp" }))
+            .await;
+        assert!(created.success, "create failed: {created:?}");
+    }
+
+    fn todo_rows(path: &Path) -> usize {
+        std::fs::read_to_string(path)
+            .unwrap()
+            .matches(r#""customType":"todo""#)
+            .count()
+    }
+
+    #[tokio::test]
+    async fn get_todos_reads_the_file_before_the_kernel_starts() {
+        let _faux = crate::agent_engine::FAUX_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let dir = tempfile::tempdir().unwrap();
+        let path = session_with_one_todo(dir.path());
+        let worker = todo_worker(dir.path(), "agent-a");
+        open(&worker, &path).await;
+        let listed = worker.dispatch("get_todos", &json!({})).await;
+        assert!(listed.success, "{listed:?}");
+        assert_eq!(
+            listed.data.unwrap()["items"],
+            json!([{ "id": 1, "text": "write the plan", "done": false }])
+        );
+    }
+
+    #[tokio::test]
+    async fn todo_clear_without_an_engine_session_writes_the_file() {
+        let _faux = crate::agent_engine::FAUX_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let dir = tempfile::tempdir().unwrap();
+        let path = session_with_one_todo(dir.path());
+        let worker = todo_worker(dir.path(), "agent-a");
+        open(&worker, &path).await;
+        let cleared = worker.dispatch("todo_clear", &json!({})).await;
+        assert!(cleared.success, "{cleared:?}");
+        assert_eq!(cleared.data.unwrap()["items"], json!([]));
+        assert_eq!(todo_rows(&path), 2);
+        let listed = worker.dispatch("get_todos", &json!({})).await;
+        assert_eq!(listed.data.unwrap()["items"], json!([]));
+    }
+
+    /// The engine path: the G0 outbox carries the `todo` row to the file, and a second worker sees it.
+    #[tokio::test]
+    async fn todo_clear_through_the_engine_survives_a_second_worker() {
+        let _faux = crate::agent_engine::FAUX_TEST_LOCK
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let dir = tempfile::tempdir().unwrap();
+        let path = session_with_one_todo(dir.path());
+        let first = todo_worker(dir.path(), "agent-a");
+        open(&first, &path).await;
+        let engine = first.agent_engine.as_ref().expect("agent engine");
+        let model = engine.resolve_model().expect("model");
+        engine.ensure_core_session_async(&model).await.expect("session built");
+        let cleared = first.dispatch("todo_clear", &json!({})).await;
+        assert!(cleared.success, "{cleared:?}");
+        assert_eq!(todo_rows(&path), 2);
+        drop(first);
+
+        let second = todo_worker(dir.path(), "agent-b");
+        open(&second, &path).await;
+        let listed = second.dispatch("get_todos", &json!({})).await;
+        assert_eq!(listed.data.unwrap()["items"], json!([]));
+    }
+}
