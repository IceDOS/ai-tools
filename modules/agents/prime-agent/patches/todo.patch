+//! `/todos`: the session todo list; `/todos clear` empties it.
+
+use std::time::Duration;
+
+use anyhow::Result;
+use serde_json::{Map, Value};
+
+use pa_types::daemon::DaemonCommand;
+use pa_types::todo::{format_lines, TodoItem};
+
+use super::AgentView;
+use crate::session_ui::UI_REQUEST_TIMEOUT_MS;
+
+const USAGE: &str = "Usage: /todos [clear]";
+
+fn reply_lines(data: &Value, cleared: bool) -> Result<Vec<String>> {
+    let items: Vec<TodoItem> = serde_json::from_value(
+        data.get("items").cloned().ok_or_else(|| anyhow::anyhow!("reply has no items"))?,
+    )?;
+    Ok(if cleared { vec!["Todo list cleared".to_string()] } else { format_lines(&items) })
+}
+
+impl super::SessionUi {
+    pub(crate) async fn handle_todos_command(&mut self, args: &str, view: &mut AgentView) -> Result<()> {
+        let active_session_id = self.active_session_id.clone();
+        let command = match args {
+            "" => DaemonCommand::GetTodos { id: None, active_session_id, rest: Map::default() },
+            "clear" => DaemonCommand::TodoClear { id: None, active_session_id, rest: Map::default() },
+            _ => {
+                self.error_row(USAGE, view);
+                return Ok(());
+            }
+        };
+        let reply = self
+            .bounded_request(Duration::from_millis(UI_REQUEST_TIMEOUT_MS), command)
+            .await
+            .and_then(|data| reply_lines(&data, args == "clear"));
+        match reply {
+            Ok(lines) => {
+                for line in lines {
+                    self.plain_row(&line, view);
+                }
+            }
+            Err(error) => self.error_row(&format!("{error:#}"), view),
+        }
+        self.dirty = true;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::reply_lines;
+    use serde_json::json;
+
+    #[test]
+    fn the_reply_prints_one_row_per_item() {
+        let data = json!({ "items": [{ "id": 1, "text": "write the plan", "done": true }] });
+        assert_eq!(reply_lines(&data, false).unwrap(), vec!["[x] 1 write the plan"]);
+        assert_eq!(reply_lines(&json!({ "items": [] }), false).unwrap(), vec!["No todos"]);
+        assert_eq!(reply_lines(&json!({ "items": [] }), true).unwrap(), vec!["Todo list cleared"]);
+        assert!(reply_lines(&json!({}), false).is_err());
+    }
+}
