+//! `clm.*` kernel host requests behind the `live-context` skill.
+
+use std::sync::Arc;
+
+use anyhow::{anyhow, bail};
+use serde_json::{json, Value};
+
+use super::annotations::{
+    self, ActiveAnnotation, Annotation, Retention, SourceRef, ANNOTATION_CUSTOM_TYPE,
+    MAX_PIN_SOURCE_TOKENS,
+};
+use super::document::estimate_tokens;
+use super::SharedClm;
+use crate::kernel::shared::{host_handler, HostRequestHandlers};
+use crate::session::manager::SessionManager;
+use pa_types::session::FileEntry;
+
+pub const CLM_OFF: &str = "Context Language Models are off in this session";
+const CALLS: [&str; 4] = ["clm.annotate", "clm.resolve", "clm.list", "clm.recall"];
+
+fn entry_message(entry: &FileEntry) -> Option<Value> {
+    match entry {
+        FileEntry::Message { message, .. } => serde_json::to_value(message).ok(),
+        _ => None,
+    }
+}
+
+fn branch_annotations(session: &SessionManager) -> Vec<Annotation> {
+    let data: Vec<Value> = session
+        .get_branch(None)
+        .into_iter()
+        .filter_map(|entry| match entry {
+            FileEntry::Custom { payload, .. } if payload.custom_type == ANNOTATION_CUSTOM_TYPE => {
+                payload.data.clone()
+            }
+            _ => None,
+        })
+        .collect();
+    annotations::rebuild(&data)
+}
+
+fn verified_source(session: &SessionManager, annotation: &Annotation) -> Result<Value, String> {
+    let id = &annotation.source.entry_id;
+    let message = session
+        .get_entry_by_id(id)
+        .and_then(entry_message)
+        .ok_or_else(|| format!("Source entry {id} is unavailable."))?;
+    if annotations::content_hash(&message) != annotation.source.content_hash {
+        return Err(format!("Source entry {id} failed its content-hash check."));
+    }
+    Ok(message)
+}
+
+/// Push the branch's active annotations, with pin texts, into the runtime.
+pub fn refresh(clm: &SharedClm, session: &SessionManager) {
+    let active: Vec<ActiveAnnotation> = branch_annotations(session)
+        .into_iter()
+        .filter(|annotation| annotation.resolved_at.is_none())
+        .map(|annotation| {
+            let pinned = (annotation.retention == Retention::Pin).then(|| {
+                verified_source(session, &annotation).map(|message| annotations::source_text(&message))
+            });
+            ActiveAnnotation { annotation, pinned }
+        })
+        .collect();
+    clm.lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .set_annotations(active);
+}
+
+fn text<'a>(payload: &'a Value, key: &str) -> anyhow::Result<&'a str> {
+    payload[key]
+        .as_str()
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| anyhow!("{key} is required and must be a non-empty string"))
+}
+
+/// Resolve `source` to (entry id, message): a session entry id on the active
+/// branch, or a `CTX_TURN` block id from the current mirror.
+fn resolve_source(
+    source: &str,
+    clm: &SharedClm,
+    session: &SessionManager,
+) -> anyhow::Result<(String, Value)> {
+    let branch = session.get_branch(None);
+    if let Some(found) = branch
+        .iter()
+        .find(|entry| entry.id() == Some(source))
+        .and_then(|entry| entry_message(entry))
+    {
+        return Ok((source.to_string(), found));
+    }
+    let block = clm
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .block_source(source)
+        .ok_or_else(|| anyhow!("Source {source} is neither a message entry on the active branch nor a block in the current live-context mirror."))?;
+    branch
+        .iter()
+        .find_map(|entry| {
+            let message = entry_message(entry)?;
+            let id = entry.id()?;
+            annotations::same_message(&message, &block)
+                .then(|| (id.to_string(), message))
+        })
+        .ok_or_else(|| anyhow!("Block {source} has no session entry (it is a model-written note). Annotate the original message by its entry id."))
+}
+
+/// One `clm.*` request. Errors reach Python as `RuntimeError`.
+///
+/// # Errors
+///
+/// Returns an error if CLM is off or the request payload is invalid.
+pub fn handle(
+    request_type: &str,
+    payload: &Value,
+    clm: Option<&SharedClm>,
+    session: &mut SessionManager,
+) -> anyhow::Result<Value> {
+    let Some(clm) = clm else { bail!(CLM_OFF) };
+    let mut all = branch_annotations(session);
+    match request_type {
+        "clm.list" => Ok(json!({ "text": annotations::format_list(&all), "annotations": all })),
+        "clm.recall" => {
+            let id = text(payload, "id")?;
+            let annotation = all
+                .iter()
+                .find(|known| known.id == id)
+                .ok_or_else(|| anyhow!("Annotation {id} is not on the active branch."))?;
+            let message = verified_source(session, annotation).map_err(|reason| anyhow!(reason))?;
+            let max_tokens = annotations::clamp_recall(payload["maxTokens"].as_u64());
+            let (text, truncated) = annotations::format_recall(
+                annotation,
+                &annotations::source_text(&message),
+                max_tokens,
+            );
+            Ok(json!({ "text": text, "truncated": truncated }))
+        }
+        "clm.resolve" => {
+            let id = text(payload, "id")?;
+            let annotation = all
+                .iter_mut()
+                .find(|known| known.id == id)
+                .ok_or_else(|| anyhow!("Annotation {id} is not on the active branch."))?;
+            if annotation.resolved_at.is_some() {
+                bail!("Annotation {id} is already resolved.");
+            }
+            annotation.resolved_at = Some(annotations::now_iso());
+            annotation.resolution = payload["resolution"]
+                .as_str()
+                .map(|note| note.split_whitespace().collect::<Vec<_>>().join(" "))
+                .filter(|note| !note.is_empty());
+            let resolved = annotation.clone();
+            session.append_custom_entry(ANNOTATION_CUSTOM_TYPE, Some(serde_json::to_value(&resolved)?))?;
+            refresh(clm, session);
+            Ok(json!({ "text": format!("Resolved {}: {}", resolved.id, resolved.title), "annotation": resolved }))
+        }
+        "clm.annotate" => {
+            let source = text(payload, "source")?;
+            let retention: Retention = serde_json::from_value(payload["retention"].clone())
+                .map_err(|_| anyhow!("retention must be pin, continuity or archive"))?;
+            let (title, reason, future_action) = (
+                text(payload, "title")?.to_string(),
+                text(payload, "reason")?.to_string(),
+                text(payload, "futureAction")?.to_string(),
+            );
+            let (entry_id, message) = resolve_source(source, clm, session)?;
+            if retention == Retention::Pin {
+                let tokens = estimate_tokens(std::slice::from_ref(&message));
+                if tokens > MAX_PIN_SOURCE_TOKENS {
+                    bail!("The source is about {tokens} tokens; pin is limited to {MAX_PIN_SOURCE_TOKENS}. Use continuity or archive instead.");
+                }
+            }
+            let revision = clm
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .revision();
+            let annotation = Annotation {
+                id: annotations::new_id(&all),
+                source: SourceRef {
+                    session_id: session.get_session_id().to_string(),
+                    entry_id,
+                    revision,
+                    content_hash: annotations::content_hash(&message),
+                    role: message["role"].as_str().unwrap_or("").to_string(),
+                },
+                title,
+                reason,
+                future_action,
+                retention,
+                created_at: annotations::now_iso(),
+                resolved_at: None,
+                resolution: None,
+            };
+            session.append_custom_entry(ANNOTATION_CUSTOM_TYPE, Some(serde_json::to_value(&annotation)?))?;
+            refresh(clm, session);
+            Ok(json!({
+                "id": annotation.id,
+                "text": format!(
+                    "Created {} annotation {} for {} entry {}.",
+                    annotation.retention.label(), annotation.id, annotation.source.role, annotation.source.entry_id
+                ),
+            }))
+        }
+        other => bail!("unknown clm request type \"{other}\""),
+    }
+}
+
+/// Register every `clm.*` call; with CLM off each one answers [`CLM_OFF`].
+#[allow(clippy::needless_pass_by_value)]
+pub fn register(
+    handlers: &mut HostRequestHandlers,
+    clm: Option<SharedClm>,
+    session: Arc<tokio::sync::Mutex<SessionManager>>,
+) {
+    for name in CALLS {
+        let clm = clm.clone();
+        let session = session.clone();
+        handlers.register(
+            name,
+            host_handler(move |payload| {
+                let clm = clm.clone();
+                let session = session.clone();
+                Box::pin(async move {
+                    let mut session = session.lock().await;
+                    handle(name, &payload.data, clm.as_ref(), &mut session)
+                })
+            }),
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::clm::{ClmConfig, ClmRuntime};
+
+    fn runtime() -> SharedClm {
+        let config = ClmConfig::from_settings(&serde_json::from_value(json!({})).unwrap()).unwrap();
+        Arc::new(std::sync::Mutex::new(ClmRuntime::new(config, "s").unwrap()))
+    }
+
+    fn session_with_user(text: &str) -> (SessionManager, String) {
+        let mut session = SessionManager::in_memory(std::path::Path::new("/tmp"));
+        let message: pa_types::session::AgentMessage =
+            serde_json::from_value(json!({ "role": "user", "content": text, "timestamp": 7 })).unwrap();
+        let id = session.append_message(message).unwrap();
+        (session, id)
+    }
+
+    #[test]
+    fn every_call_reports_clm_off() {
+        let (mut session, _) = session_with_user("hi");
+        for name in CALLS {
+            let error = handle(name, &json!({}), None, &mut session).unwrap_err();
+            assert_eq!(error.to_string(), CLM_OFF);
+        }
+    }
+
+    #[test]
+    fn annotate_list_recall_resolve_round_trip() {
+        let clm = runtime();
+        let (mut session, entry) = session_with_user("never push to main");
+        let created = handle(
+            "clm.annotate",
+            &json!({ "source": entry, "title": "branch rule", "reason": "user rule", "futureAction": "use a branch", "retention": "pin" }),
+            Some(&clm),
+            &mut session,
+        )
+        .unwrap();
+        let id = created["id"].as_str().unwrap().to_string();
+        let output = clm.lock().unwrap().transform(&[], 0, 100_000);
+        assert!(output[0]["content"].as_str().unwrap().contains("never push to main"));
+
+        let listed = handle("clm.list", &json!({}), Some(&clm), &mut session).unwrap();
+        assert!(listed["text"].as_str().unwrap().contains(&id));
+        let recalled = handle("clm.recall", &json!({ "id": id }), Some(&clm), &mut session).unwrap();
+        assert!(recalled["text"].as_str().unwrap().ends_with("never push to main"));
+
+        handle("clm.resolve", &json!({ "id": id, "resolution": "done" }), Some(&clm), &mut session).unwrap();
+        let output = clm.lock().unwrap().transform(&[], 0, 100_000);
+        assert!(output.is_empty(), "resolved annotations are not rendered");
+        let again = handle("clm.resolve", &json!({ "id": id }), Some(&clm), &mut session).unwrap_err();
+        assert!(again.to_string().contains("already resolved"));
+    }
