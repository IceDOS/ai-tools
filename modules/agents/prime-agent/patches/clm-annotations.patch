+import asyncio
+import importlib.util
+import sys
+import types
+from pathlib import Path
+from unittest.mock import AsyncMock
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[1] / "src" / "live_context" / "__init__.py"
+
+
+def load(host):
+    sys.modules["rlm"] = types.SimpleNamespace(host_request=host)
+    spec = importlib.util.spec_from_file_location("live_context", SRC)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_calls_map_to_clm_requests():
+    host = AsyncMock(return_value={"ok": True})
+    lc = load(host)
+    asyncio.run(lc.annotate("e1", "t", "r", "f", "pin"))
+    asyncio.run(lc.resolve("lc-1"))
+    asyncio.run(lc.resolve("lc-1", "done"))
+    asyncio.run(lc.list())
+    asyncio.run(lc.recall("lc-1"))
+    calls = [call.args for call in host.await_args_list]
+    assert calls == [
+        ("clm.annotate", {"source": "e1", "title": "t", "reason": "r", "futureAction": "f", "retention": "pin"}),
+        ("clm.resolve", {"id": "lc-1"}),
+        ("clm.resolve", {"id": "lc-1", "resolution": "done"}),
+        ("clm.list",),
+        ("clm.recall", {"id": "lc-1", "maxTokens": 2000}),
+    ]
+
+
+def test_recall_clamps_and_annotate_checks_retention():
+    host = AsyncMock(return_value={})
+    lc = load(host)
+    asyncio.run(lc.recall("a", 5))
+    asyncio.run(lc.recall("a", 99999))
+    assert [call.args[1]["maxTokens"] for call in host.await_args_list] == [128, 8000]
+    with pytest.raises(ValueError):
+        asyncio.run(lc.annotate("e1", "t", "r", "f", "forever"))
