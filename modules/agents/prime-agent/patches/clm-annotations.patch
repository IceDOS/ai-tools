@@ -0,0 +1,33 @@
+"""Live-context annotations over the kernel host bridge (clm.* requests)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from rlm import host_request
+
+RETENTIONS = ("pin", "continuity", "archive")
+
+
+async def annotate(source: str, title: str, reason: str, future_action: str, retention: str) -> dict[str, Any]:
+    if retention not in RETENTIONS:
+        raise ValueError(f"retention must be one of {', '.join(RETENTIONS)}")
+    return await host_request(
+        "clm.annotate",
+        {"source": source, "title": title, "reason": reason, "futureAction": future_action, "retention": retention},
+    )
+
+
+async def resolve(id: str, resolution: str | None = None) -> dict[str, Any]:
+    payload: dict[str, Any] = {"id": id}
+    if resolution is not None:
+        payload["resolution"] = resolution
+    return await host_request("clm.resolve", payload)
+
+
+async def list() -> dict[str, Any]:  # noqa: A001 - the skill's public name
+    return await host_request("clm.list")
+
+
+async def recall(id: str, max_tokens: int = 2000) -> dict[str, Any]:
+    return await host_request("clm.recall", {"id": id, "maxTokens": max(128, min(8000, int(max_tokens)))})
