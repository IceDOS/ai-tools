+//! Continuity annotations (pi-clm `continuity.ts`): durable pointers to exact
+//! session entries, kept as `clm-annotation` custom entries on the branch.
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+use super::document::{canonical_message, digest_messages, estimate_text_tokens, render_message};
+
+pub const ANNOTATION_CUSTOM_TYPE: &str = "clm-annotation";
+pub const MAX_PIN_SOURCE_TOKENS: u64 = 8_000;
+pub const DEFAULT_RECALL_TOKENS: u64 = 2_000;
+pub const MIN_RECALL_TOKENS: u64 = 128;
+pub const MAX_RECALL_TOKENS: u64 = 8_000;
+pub const CONTINUITY_WARNING_TOKENS: u64 = 8_000;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Retention {
+    Pin,
+    Continuity,
+    Archive,
+}
+
+impl Retention {
+    #[must_use]
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Pin => "pin",
+            Self::Continuity => "continuity",
+            Self::Archive => "archive",
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SourceRef {
+    pub session_id: String,
+    pub entry_id: String,
+    pub revision: u64,
+    pub content_hash: String,
+    pub role: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Annotation {
+    pub id: String,
+    pub source: SourceRef,
+    pub title: String,
+    pub reason: String,
+    pub future_action: String,
+    pub retention: Retention,
+    pub created_at: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub resolved_at: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub resolution: Option<String>,
+}
+
+/// An unresolved annotation plus, for a pin, its source text or why it is unavailable.
+#[derive(Debug, Clone, PartialEq)]
+pub struct ActiveAnnotation {
+    pub annotation: Annotation,
+    pub pinned: Option<Result<String, String>>,
+}
+
+/// Latest entry per id wins; order is first appearance. Unparseable data is skipped.
+pub fn rebuild<'a>(data: impl IntoIterator<Item = &'a Value>) -> Vec<Annotation> {
+    let mut out: Vec<Annotation> = Vec::new();
+    for value in data {
+        let Ok(annotation) = serde_json::from_value::<Annotation>(value.clone()) else {
+            continue;
+        };
+        match out.iter_mut().find(|known| known.id == annotation.id) {
+            Some(known) => *known = annotation,
+            None => out.push(annotation),
+        }
+    }
+    out
+}
+
+#[must_use]
+pub fn content_hash(message: &Value) -> String {
+    digest_messages(std::slice::from_ref(message))
+}
+
+#[must_use]
+pub fn new_id(existing: &[Annotation]) -> String {
+    let mut salt = 0u64;
+    loop {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |elapsed| elapsed.as_nanos());
+        let id = format!("lc-{}", &digest_messages(&[json!(nanos.to_string()), json!(salt)])[..12]);
+        if !existing.iter().any(|known| known.id == id) {
+            return id;
+        }
+        salt += 1;
+    }
+}
+
+#[must_use]
+pub fn now_iso() -> String {
+    crate::session::manager::format_iso_now()
+}
+
+/// A mirror block's source and a session entry's message are the same row when
+/// they serialize alike or share role and timestamp.
+#[must_use]
+pub fn same_message(a: &Value, b: &Value) -> bool {
+    canonical_message(a) == canonical_message(b)
+        || (a["role"] == b["role"] && !a["timestamp"].is_null() && a["timestamp"] == b["timestamp"])
+}
+
+#[must_use]
+pub fn clamp_recall(max_tokens: Option<u64>) -> u64 {
+    max_tokens
+        .unwrap_or(DEFAULT_RECALL_TOKENS)
+        .clamp(MIN_RECALL_TOKENS, MAX_RECALL_TOKENS)
+}
+
+fn one_line(text: &str, max_chars: usize) -> String {
+    let line = text.split_whitespace().collect::<Vec<_>>().join(" ");
+    if line.chars().count() <= max_chars {
+        return line;
+    }
+    let mut cut: String = line.chars().take(max_chars.saturating_sub(3)).collect();
+    cut.push_str("...");
+    cut
+}
+
+/// The recall text and whether the body was cut to `max_tokens`.
+#[must_use]
+pub fn format_recall(annotation: &Annotation, body: &str, max_tokens: u64) -> (String, bool) {
+    let source = &annotation.source;
+    let header = format!(
+        "[live-context recall {}]\nsource: session {} entry {} revision {}\nhash: {}\nretention: {}\ntitle: {}\n\n--- exact textual source ({}) ---",
+        annotation.id,
+        source.session_id,
+        source.entry_id,
+        source.revision,
+        source.content_hash,
+        annotation.retention.label(),
+        one_line(&annotation.title, 120),
+        source.role,
+    );
+    let full = format!("{header}\n{body}");
+    if estimate_text_tokens(&full) <= max_tokens {
+        return (full, false);
+    }
+    let total = estimate_text_tokens(body);
+    let marker = format!("\n\n[source truncated to {max_tokens} tokens of about {total}; the session entry is unchanged]");
+    let budget_chars = (max_tokens * 4) as usize;
+    let used = header.chars().count() + 1 + marker.chars().count();
+    let keep = budget_chars.saturating_sub(used);
+    let cut: String = body.chars().take(keep).collect();
+    (format!("{header}\n{cut}{marker}"), true)
+}
+
+/// The one continuity message rendered into every request, or `None` with
+/// nothing to show. Archived and resolved annotations are never passed in.
+#[must_use]
+pub fn format_continuity(active: &[ActiveAnnotation]) -> Option<String> {
+    let shown: Vec<&ActiveAnnotation> = active
+        .iter()
+        .filter(|item| item.annotation.retention != Retention::Archive)
+        .collect();
+    if shown.is_empty() {
+        return None;
+    }
+    let mut lines = vec!["[Live context continuity: managed by CLM, not part of LIVE_CONTEXT.md]".to_string()];
+    for item in shown {
+        let annotation = &item.annotation;
+        lines.push(format!(
+            "- [{}] {}: {}",
+            annotation.id,
+            annotation.retention.label(),
+            one_line(&annotation.title, 120)
+        ));
+        lines.push(format!("  Next: {}", one_line(&annotation.future_action, 240)));
+        lines.push(format!(
+            "  Recall: await live_context.recall(\"{}\")",
+            annotation.id
+        ));
+        match &item.pinned {
+            Some(Ok(text)) => {
+                lines.push(format!("  Pinned source ({}):", annotation.source.role));
+                lines.push(text.clone());
+            }
+            Some(Err(reason)) => lines.push(format!("  Pin unavailable: {reason}")),
+            None => {}
+        }
+    }
+    Some(lines.join("\n"))
+}
+
+#[must_use]
+pub fn format_list(all: &[Annotation]) -> String {
+    if all.is_empty() {
+        return "No live-context annotations on this branch.".to_string();
+    }
+    all.iter()
+        .map(|annotation| {
+            let status = annotation
+                .resolved_at
+                .as_deref()
+                .map_or_else(|| "active".to_string(), |at| format!("resolved {at}"));
+            format!(
+                "[{}] {} {} {}\n  source {} next: {}",
+                annotation.id,
+                annotation.retention.label(),
+                status,
+                annotation.title,
+                annotation.source.entry_id,
+                annotation.future_action
+            )
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// The text a pin shows and recall returns.
+#[must_use]
+pub fn source_text(message: &Value) -> String {
+    render_message(message)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn annotation(id: &str, retention: Retention) -> Annotation {
+        Annotation {
+            id: id.into(),
+            source: SourceRef {
+                session_id: "s".into(),
+                entry_id: "e1".into(),
+                revision: 0,
+                content_hash: "h".into(),
+                role: "user".into(),
+            },
+            title: "Keep the API key rule".into(),
+            reason: "user said so".into(),
+            future_action: "check before commit".into(),
+            retention,
+            created_at: "2026-10-12T00:00:00.000Z".into(),
+            resolved_at: None,
+            resolution: None,
+        }
+    }
+
+    #[test]
+    fn rebuild_keeps_the_latest_entry_per_id_and_skips_foreign_data() {
+        let first = serde_json::to_value(annotation("lc-1", Retention::Pin)).unwrap();
+        let mut resolved = annotation("lc-1", Retention::Pin);
+        resolved.resolved_at = Some("later".into());
+        let second = serde_json::to_value(&resolved).unwrap();
+        let foreign = json!({ "version": 1, "id": "lc-x" });
+        let rebuilt = rebuild([&first, &foreign, &second]);
+        assert_eq!(rebuilt, vec![resolved]);
+        assert_eq!(first["futureAction"], "check before commit");
+        assert_eq!(first["retention"], "pin");
+    }
+
+    #[test]
+    fn recall_is_clamped_and_truncates_with_a_marker() {
+        assert_eq!(clamp_recall(None), 2_000);
+        assert_eq!(clamp_recall(Some(1)), 128);
+        assert_eq!(clamp_recall(Some(99_999)), 8_000);
+        let item = annotation("lc-1", Retention::Archive);
+        let (short, cut) = format_recall(&item, "tiny body", 2_000);
+        assert!(!cut && short.ends_with("tiny body"));
+        let (long, cut) = format_recall(&item, &"x".repeat(10_000), 128);
+        assert!(cut);
+        assert!(estimate_text_tokens(&long) <= 128, "{}", estimate_text_tokens(&long));
+        assert!(long.contains("[source truncated to 128 tokens of about 2500"));
+    }
+
+    #[test]
+    fn continuity_renders_pins_and_pointers_and_hides_archives() {
+        let active = vec![
+            ActiveAnnotation { annotation: annotation("lc-pin", Retention::Pin), pinned: Some(Ok("exact words".into())) },
+            ActiveAnnotation { annotation: annotation("lc-cont", Retention::Continuity), pinned: None },
+            ActiveAnnotation { annotation: annotation("lc-arch", Retention::Archive), pinned: None },
+            ActiveAnnotation { annotation: annotation("lc-gone", Retention::Pin), pinned: Some(Err("hash mismatch".into())) },
+        ];
+        let text = format_continuity(&active).unwrap();
+        assert!(text.contains("[lc-pin] pin: Keep the API key rule"));
+        assert!(text.contains("exact words"));
+        assert!(text.contains("Recall: await live_context.recall(\"lc-cont\")"));
+        assert!(!text.contains("lc-arch"));
+        assert!(text.contains("Pin unavailable: hash mismatch"));
+        assert_eq!(format_continuity(&active[2..3]), None);
+    }
+
+    #[test]
+    fn same_message_matches_by_shape_or_role_and_timestamp() {
+        let a = json!({ "role": "user", "content": "hi", "timestamp": 5 });
+        let b = json!({ "role": "user", "content": [{ "type": "text", "text": "hi" }], "timestamp": 5 });
+        assert!(same_message(&a, &a));
+        assert!(same_message(&a, &b));
+        assert!(!same_message(&a, &json!({ "role": "assistant", "timestamp": 5 })));
+    }
+
+    #[test]
+    fn ids_are_unique_and_prefixed() {
+        let known = vec![annotation("lc-1", Retention::Pin)];
+        let id = new_id(&known);
+        assert!(id.starts_with("lc-") && id.len() == 15, "{id}");
+        assert!(now_iso().ends_with('Z'));
+    }
+}
