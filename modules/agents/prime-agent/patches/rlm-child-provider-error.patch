+/// A run that settles on a provider error delivers the failure row, not the no-reply notice.
+#[tokio::test]
+async fn a_child_ending_on_a_provider_error_delivers_the_failure_notice() {
+    let (follow_up_tx, mut follow_up_rx) = mpsc::unbounded_channel();
+    let (sessions, _kill_rx) =
+        sessions_with_fake_supervisor(follow_up_tx, 0, FakeKill::Success, FakeChild::ProviderError)
+            .await;
+    let handle = spawn_child(&sessions).await;
+    sessions.notify_turn_done();
+
+    let follow_up = tokio::time::timeout(Duration::from_secs(10), follow_up_rx.recv())
+        .await
+        .expect("the errored child must deliver its failure notice")
+        .expect("the follow_up channel stays open");
+    assert_failure_row(&follow_up, &handle.rlm_child_id, "429 quota exhausted");
+    let entries = sessions.list_subagents().await.expect("child roster");
+    assert_eq!(entries[0].status, "error");
+    let extra = tokio::time::timeout(Duration::from_millis(300), follow_up_rx.recv()).await;
+    assert!(extra.is_err(), "no second notice may arrive");
+}
+
+/// A child reporting a progress note in its `get_state` reply surfaces it on the parent roster.
+#[tokio::test]
+async fn a_child_reporting_progress_note_surfaces_it_on_the_roster() {
+    let (follow_up_tx, _follow_up_rx) = mpsc::unbounded_channel();
+    let (sessions, _kill_rx) = sessions_with_fake_supervisor(
+        follow_up_tx,
+        0,
+        FakeKill::Success,
+        FakeChild::RetryProgressNote,
+    )
+    .await;
+    let _handle = spawn_child(&sessions).await;
+    sessions.notify_turn_done();
+    let record = Arc::clone(&sessions.inner.children.lock().await[0]);
+    // Wait until prompt is admitted
+    for _ in 0..50 {
+        if record.lock().await.prompt_admitted {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    sessions.inner.refresh_record(&record).await;
+    let entries = sessions.list_subagents().await.expect("child roster");
+    assert_eq!(
+        entries[0].progress_note.as_deref(),
+        Some("provider retry 2/5 in 30s: overloaded")
+    );
+}
