diff --git a/packages/ai/src/providers/opencode-headers.ts b/packages/ai/src/providers/opencode-headers.ts
index 1f8946f..4a62baf 100644
--- a/packages/ai/src/providers/opencode-headers.ts
+++ b/packages/ai/src/providers/opencode-headers.ts
@@ -29,3 +29,14 @@ export function missingOpenCodeTools(present: Iterable<string>): string[] {
 	const have = new Set(present);
 	return OPENCODE_REQUIRED_TOOLS.filter((name) => !have.has(name));
 }
+
+// Stubs on a tool-less request exist only to pass zen's check; the model must answer in text.
+export const OPENCODE_TOOLLESS_STUB_DESCRIPTION = "Unavailable. Never call this tool; reply with plain text only.";
+
+export const OPENCODE_TOOLLESS_SYSTEM_NOTE =
+	"No tools are available for this request. Reply with plain text only and never emit tool calls.";
+
+// DeepSeek-based zen models (big-pickle) can ignore tool_choice "none" and leak DSML tool-call markup as text.
+export function hasLeakedToolCallMarkup(text: string): boolean {
+	return text.includes("｜DSML｜");
+}
