+/// opencode zen's "Upstream request failed" 400 is transient: it classifies as a server error
+/// (retryable), while any other 400 stays a permanent rejection.
+#[test]
+fn opencode_upstream_400_classifies_as_server_error() {
+    let upstream = ProviderError::from_http_status_body(
+        400,
+        "{\"error\":{\"type\":\"invalid_request_error\",\"message\":\"Upstream request failed\"}}",
+        HashMap::default(),
+    );
+    assert_eq!(
+        extract_stream_failure_info(&upstream).kind,
+        StreamFailureKind::ServerError
+    );
+    // A body without JSON still matches through the HTTP message.
+    let bare =
+        ProviderError::from_http_status_body(400, "Upstream request failed", HashMap::default());
+    assert_eq!(
+        extract_stream_failure_info(&bare).kind,
+        StreamFailureKind::ServerError
+    );
+    let other = ProviderError::from_http_status_body(
+        400,
+        "{\"error\":{\"type\":\"invalid_request_error\",\"message\":\"bad\"}}",
+        HashMap::default(),
+    );
+    assert_eq!(
+        extract_stream_failure_info(&other).kind,
+        StreamFailureKind::InvalidRequest
+    );
+}
