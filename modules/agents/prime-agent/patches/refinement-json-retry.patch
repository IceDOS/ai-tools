+    /// A seam answering each call with the next scripted reply, counting the calls.
+    fn scripted(
+        replies: &'static [&'static str],
+    ) -> (RefinerFn, std::sync::Arc<std::sync::atomic::AtomicUsize>) {
+        let calls = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let counter = std::sync::Arc::clone(&calls);
+        let seam: RefinerFn = Box::new(move |_model, _system, _prompt| {
+            let index = counter.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            let reply = replies[index.min(replies.len() - 1)];
+            Box::pin(async move { Ok(text_message(reply)) })
+        });
+        (seam, calls)
+    }
+
+    #[tokio::test]
+    async fn an_unparseable_reply_is_resent_once() {
+        let state = super::super::empty_harness_state();
+        let (seam, calls) = scripted(&[
+            "Sure, here is my plan.",
+            r#"{"summary":"second","edits":[]}"#,
+        ]);
+        let plan = plan_refinement(
+            &[],
+            &state,
+            &[],
+            &test_model(),
+            &RefineOptions::default(),
+            seam,
+        )
+        .await
+        .unwrap();
+        assert_eq!(plan.proposal.summary, "second");
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 2);
+
+        // Two bad replies fail after exactly one resend.
+        let (seam, calls) = scripted(&["no json", "still no json"]);
+        let review = review_auto_refine(
+            &[],
+            &state,
+            &[],
+            &test_model(),
+            &AutoRefineReviewContext {
+                reason: "checkpoint".to_string(),
+                turns_since_last_review: 1,
+            },
+            seam,
+        )
+        .await;
+        assert!(review.is_err());
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 2);
+    }
