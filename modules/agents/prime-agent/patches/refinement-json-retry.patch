+/// One refiner call parsed by `parse`. A sampled reply can miss the JSON shape (prose,
+/// leaked tool-call markup), so an unparseable reply is resent once; a truncated one is not.
+async fn call_and_parse<T>(
+    refine_call: &RefinerFn,
+    model: &pa_types::ai::Model,
+    system_prompt: &'static str,
+    user_prompt: &str,
+    parse: impl Fn(&str) -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    let mut attempt = 0;
+    loop {
+        let reply = refine_call(model.clone(), system_prompt, user_prompt.to_string()).await?;
+        match parse(&assistant_text(&reply)) {
+            Ok(value) => return Ok(value),
+            Err(error) if attempt > 0 || reply.stop_reason == pa_types::ai::StopReason::Length => {
+                return Err(error)
+            }
+            Err(_) => attempt += 1,
+        }
+    }
+}
