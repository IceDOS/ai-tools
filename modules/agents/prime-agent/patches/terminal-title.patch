Index: prime-agent-src/crates/pa-tui/src/terminal_title.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-tui/src/terminal_title.rs
@@ -0,0 +1,225 @@
+//! Opt-in terminal window title: `<glyph> <session headline>`. Enabled only when
+//! `PRIME_AGENT_TITLE_IDLE_GLYPH` or `PRIME_AGENT_TITLE_WORKING_GLYPHS` is set.
+//! The first write pushes the title stack (XTWINOPS 22) and exit pops it (23).
+
+use std::io::Write;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+pub(crate) const IDLE_ENV: &str = "PRIME_AGENT_TITLE_IDLE_GLYPH";
+pub(crate) const WORKING_ENV: &str = "PRIME_AGENT_TITLE_WORKING_GLYPHS";
+const DEFAULT_IDLE: &str = "❄";
+const DEFAULT_WORKING: [&str; 4] = ["❅", "❅", "❆", "❆"];
+const FRAME: Duration = Duration::from_millis(250);
+const MAX_HEADLINE_CHARS: usize = 80;
+const APP_TITLE: &str = "Prime Agent";
+
+static PUSHED: AtomicBool = AtomicBool::new(false);
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct TitleConfig {
+    pub idle: String,
+    pub working: Vec<String>,
+}
+
+impl TitleConfig {
+    pub(crate) fn from_env() -> Option<Self> {
+        Self::from_values(
+            std::env::var(IDLE_ENV).ok(),
+            std::env::var(WORKING_ENV).ok(),
+        )
+    }
+
+    /// `None` when both values are absent; an empty value falls back to the default glyphs.
+    #[allow(clippy::needless_pass_by_value)]
+    pub(crate) fn from_values(idle: Option<String>, working: Option<String>) -> Option<Self> {
+        if idle.is_none() && working.is_none() {
+            return None;
+        }
+        let idle = idle
+            .map(|value| value.trim().to_owned())
+            .filter(|value| !value.is_empty())
+            .unwrap_or_else(|| DEFAULT_IDLE.to_owned());
+        let working: Vec<String> = working
+            .as_deref()
+            .unwrap_or_default()
+            .split_whitespace()
+            .map(str::to_owned)
+            .collect();
+        let working = if working.is_empty() {
+            DEFAULT_WORKING.iter().map(|g| (*g).to_owned()).collect()
+        } else {
+            working
+        };
+        Some(Self { idle, working })
+    }
+
+    pub(crate) fn glyph(&self, working: bool, frame: usize) -> &str {
+        if working {
+            &self.working[frame % self.working.len()]
+        } else {
+            &self.idle
+        }
+    }
+}
+
+/// Session name, then the first user prompt, then `Prime Agent - <cwd basename>`.
+pub(crate) fn headline(session_name: Option<&str>, first_user_text: Option<&str>, cwd: &Path) -> String {
+    for candidate in [session_name, first_user_text].into_iter().flatten() {
+        let clean = sanitize(candidate);
+        if !clean.is_empty() {
+            return truncate(&clean);
+        }
+    }
+    match cwd.file_name().and_then(|name| name.to_str()) {
+        Some(base) if !base.is_empty() => format!("{APP_TITLE} - {}", sanitize(base)),
+        _ => APP_TITLE.to_owned(),
+    }
+}
+
+/// Collapse whitespace and drop control characters so a prompt cannot end the OSC early.
+fn sanitize(text: &str) -> String {
+    text.split(|c: char| c.is_whitespace() || c.is_control())
+        .filter(|part| !part.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn truncate(text: &str) -> String {
+    if text.chars().count() <= MAX_HEADLINE_CHARS {
+        return text.to_owned();
+    }
+    let mut out: String = text.chars().take(MAX_HEADLINE_CHARS - 1).collect();
+    out.push('…');
+    out
+}
+
+/// Per-surface title tracker: returns a title only when it differs from the last one written.
+#[derive(Debug)]
+pub(crate) struct TitleState {
+    config: TitleConfig,
+    started: Instant,
+    last: Option<String>,
+}
+
+impl TitleState {
+    pub(crate) fn new(config: TitleConfig, now: Instant) -> Self {
+        Self { config, started: now, last: None }
+    }
+
+    pub(crate) fn next(&mut self, working: bool, headline: &str, now: Instant) -> Option<String> {
+        let frame = (now.saturating_duration_since(self.started).as_millis() / FRAME.as_millis()) as usize;
+        let title = format!("{} {headline}", self.config.glyph(working, frame));
+        if self.last.as_deref() == Some(title.as_str()) && PUSHED.load(Ordering::SeqCst) {
+            return None;
+        }
+        self.last = Some(title.clone());
+        Some(title)
+    }
+
+    /// Forget the last title so the next tick rewrites it (after suspend or an external editor).
+    pub(crate) fn invalidate(&mut self) {
+        self.last = None;
+    }
+}
+
+pub(crate) fn write(out: &mut impl Write, title: &str) -> std::io::Result<()> {
+    if !PUSHED.swap(true, Ordering::SeqCst) {
+        out.write_all(b"\x1b[22;0t")?;
+    }
+    write!(out, "\x1b]0;{title}\x07")?;
+    out.flush()
+}
+
+/// Pop the title stack once; a no-op when nothing was pushed.
+pub(crate) fn restore(out: &mut impl Write) -> std::io::Result<()> {
+    if PUSHED.swap(false, Ordering::SeqCst) {
+        out.write_all(b"\x1b[23;0t")?;
+        out.flush()?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+pub(crate) static STATE_TEST_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    fn lock() -> std::sync::MutexGuard<'static, ()> {
+        match STATE_TEST_LOCK.lock() {
+            Ok(guard) => guard,
+            Err(poisoned) => poisoned.into_inner(),
+        }
+    }
+
+    #[test]
+    fn config_is_opt_in() {
+        assert_eq!(TitleConfig::from_values(None, None), None);
+        let config = TitleConfig::from_values(Some(String::new()), None).expect("enabled");
+        assert_eq!(config.idle, "❄");
+        assert_eq!(config.working, vec!["❅", "❅", "❆", "❆"]);
+        let config = TitleConfig::from_values(Some("*".into()), Some(" a  b ".into())).expect("enabled");
+        assert_eq!(config.idle, "*");
+        assert_eq!(config.working, vec!["a", "b"]);
+    }
+
+    #[test]
+    fn glyph_cycles_while_working() {
+        let config = TitleConfig::from_values(Some("i".into()), Some("a b".into())).expect("enabled");
+        assert_eq!(config.glyph(false, 7), "i");
+        assert_eq!(config.glyph(true, 0), "a");
+        assert_eq!(config.glyph(true, 3), "b");
+    }
+
+    #[test]
+    fn headline_prefers_name_then_prompt_then_cwd() {
+        let cwd = PathBuf::from("/home/u/proj");
+        assert_eq!(headline(Some("fix  build"), Some("hi"), &cwd), "fix build");
+        assert_eq!(headline(Some("  "), Some("run\nthe\ttests"), &cwd), "run the tests");
+        assert_eq!(headline(None, None, &cwd), "Prime Agent - proj");
+        assert_eq!(headline(None, None, Path::new("/")), "Prime Agent");
+    }
+
+    #[test]
+    fn headline_strips_control_bytes_and_truncates() {
+        let cwd = PathBuf::from("/x");
+        assert_eq!(headline(Some("a\x07b\x1b]0;evil"), None, &cwd), "a b ]0;evil");
+        let long = "w".repeat(200);
+        let out = headline(Some(&long), None, &cwd);
+        assert_eq!(out.chars().count(), 80);
+        assert!(out.ends_with('…'));
+    }
+
+    #[test]
+    fn state_dedupes_and_pushes_once() {
+        let _lock = lock();
+        PUSHED.store(false, Ordering::SeqCst);
+        let config = TitleConfig::from_values(Some("i".into()), Some("a b".into())).expect("enabled");
+        let start = Instant::now();
+        let mut state = TitleState::new(config, start);
+        let mut out = Vec::new();
+
+        let title = state.next(false, "h", start).expect("first title");
+        write(&mut out, &title).expect("write");
+        assert_eq!(out, b"\x1b[22;0t\x1b]0;i h\x07");
+        assert_eq!(state.next(false, "h", start + Duration::from_millis(900)), None);
+
+        out.clear();
+        let working = state.next(true, "h", start + Duration::from_millis(250)).expect("working");
+        assert_eq!(working, "b h");
+        write(&mut out, &working).expect("write");
+        assert_eq!(out, b"\x1b]0;b h\x07");
+
+        state.invalidate();
+        assert!(state.next(true, "h", start + Duration::from_millis(250)).is_some());
+
+        out.clear();
+        restore(&mut out).expect("restore");
+        restore(&mut out).expect("second restore is a no-op");
+        assert_eq!(out, b"\x1b[23;0t");
+    }
+}
