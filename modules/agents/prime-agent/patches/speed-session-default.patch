+    /// `terminal.speed` seeds the session's `/speed` state; unset reads as off.
+    #[test]
+    fn speed_display_reads_the_terminal_setting() {
+        let dir = tempfile::TempDir::new().expect("temp dir");
+        let agent_dir = dir.path().join("agent");
+        std::fs::create_dir_all(&agent_dir).expect("agent dir");
+        let settings = CliClientSettings::new(dir.path().to_path_buf(), agent_dir.clone());
+        assert!(!settings.speed_display());
