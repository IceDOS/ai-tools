Index: prime-agent-src/crates/pa-tui/src/status_hook.rs
===================================================================
--- /dev/null
+++ prime-agent-src/crates/pa-tui/src/status_hook.rs
@@ -0,0 +1,307 @@
+//! External status command (`statusCommand` setting): the TUI pipes a JSON session payload to
+//! the command's stdin and renders its stdout lines (SGR colors kept) under the editor.
+
+use crate::{Line, Span};
+use ratatui::style::{Color, Modifier, Style};
+use serde::Serialize;
+use std::process::Stdio;
+use std::time::{Duration, Instant};
+use tokio::io::AsyncWriteExt;
+
+const MAX_LINES: usize = 8;
+const MAX_LINE_BYTES: usize = 1024;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct StatusCommandConfig {
+    /// argv; the first element is the program.
+    pub command: Vec<String>,
+    pub interval: Duration,
+    /// Rerun interval while a turn runs (keeps vigor leases fresh: its staleness limit is 5 s).
+    pub busy_interval: Duration,
+    pub timeout: Duration,
+    /// `/cost` starts on or off.
+    pub visible: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StatusPayload {
+    pub session_id: Option<String>,
+    pub session_file: Option<String>,
+    pub cwd: String,
+    pub model: Option<StatusModel>,
+    pub turn_active: bool,
+    pub cost_usd: Option<f64>,
+    pub context_percent: Option<f64>,
+    pub pid: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct StatusModel {
+    pub provider: String,
+    pub id: String,
+}
+
+/// Scheduling for one surface: at most one run in flight, reruns on events or interval.
+#[derive(Debug)]
+pub struct StatusHook {
+    pub config: StatusCommandConfig,
+    pub visible: bool,
+    pub lines: Vec<Line>,
+    in_flight: bool,
+    dirty: bool,
+    last_run: Option<Instant>,
+}
+
+impl StatusHook {
+    #[must_use]
+    pub fn new(config: StatusCommandConfig) -> Self {
+        let visible = config.visible;
+        Self { config, visible, lines: Vec::new(), in_flight: false, dirty: true, last_run: None }
+    }
+
+    /// Request a rerun at the next tick (turn start or end, model change).
+    pub fn mark_dirty(&mut self) {
+        self.dirty = true;
+    }
+
+    /// Whether a run should start now; marks it in flight when so.
+    pub fn due(&mut self, busy: bool, now: Instant) -> bool {
+        if !self.visible || self.in_flight {
+            return false;
+        }
+        let interval = if busy { self.config.busy_interval } else { self.config.interval };
+        let elapsed = self.last_run.is_none_or(|last| now.saturating_duration_since(last) >= interval);
+        if !(self.dirty || elapsed) {
+            return false;
+        }
+        self.in_flight = true;
+        self.dirty = false;
+        self.last_run = Some(now);
+        true
+    }
+
+    /// Store a finished run's output; a failed run keeps the previous lines.
+    pub fn finish(&mut self, output: Option<String>) {
+        self.in_flight = false;
+        if let Some(output) = output {
+            self.lines = parse_output(&output);
+        }
+    }
+
+    /// The rows to render; empty while hidden.
+    #[must_use]
+    pub fn rows(&self) -> &[Line] {
+        if self.visible { &self.lines } else { &[] }
+    }
+}
+
+/// Run the command once with `payload` on stdin; `None` on spawn failure, timeout, or non-zero exit.
+pub async fn run(config: &StatusCommandConfig, payload: &StatusPayload) -> Option<String> {
+    let (program, args) = config.command.split_first()?;
+    let input = serde_json::to_vec(payload).ok()?;
+    let mut child = tokio::process::Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .ok()?;
+    let mut stdin = child.stdin.take()?;
+    let work = async move {
+        // A command that ignores stdin may close it early; that is not an error.
+        let _ = stdin.write_all(&input).await;
+        drop(stdin);
+        child.wait_with_output().await
+    };
+    let output = tokio::time::timeout(config.timeout, work).await.ok()?.ok()?;
+    output.status.success().then(|| String::from_utf8_lossy(&output.stdout).into_owned())
+}
+
+#[must_use]
+pub fn parse_output(output: &str) -> Vec<Line> {
+    output
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .take(MAX_LINES)
+        .map(|line| parse_sgr_line(truncate_bytes(line, MAX_LINE_BYTES)))
+        .collect()
+}
+
+fn truncate_bytes(line: &str, max: usize) -> &str {
+    if line.len() <= max {
+        return line;
+    }
+    let mut end = max;
+    while !line.is_char_boundary(end) {
+        end -= 1;
+    }
+    &line[..end]
+}
+
+/// Minimal SGR parser: 0, 1, 2, 3, 4, 22-24, 30-37, 39, 90-97, 38;5;n and 38;2;r;g;b.
+/// Other escape sequences and control bytes are dropped.
+#[must_use]
+pub fn parse_sgr_line(line: &str) -> Line {
+    let mut spans: Line = Vec::new();
+    let mut style = Style::default();
+    let mut text = String::new();
+    let mut chars = line.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c != '\x1b' {
+            if !c.is_control() || c == '\t' {
+                text.push(if c == '\t' { ' ' } else { c });
+            }
+            continue;
+        }
+        if chars.peek() != Some(&'[') {
+            continue;
+        }
+        chars.next();
+        let mut params = String::new();
+        let mut terminator = None;
+        for next in chars.by_ref() {
+            if next.is_ascii_digit() || next == ';' {
+                params.push(next);
+            } else {
+                terminator = Some(next);
+                break;
+            }
+        }
+        if terminator != Some('m') {
+            continue;
+        }
+        if !text.is_empty() {
+            spans.push(Span::styled(std::mem::take(&mut text), style));
+        }
+        style = apply_sgr(style, &params);
+    }
+    if !text.is_empty() {
+        spans.push(Span::styled(text, style));
+    }
+    spans
+}
+
+fn apply_sgr(mut style: Style, params: &str) -> Style {
+    let codes: Vec<u16> = params.split(';').map(|p| p.parse().unwrap_or(0)).collect();
+    let mut i = 0;
+    while i < codes.len() {
+        match codes[i] {
+            0 => style = Style::default(),
+            1 => style = style.add_modifier(Modifier::BOLD),
+            2 => style = style.add_modifier(Modifier::DIM),
+            3 => style = style.add_modifier(Modifier::ITALIC),
+            4 => style = style.add_modifier(Modifier::UNDERLINED),
+            22 => style = style.remove_modifier(Modifier::BOLD | Modifier::DIM),
+            23 => style = style.remove_modifier(Modifier::ITALIC),
+            24 => style = style.remove_modifier(Modifier::UNDERLINED),
+            code @ 30..=37 => style = style.fg(Color::Indexed((code - 30) as u8)),
+            code @ 90..=97 => style = style.fg(Color::Indexed((code - 90 + 8) as u8)),
+            39 => style.fg = None,
+            38 => match codes.get(i + 1) {
+                Some(5) => {
+                    if let Some(&n) = codes.get(i + 2) {
+                        style = style.fg(Color::Indexed(n.min(255) as u8));
+                    }
+                    i += 2;
+                }
+                Some(2) => {
+                    if let (Some(&r), Some(&g), Some(&b)) = (codes.get(i + 2), codes.get(i + 3), codes.get(i + 4)) {
+                        style = style.fg(Color::Rgb(r.min(255) as u8, g.min(255) as u8, b.min(255) as u8));
+                    }
+                    i += 4;
+                }
+                _ => {}
+            },
+            _ => {}
+        }
+        i += 1;
+    }
+    style
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn config(command: &[&str]) -> StatusCommandConfig {
+        StatusCommandConfig {
+            command: command.iter().map(|s| (*s).to_owned()).collect(),
+            interval: Duration::from_secs(30),
+            busy_interval: Duration::from_secs(2),
+            timeout: Duration::from_secs(5),
+            visible: true,
+        }
+    }
+
+    fn payload() -> StatusPayload {
+        StatusPayload {
+            session_id: Some("s1".into()),
+            session_file: None,
+            cwd: "/tmp".into(),
+            model: Some(StatusModel { provider: "opencode-go".into(), id: "glm".into() }),
+            turn_active: true,
+            cost_usd: Some(0.5),
+            context_percent: None,
+            pid: 1,
+        }
+    }
+
+    #[test]
+    fn sgr_parser_keeps_colors_and_drops_other_escapes() {
+        let line = parse_sgr_line("\x1b[1;31mred\x1b[0m plain \x1b[38;2;1;2;3mrgb\x1b[2K\x07");
+        assert_eq!(line.len(), 3);
+        assert_eq!(line[0].content, "red");
+        assert_eq!(line[0].style, Style::default().fg(Color::Indexed(1)).add_modifier(Modifier::BOLD));
+        assert_eq!(line[1], Span::raw(" plain "));
+        assert_eq!(line[2].content, "rgb");
+        assert_eq!(line[2].style.fg, Some(Color::Rgb(1, 2, 3)));
+        assert_eq!(parse_sgr_line("\x1b[38;5;208mx")[0].style.fg, Some(Color::Indexed(208)));
+    }
+
+    #[test]
+    fn output_skips_blank_lines_and_caps_rows() {
+        let rows = parse_output("a\n\n  \nb\nc\nd\ne\nf\ng\nh\ni\nj\n");
+        assert_eq!(rows.len(), 8);
+        assert_eq!(rows[1][0].content, "b");
+    }
+
+    #[test]
+    fn payload_uses_camel_case() {
+        let json = serde_json::to_value(payload()).expect("json");
+        assert_eq!(json["sessionId"], "s1");
+        assert_eq!(json["turnActive"], true);
+        assert_eq!(json["model"]["provider"], "opencode-go");
+    }
+
+    #[test]
+    fn schedule_runs_once_in_flight_and_honours_intervals() {
+        let mut hook = StatusHook::new(config(&["true"]));
+        let t0 = Instant::now();
+        assert!(hook.due(false, t0));
+        assert!(!hook.due(false, t0), "one run in flight");
+        hook.finish(Some("x\n".into()));
+        assert!(!hook.due(false, t0 + Duration::from_secs(5)));
+        assert!(hook.due(true, t0 + Duration::from_secs(2)));
+        hook.finish(None);
+        assert_eq!(hook.rows().len(), 1, "a failed run keeps the last output");
+        hook.mark_dirty();
+        assert!(hook.due(false, t0 + Duration::from_secs(3)));
+        hook.finish(None);
+        hook.visible = false;
+        assert!(hook.rows().is_empty());
+        assert!(!hook.due(true, t0 + Duration::from_secs(60)));
+    }
+
+    #[tokio::test]
+    async fn run_pipes_payload_to_stdin() {
+        let out = run(&config(&["sh", "-c", "cat"]), &payload()).await.expect("output");
+        assert!(out.contains("\"sessionId\":\"s1\""));
+        assert_eq!(run(&config(&["sh", "-c", "exit 3"]), &payload()).await, None);
+        let mut slow = config(&["sh", "-c", "sleep 5"]);
+        slow.timeout = Duration::from_millis(100);
+        assert_eq!(run(&slow, &payload()).await, None);
+        assert_eq!(run(&config(&[]), &payload()).await, None);
+    }
+}
