+// Providers whose context the local server owns; the cap never applies.
+const CONTEXT_CAP_EXCLUDED_PROVIDERS: &[&str] = &["llamacpp"];
+
+// contextWindowPercent from the global settings.json beside models.json.
+fn global_context_window_percent(models_json_path: &std::path::Path) -> Option<u64> {
+    let settings_path = models_json_path.parent()?.join("settings.json");
+    let text = std::fs::read_to_string(settings_path).ok()?;
+    let value: serde_json::Value = serde_json::from_str(&text).ok()?;
+    crate::settings::load::from_value_lenient(&value)
+        .context_window_percent
+        .filter(|percent| (1..100).contains(percent))
+}
+
+// Cap every model's window at percent of loaded value; load_models rebuilds each time.
+fn apply_context_window_cap(
+    models: &mut [Model],
+    percent: u64,
+    model_overrides: &HashMap<String, BTreeMap<String, super::custom::ModelOverride>>,
+) {
+    for model in models.iter_mut() {
+        if CONTEXT_CAP_EXCLUDED_PROVIDERS.contains(&model.provider.as_str()) {
+            continue;
+        }
+        let pinned = model_overrides
+            .get(&model.provider)
+            .and_then(|overrides| overrides.get(&model.id))
+            .is_some_and(|model_override| model_override.context_window.is_some());
+        if pinned || model.context_window == 0 {
+            continue;
+        }
+        let cap = (model.context_window * percent + 50) / 100;
+        if cap > 0 && cap < model.context_window {
+            model.context_window = cap;
+        }
+    }
+}
