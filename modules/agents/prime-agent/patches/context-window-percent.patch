@@ -443,3 +443,91 @@ fn without_a_stored_xai_subscription_the
     assert!(grok.thinking_level_map.is_none());
     assert!(grok.compat.is_none());
 }
+
+fn window(registry: &ModelRegistry, provider: &str, id: &str) -> u64 {
+    registry
+        .get_all()
+        .iter()
+        .find(|m| m.provider == provider && m.id == id)
+        .unwrap_or_else(|| panic!("{provider}/{id} loaded"))
+        .context_window
+}
+
+// contextWindowPercent caps the catalog and custom models once.
+#[test]
+fn context_window_percent_caps_unpinned_models_once() {
+    let native = ModelRegistry::in_memory(auth_with(&serde_json::json!({})));
+    let candidates: Vec<&Model> = native
+        .get_all()
+        .iter()
+        .filter(|m| m.provider != "llamacpp" && m.context_window >= 1000)
+        .collect();
+    let (pinned, unpinned) = candidates
+        .iter()
+        .find_map(|first| {
+            let second = candidates
+                .iter()
+                .find(|m| m.provider == first.provider && m.id != first.id)?;
+            Some(((*first).clone(), (*second).clone()))
+        })
+        .expect("one catalog provider with two models");
+    let provider = pinned.provider.clone();
+    let dir = tempfile::tempdir().unwrap();
+    let models_path = dir.path().join("models.json");
+    std::fs::write(
+        &models_path,
+        serde_json::json!({ "providers": {
+            "custom": { "baseUrl": "https://custom.example", "apiKey": "k",
+                "api": "openai-completions",
+                "models": [ { "id": "big", "contextWindow": 200_000 } ] },
+            "llamacpp": { "baseUrl": "http://127.0.0.1:8080/v1", "apiKey": "k",
+                "api": "openai-completions",
+                "models": [ { "id": "local", "contextWindow": 65536 } ] },
+            provider.clone(): { "modelOverrides": { pinned.id.clone(): { "contextWindow": 50000 } } }
+        } })
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        dir.path().join("settings.json"),
+        r#"{ "contextWindowPercent": 30 }"#,
+    )
+    .unwrap();
+    let mut registry = ModelRegistry::create(auth_with(&serde_json::json!({})), &models_path);
+    assert_eq!(window(&registry, "custom", "big"), 60000);
+    assert_eq!(window(&registry, "llamacpp", "local"), 65536);
+    assert_eq!(window(&registry, &provider, &pinned.id), 50000);
+    let expected = (unpinned.context_window * 30 + 50) / 100;
+    assert_eq!(window(&registry, &provider, &unpinned.id), expected);
+    registry.refresh();
+    assert_eq!(
+        window(&registry, "custom", "big"),
+        60000,
+        "a reload never caps twice"
+    );
+}
+
+#[test]
+fn context_window_percent_out_of_range_leaves_windows_alone() {
+    let dir = tempfile::tempdir().unwrap();
+    let models_path = dir.path().join("models.json");
+    std::fs::write(
+        &models_path,
+        r#"{ "providers": { "custom": { "baseUrl": "https://c.example", "apiKey": "k",
+            "api": "openai-completions", "models": [ { "id": "big", "contextWindow": 200000 } ] } } }"#,
+    )
+    .unwrap();
+    for percent in ["0", "100", "250"] {
+        std::fs::write(
+            dir.path().join("settings.json"),
+            format!(r#"{{ "contextWindowPercent": {percent} }}"#),
+        )
+        .unwrap();
+        let registry = ModelRegistry::create(auth_with(&serde_json::json!({})), &models_path);
+        assert_eq!(
+            window(&registry, "custom", "big"),
+            200_000,
+            "percent {percent}"
+        );
+    }
+}
